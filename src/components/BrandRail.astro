---
// IL MENÙ LATERALE — "il corridoio del cinema" (prototipo, 06/08/2026).
// Richiesta di Paolo: il logotipo Imagina come rimando alla home e i quattro
// marchi come tasti verso le landing. Le piastrelle sono gli SVG ufficiali
// (fondo del brand + segno bianco) usati come <img>: mantengono i colori
// d'identità e non collidono tra loro (hanno tutte classi .cls-1/.cls-2).
// Il logotipo Imagina è inline con currentColor, così si adatta alla cromia
// di ogni pagina (l'originale è bianco e sparirebbe sui fondi chiari).
// Registro: piastrelle come pellicole sullo scaffale — mai etichette di testo.
import imaginaLogotype from '../assets/imagina-logotype.svg?raw';

interface Props {
  /** Lingua corrente: decide le destinazioni dei link. */
  lang?: 'it' | 'en';
  /** Chiave della pagina attuale: la sua piastrella è marcata. */
  current?: 'home' | 'tipicita' | 'grand-tour' | 'tipicita-in-blu' | 'evo';
}
const { lang = 'it', current } = Astro.props;

// enReady = la versione inglese esiste davvero. Finché non c'è, in EN si
// rimanda all'italiano (con hreflang onesto) invece di produrre un 404.
const projects = [
  { key: 'tipicita', name: 'Tipicità Festival', it: '/tipicita/', en: '/en/tipicita/', enReady: true, img: '/logos/menu/tipicita.svg' },
  { key: 'grand-tour', name: 'Grand Tour delle Marche', it: '/grand-tour-delle-marche/', en: '/en/grand-tour-delle-marche/', enReady: false, img: '/logos/menu/grand-tour.svg' },
  { key: 'tipicita-in-blu', name: 'Tipicità in Blu', it: '/tipicita-in-blu/', en: '/en/tipicita-in-blu/', enReady: false, img: '/logos/menu/tipicita-in-blu.svg' },
  { key: 'evo', name: 'EVO', it: '/evo/', en: '/en/evo/', enReady: false, img: '/logos/menu/evo.svg' },
];

const homeHref = lang === 'en' ? '/' : '/';
const label = lang === 'en' ? 'Projects' : 'Progetti';
const homeLabel = 'Imagina';

function hrefFor(p: (typeof projects)[number]) {
  return lang === 'en' && p.enReady ? p.en : p.it;
}
function hreflangFor(p: (typeof projects)[number]) {
  return lang === 'en' && !p.enReady ? 'it' : undefined;
}
---

<nav class="rail" aria-label={label}>
  <a class="rail-home" href={homeHref} aria-label={homeLabel} aria-current={current === 'home' ? 'page' : undefined}>
    <Fragment set:html={imaginaLogotype} />
  </a>
  <ul>
    {projects.map((p) => (
      <li>
        <a
          class:list={['tile', { on: current === p.key }]}
          href={hrefFor(p)}
          hreflang={hreflangFor(p)}
          aria-label={p.name}
          aria-current={current === p.key ? 'page' : undefined}
        >
          <img src={p.img} alt="" width="40" height="40" loading="lazy" />
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* Le piastrelle stanno in sordina e si accendono al passaggio — il colore
     pieno è per la pagina in cui ci si trova.
     POSIZIONE: il contenuto dei quadri è centrato a 1050px, quindi una colonna
     a sinistra gli finirebbe sopra sotto una certa larghezza. Sotto i 1300px
     il menù diventa una striscia in basso a sinistra (angolo libero: i puntini,
     il rimando e la freccia stanno tutti a destra); sopra, torna colonna. */
  .rail { position: fixed; left: 1.1rem; bottom: 1.2rem; z-index: 20;
    display: flex; align-items: center; gap: 0.7rem; }

  /* il logotipo si legge sia sul campo teal dell'hero sia sui quadri bianchi:
     stesso espediente del rimando Imagina in alto a destra */
  .rail-home { display: block; width: 82px; color: #fff; mix-blend-mode: difference; opacity: 0.55;
    transition: opacity 0.25s ease; }
  .rail-home:hover, .rail-home[aria-current='page'] { opacity: 1; }
  .rail-home :global(svg) { display: block; width: 100%; height: auto; }

  .rail ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.45rem; }

  .tile { display: block; width: 34px; height: 34px; opacity: 0.42; filter: saturate(0.75);
    transition: opacity 0.25s ease, filter 0.25s ease, transform 0.25s ease; }
  .tile img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .tile:hover, .tile:focus-visible { opacity: 1; filter: none; transform: scale(1.08); }
  .tile.on { opacity: 1; filter: none; }
  .tile:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .rail-home:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .tile, .rail-home { transition: none; }
    .tile:hover, .tile:focus-visible { transform: none; }
  }

  /* schermi larghi: c'è margine fuori dal contenuto → il menù torna colonna
     laterale, come chiesto (1050px di contenuto + 2×~120px di respiro) */
  @media (min-width: 1300px) {
    .rail { left: 1.4rem; bottom: auto; top: 50%; transform: translateY(-50%);
      flex-direction: column; gap: 0.9rem; }
    .rail ul { flex-direction: column; gap: 0.55rem; }
  }

  /* schermi stretti: striscia ancora più compatta */
  @media (max-width: 560px) {
    .rail { left: 0.7rem; bottom: 0.7rem; gap: 0.5rem; }
    .rail-home { width: 58px; }
    .tile { width: 26px; height: 26px; }
  }
</style>
