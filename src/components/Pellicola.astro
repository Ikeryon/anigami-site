---
// ══════════════════════════════════════════════════════════════════════
// LA PELLICOLA — il menù di progetto unico del sito (BRIEF-MENU.md).
// Sostituisce BrandRail.astro. Cinque fotogrammi in fila su una striscia:
// il monogramma della casa e i quattro marchi. È la home ripiegata.
//
// LA REGOLA CROMATICA (§2): a riposo resta solo l'inchiostro — la t, la G,
// il faro, il segno di EVO, disegnati nel colore del testo della capsula.
// La piastrella colorata ricompare in due soli casi: al passaggio e sulla
// pagina in cui ti trovi. Il colore smette di essere decorazione e
// diventa informazione.
//
// Lo sprite (public/logos/menu/brand-marks.svg) è inlinato UNA volta in
// BaseLayout: le custom property attraversano il confine d'ombra di
// <use>, quindi --mk-tile e --mk-ink impostate qui arrivano dentro il
// simbolo. Con <img> non sarebbe possibile: è il limite della v1.
// ══════════════════════════════════════════════════════════════════════

interface Props {
  lang?: 'it' | 'en';
  current?: 'home' | 'tipicita' | 'grand-tour' | 'tipicita-in-blu' | 'evo';
  /** 'light' | 'dark': decide se la piastrella accesa usa il colore
      ufficiale o la variante accesa. Lo dichiara la pagina. */
  mode?: 'light' | 'dark';
}

const { lang = 'it', current, mode = 'light' } = Astro.props;

// enReady = la versione inglese esiste davvero. Finché non c'è, in EN si
// rimanda all'italiano (con hreflang onesto) invece di produrre un 404.
//
// ⚠️ GRAND TOUR, deviazione documentata dalla tabella del §2: l'ufficiale
// #ee726c porta l'inchiostro-carta a 2,6:1 sulla piastrella accesa, sotto
// il 3:1 richiesto per gli elementi grafici (WCAG 1.4.11). Il brief stesso
// chiedeva di verificare proprio questo caso. Si usa quindi #d1544c — il
// tono scurito già adottato per i testi del Grand Tour — anche su chiaro.
const marchi = [
  { key: 'tipicita', simbolo: 'mk-tipicita', nome: 'Tipicità Festival',
    it: '/tipicita/', en: '/en/tipicita/', enReady: true,
    ufficiale: '#035f6a', acceso: '#05606a' },
  { key: 'grand-tour', simbolo: 'mk-grand-tour', nome: 'Grand Tour delle Marche',
    it: '/grand-tour-delle-marche/', en: '/en/grand-tour-delle-marche/', enReady: false,
    ufficiale: '#d1544c', acceso: '#d1544c' },
  { key: 'tipicita-in-blu', simbolo: 'mk-tipicita-in-blu', nome: 'Tipicità in Blu',
    it: '/tipicita-in-blu/', en: '/en/tipicita-in-blu/', enReady: false,
    ufficiale: '#112f49', acceso: '#209fb6' },
  { key: 'evo', simbolo: 'mk-evo', nome: 'EVO',
    it: '/evo/', en: '/en/evo/', enReady: false,
    ufficiale: '#7f1244', acceso: '#b8497a' },
];

const casa = lang === 'en' ? 'Imagina — the house' : 'Imagina — la casa';
const etichettaNav = lang === 'en' ? 'Imagina projects' : 'Progetti Imagina';
const etichettaFoglio = lang === 'en' ? 'Open the menu' : 'Apri il menù';

const href = (m: (typeof marchi)[number]) => (lang === 'en' && m.enReady ? m.en : m.it);
const hreflang = (m: (typeof marchi)[number]) => (lang === 'en' && !m.enReady ? 'it' : undefined);
const acceso = (m: (typeof marchi)[number]) => (mode === 'dark' ? m.acceso : m.ufficiale);

const voci = [
  { key: 'home', simbolo: 'mk-imagina-mono', box: '0 0 53.16 53.16', nome: casa, url: '/', hl: undefined, tinta: null },
  ...marchi.map((m) => ({
    key: m.key, simbolo: m.simbolo, box: '0 0 78.96 78.96', nome: m.nome,
    url: href(m), hl: hreflang(m), tinta: acceso(m),
  })),
];
---

<nav class:list={['pellicola', `is-${mode}`]} aria-label={etichettaNav}>
  <div class="capsula">
    <!-- LA CASA. Su desktop è un link alla home; sul telefono è il bottone
         che apre il foglio (§7: al tocco la didascalia non serve a niente,
         al suo posto la capsula si apre). Uno solo dei due è mai reso
         visibile, quindi nell'albero di accessibilità ce n'è sempre uno. -->
    <a class="mark casa casa-link" href="/" aria-current={current === 'home' ? 'page' : undefined}>
      <svg viewBox="0 0 53.16 53.16" aria-hidden="true"><use href="#mk-imagina-mono" /></svg>
      <span class="cap">{casa}</span>
    </a>

    <button class="mark casa casa-tocco" type="button" aria-expanded="false" aria-controls="pellicola-foglio">
      <svg viewBox="0 0 53.16 53.16" aria-hidden="true"><use href="#mk-imagina-mono" /></svg>
      <span class="sr-only">{etichettaFoglio}</span>
    </button>

    <span class="filetto" aria-hidden="true"></span>

    <ul>
      {marchi.map((m) => (
        <li>
          <a
            class="mark"
            href={href(m)}
            hreflang={hreflang(m)}
            style={`--acceso: ${acceso(m)}`}
            aria-current={current === m.key ? 'page' : undefined}
          >
            <svg viewBox="0 0 78.96 78.96" aria-hidden="true"><use href={`#${m.simbolo}`} /></svg>
            <span class="cap">{m.nome}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- IL FOGLIO (solo telefono): cinque righe, segno + nome per esteso. -->
  <div class="foglio" id="pellicola-foglio" hidden>
    <ul>
      {voci.map((v) => (
        <li>
          <a
            href={v.url}
            hreflang={v.hl}
            class:list={['riga', { casa: v.key === 'home' }]}
            style={v.tinta ? `--acceso: ${v.tinta}` : undefined}
            aria-current={current === v.key ? 'page' : undefined}
          >
            {/* niente class="mark" qui: .mark azzera --mk-tile sull'SVG
                stesso e il "sei qui" del foglio non si accendeva mai */}
            <svg viewBox={v.box} aria-hidden="true"><use href={`#${v.simbolo}`} /></svg>
            <span>{v.nome}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  /* ══ POSIZIONE — l'unico elemento del sito che non si sposta mai ══ */
  .pellicola {
    position: fixed;
    top: 1.2rem;
    right: 1.4rem;
    /* il brief diceva 30, ma le barre sticky già in pagina stanno a 30
       (.strada del Grand Tour, la plancia del TIB) e a 40 (.chapter-bar):
       la pellicola è l'elemento che non si sposta mai, quindi sta sopra */
    z-index: 45;
  }

  /* ══ LA CAPSULA ══
     Si porta dietro la propria carta e il proprio inchiostro, indipendenti
     dalla sezione che le scorre sotto: sul campo petrolio dell'hero di
     Tipicità è una tessera bianca, su TIB un vetro scuro con hairline
     chiara. Niente mix-blend-mode (esplode appena sotto passa un colore
     di marchio). */
  /* senza backdrop-filter la capsula resta piena all'88% invece che al 76%:
     nessuna regressione, solo un po' meno vetro */
  .pellicola { --carta: rgba(252, 252, 250, 0.93); --inchiostro: #1e2a2c; --filo: rgba(30, 42, 44, 0.16); }
  .pellicola.is-dark { --carta: rgba(12, 11, 16, 0.91); --inchiostro: #ece7db; --filo: rgba(236, 231, 219, 0.22); }

  @supports (backdrop-filter: blur(1px)) {
    /* 0.84 e non 0.76: sul campo petrolio pieno dell'hero di Tipicità il
       76% lasciava passare troppo verde e la capsula smetteva di essere
       "una tessera bianca". A 0.84 resta vetro e resta carta. */
    .pellicola { --carta: rgba(252, 252, 250, 0.84); }
    .pellicola.is-dark { --carta: rgba(12, 11, 16, 0.82); }
    .capsula, .foglio { backdrop-filter: blur(12px) saturate(1.2); }
  }

  .capsula {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--filo);
    background: var(--carta);
    color: var(--inchiostro);
    box-shadow: 0 1px 12px rgba(0, 0, 0, 0.07);
  }

  .capsula ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 7px; /* la gola tra i fotogrammi */
  }

  .filetto {
    width: 1px;
    height: 20px;
    background: var(--filo);
    flex: none;
  }

  /* ══ I FOTOGRAMMI ══ */
  /* Bersaglio 44×44 senza cambiare la dimensione del segno (WCAG 2.5.8):
     il padding porta il box a 44, il margine negativo lo restituisce al
     layout come 30 — la capsula resta alta 42px e il segno resta 30.
     Niente position: relative qui, così la didascalia si aggancia alla
     pellicola e non al singolo fotogramma: uno slot unico condiviso. */
  .mark {
    display: grid;
    place-items: center;
    box-sizing: content-box;
    width: 30px;
    height: 30px;
    padding: 7px;
    margin: -7px;
    flex: none;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    --mk-tile: transparent;
    --mk-ink: currentColor;
    opacity: 0.70;
    transition: opacity 0.22s ease, transform 0.22s ease;
  }

  .mark svg { display: block; width: 100%; height: 100%; }

  .mark:hover, .mark:focus-visible {
    opacity: 1;
    transform: translateY(-2px);
    --mk-tile: var(--acceso);
    --mk-ink: var(--bg-void);
  }

  .mark[aria-current='page'] {
    opacity: 1;
    --mk-tile: var(--acceso);
    --mk-ink: var(--bg-void);
  }

  .mark:focus-visible {
    outline: 2px solid var(--brand-accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* la casa: unico elemento tondo, unico con la sfumatura */
  .casa { --mk-tile: transparent; --mk-ink: currentColor; opacity: 0.68; }
  .casa:hover, .casa:focus-visible,
  .casa[aria-current='page'] {
    opacity: 1;
    --mk-tile: url(#imagina-grad);
    --mk-ink: var(--bg-void);
  }

  /* ══ LA DIDASCALIA ══
     Slot unico condiviso sotto la capsula, allineato a destra: la capsula
     non cambia mai dimensione. È anche il nome accessibile del link —
     opacity: 0 non lo toglie dall'albero di accessibilità, quindi un solo
     elemento fa entrambi i mestieri. */
  .cap {
    position: absolute;
    top: calc(100% + 7px);
    right: 0;
    white-space: nowrap;
    font-family: 'Manrope', sans-serif;
    font-size: 0.63rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--inchiostro);
    /* La didascalia esce dalla capsula, quindi si porta dietro la stessa
       carta: senza, sul campo petrolio pieno di Tipicità l'inchiostro
       scuro finiva a 1,5:1 e la riga era illeggibile proprio dove serve. */
    background: var(--carta);
    border: 1px solid var(--filo);
    border-radius: 999px;
    padding: 3px 10px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
  }

  @supports (backdrop-filter: blur(1px)) {
    .cap { backdrop-filter: blur(12px) saturate(1.2); }
  }

  .mark:hover .cap, .mark:focus-visible .cap { opacity: 1; }

  /* ══ IL FOGLIO (telefono) ══ */
  .foglio {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 240px;
    padding: 0.5rem 0.4rem;
    border-radius: 18px;
    border: 1px solid var(--filo);
    background: var(--carta);
    color: var(--inchiostro);
    box-shadow: 0 6px 26px rgba(0, 0, 0, 0.16);
  }

  @supports (backdrop-filter: blur(1px)) {
    .foglio { backdrop-filter: blur(14px) saturate(1.2); }
  }

  .foglio[hidden] { display: none; }
  .foglio ul { list-style: none; margin: 0; padding: 0; }

  .foglio .riga {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    padding: 0.35rem 0.7rem;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    font-family: 'Manrope', sans-serif;
    font-size: 0.82rem;
    --mk-tile: transparent;
    --mk-ink: currentColor;
  }

  .foglio .riga svg { width: 24px; height: 24px; flex: none; opacity: 0.8; }
  .foglio .riga[aria-current='page'] { --mk-tile: var(--acceso); --mk-ink: var(--bg-void); }
  .foglio .riga[aria-current='page'] svg { opacity: 1; }
  .foglio .riga:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 2px; }
  .foglio .riga.casa:hover, .foglio .riga.casa[aria-current='page'] { --mk-tile: url(#imagina-grad); }

  /* Su desktop il foglio non esiste e il bottone nemmeno. */
  .casa-tocco { display: none; }

  /* ══ SUL TELEFONO (§7) ══
     Sotto i 760px la capsula lascia l'angolo e scende al centro in basso,
     nella zona del pollice. Il tocco non ha il passaggio del mouse: la
     didascalia sparisce (resta il nome accessibile) e al suo posto la
     capsula si apre. */
  @media (max-width: 759px) {
    .pellicola {
      top: auto;
      right: auto;
      left: 50%;
      transform: translateX(-50%);
      bottom: max(0.8rem, env(safe-area-inset-bottom));
    }

    .casa-link { display: none; }
    .casa-tocco { display: grid; }

    .mark { width: 26px; height: 26px; }
    .cap { display: none; }
  }

  @media (min-width: 760px) {
    .foglio { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mark { transition: opacity 0.22s ease; }
    .mark:hover, .mark:focus-visible { transform: none; }
    .cap { transition: none; }
  }
</style>

<script>
  // Il foglio del telefono. Senza JS le quattro piastrelle restano
  // navigabili: il foglio è una scorciatoia in più, non l'unica strada.
  function pellicola() {
    document.querySelectorAll('.casa-tocco').forEach((btn) => {
      if ((btn as HTMLElement).dataset.on) return;
      (btn as HTMLElement).dataset.on = '1';
      const nav = btn.closest('.pellicola');
      const foglio = nav && nav.querySelector('.foglio');
      if (!foglio) return;

      const chiudi = () => {
        foglio.setAttribute('hidden', '');
        btn.setAttribute('aria-expanded', 'false');
      };

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const aperto = btn.getAttribute('aria-expanded') === 'true';
        if (aperto) { chiudi(); return; }
        foglio.removeAttribute('hidden');
        btn.setAttribute('aria-expanded', 'true');
        const primo = foglio.querySelector('a');
        if (primo) (primo as HTMLElement).focus();
      });

      document.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
          chiudi();
          (btn as HTMLElement).focus();
        }
      });

      document.addEventListener('click', (e) => {
        if (btn.getAttribute('aria-expanded') !== 'true') return;
        if (nav && !nav.contains(e.target as Node)) chiudi();
      });
    });
  }

  document.addEventListener('astro:page-load', pellicola);
  pellicola();
</script>
