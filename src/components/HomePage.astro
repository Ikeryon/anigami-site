---
import BaseLayout from '../layouts/BaseLayout.astro';
import { content } from '../i18n/home.js';

// ══════════════════════════════════════════════════════════════════════
// LA HOME — LA CASA (BRIEF-HOME v4, 09/08/2026)
//
// Un campo scuro a piena pagina dentro una cornice. Al centro il
// logotipo Imagina che si compone UNA VOLTA SOLA e resta. Sotto, la riga
// di visione. Dietro, molto attenuato, un fondale che respira. Sul
// filetto in basso i dispacci dal feed. In basso a destra i quattro
// segni dei progetti, piccoli.
//
// Niente scroll, niente overlay di marchio, niente Mutamenti: chi
// atterra qui deve ricevere la visione di IMAGINA, non quella dei
// singoli progetti. I quattro progetti stanno in un angolo come timbri.
//
// ⚠️ REGOLE SOVRANE — la parola "anigami" non compare mai (vive solo in
// info@anigami.it); mai "quattro festival"; i giochi di senso non si
// spiegano.
//
// ⚠️⚠️ IL PUNTO IN CUI È FACILE SBAGLIARE: il logotipo è bianco su nero e
// va in `mix-blend-mode: screen`, che mangia il nero e lascia passare
// solo il segno luminoso. Il blend agisce sul CONTESTO DI IMPILAMENTO
// più vicino: se un antenato del video ha z-index, opacity < 1,
// transform, filter o will-change, il logo si fonde con il vuoto e il
// rettangolo nero riappare. Per questo qui i livelli sono ordinati
// SOLO dall'ordine nel DOM — fondale, vignetta, cornice, contenuto — e
// non c'è un solo z-index dentro .casa.
// ══════════════════════════════════════════════════════════════════════

// Struttura e disegno stanno qui; i testi in src/i18n/home.js. Le due
// pagine sottili — /index.astro e /en/index.astro — passano solo la lingua,
// esattamente come fanno le due di Tipicità con TipicitaPage.
interface Props {
  lang?: 'it' | 'en';
}
const { lang = 'it' } = Astro.props;
const c = content[lang];

// hreflang: l'italiano alla radice, l'inglese sotto /en/, x-default
// sull'italiano. Stessa dichiarazione che ha già Tipicità.
const alternates = [
  { hreflang: 'it', href: '/' },
  { hreflang: 'en', href: '/en/' },
  { hreflang: 'x-default', href: '/' },
];

// I quattro segni (§9). Sul campo scuro si usano le varianti accese,
// come sulla pellicola delle pagine scure.
const segni = c.segni.voci;

// Il campo scuro. Neutro di proposito: il fondale è materiale caldo e
// deve poter tingere la pagina senza litigare con una dominante.
const theme = {
  '--bg-void': '#08090b',
  '--bg-deep': '#101216',
  '--bg-mid': '#191c21',
  '--text-soft': '#f2efe9',
  '--text-dim': 'rgba(242, 239, 233, 0.72)',
  '--text-faint': 'rgba(242, 239, 233, 0.55)',
  '--hairline': 'rgba(242, 239, 233, 0.22)',
  '--imagina-ink': '#f26fae',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: c.sd.name,
  url: 'https://anigami.it',
  email: 'info@anigami.it',
  foundingDate: '1991',
  address: {
    '@type': 'PostalAddress',
    streetAddress: c.sd.streetAddress,
    addressLocality: c.sd.addressLocality,
    addressRegion: c.sd.addressRegion,
    postalCode: '62032',
    addressCountry: 'IT',
  },
  vatID: 'IT01115460436',
};
---

<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  lang={lang}
  alternates={alternates}
  theme={theme}
  structuredData={structuredData}
>
  <main class="casa">
    <h1 class="sr-only">{c.titolo}</h1>

    {/* 1 · IL FONDALE — primo nel DOM, sotto tutto il resto senza z-index */}
    <video
      class="fondale"
      id="fondale"
      src="/home/imagina-fondo.mp4"
      poster="/home/imagina-fondo-poster.jpg"
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
      tabindex="-1"
    ></video>

    {/* 2 · LA VIGNETTA — è questa che tiene leggibile il testo */}
    <div class="vignetta" aria-hidden="true"></div>

    {/* 3 · LA CORNICE — filetto inset con le quattro tacche d'angolo */}
    <div class="cornice" aria-hidden="true">
      <span class="tacca tacca--as"></span><span class="tacca tacca--ad"></span>
      <span class="tacca tacca--bs"></span><span class="tacca tacca--bd"></span>
    </div>

    {/* 4 · LE RIGHE IN CORNICE */}
    <p class="riga riga--as">{c.cornice.societa}</p>
    {/* Il selettore di lingua sta nell'angolo che ha già una voce attiva,
        accanto a «Chi siamo»: è l'unico punto della cornice dove si clicca,
        e due comandi nello stesso angolo si cercano una volta sola.
        Compare solo perché l'inglese della home esiste davvero — sulle
        altre pagine non c'è, ed è giusto così finché non ce l'hanno. */}
    <div class="riga riga--ad">
      <a class="to-lang" href={c.langToggle.href} hreflang={c.langToggle.to} aria-label={c.langToggle.aria}>{c.langToggle.label}</a>
      <button class="chi-siamo" type="button" data-apre="ov-imagina">{c.cornice.chiSiamo}</button>
    </div>
    <p class="riga riga--bs">{c.cornice.luogo}</p>

    {/* 5 · IL CENTRO — il logotipo e la visione.
        Nessun antenato con z-index/opacity/transform fra il video e il
        fondale: la scena è solo una griglia di centratura. */}
    <div class="scena">
      <video
        class="logotipo"
        id="logotipo"
        src="/home/imagina-logo.mp4"
        poster="/home/imagina-logo-poster.png"
        muted
        playsinline
        preload="auto"
        aria-hidden="true"
        tabindex="-1"
      ></video>

      {/* ⚠️ SEGNAPOSTO: la riga di visione è ancora da decidere. Le tre
          candidate stanno nel commento sopra `visione` in src/i18n/home.js. */}
      <p class="visione" id="visione">{c.visione}</p>
    </div>

    {/* 6 · I DISPACCI — la riga non esiste finché il feed non risponde.
        `hidden` in partenza: se la fetch fallisce o torna vuota resta
        così, e in basso non c'è nessuno scheletro. */}
    {/* `data-locale`: la formattazione della data è l'unica stringa di
        questa pagina che vive nello script. Viaggia fin lì come attributo
        invece che scritta nel codice, così quando arriva l'inglese basta
        cambiarla in src/i18n/home.js. */}
    <section
      class="dispacci"
      id="dispacci"
      aria-label={c.dispacci.ariaLabel}
      data-locale={c.dispacci.locale}
      hidden
    >
      <ul id="dispacci-lista"></ul>
    </section>

    {/* 7 · I QUATTRO SEGNI */}
    <nav class="segni" aria-label={c.segni.ariaLabel}>
      <span class="segni-eti" aria-hidden="true">{c.segni.etichetta}</span>
      <ul>
        {segni.map((s) => (
          <li>
            <a class="segno" href={s.href} style={`--acceso: ${s.acceso}`}>
              <svg viewBox="0 0 78.96 78.96" aria-hidden="true"><use href={`#${s.simbolo}`} /></svg>
              <span class="sr-only">{s.nome}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </main>

  {/* L'UNICO SIPARIO RIMASTO: il profilo. I quattro di marchio e quello
      di Mutamenti sono stati rimossi con la v4. */}
  <dialog id="ov-imagina" class="sipario" aria-labelledby="ov-imagina-t">
    <button class="chiudi" type="button" data-chiude aria-label={c.sipario.chiudi}>
      <span aria-hidden="true">×</span>
    </button>
    <div class="sipario-in">
      <h2 class="kicker" id="ov-imagina-t">{c.sipario.titolo}</h2>

      {c.sipario.blocchi.map((b) => (
        <section class="blocco-profilo">
          <h3 class="titoletto">{b.titolo}</h3>
          {b.par.map((t) => <p class="profilo" set:html={t} />)}
        </section>
      ))}

      <div class="piede-blocco">
        <nav class="accessi" aria-label={c.sipario.accessiAria}>
          {c.sipario.accessi.map((a) => <a href={a.href}>{a.label}</a>)}
        </nav>
        <p class="piede">{c.sipario.piede}</p>
      </div>
    </div>
  </dialog>
</BaseLayout>

<style is:global>
  /* La casa è una sola inquadratura: non si scorre. */
  html, body { height: 100%; overflow: hidden; background: #08090b; }
  /* Il piede classico non esiste in home: vive dentro il sipario. */
  body > footer.site-footer { display: none; }

  /* ══ LE VOCI DEI DISPACCI ══
     Sono create da JavaScript e quindi prive dell'attributo di scoping:
     vanno vestite da qui. Tutto circoscritto a .dispacci, così non
     esce niente dal perimetro della home. */
  .dispacci ul {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    min-height: 3.2em;
  }

  .dispacci li {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease, visibility 0.6s;
  }

  .dispacci li.in-onda { opacity: 1; visibility: visible; }

  .dispacci a {
    pointer-events: auto;
    display: inline-block;
    max-width: 62ch;
    font-family: 'Manrope', sans-serif;
    font-size: 0.78rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: rgba(242, 239, 233, 0.72);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .dispacci a:hover {
    color: #f2efe9;
    border-bottom-color: rgba(242, 239, 233, 0.22);
  }

  .dispacci a:focus-visible { outline: 2px solid #f2efe9; outline-offset: 4px; }

  .dispacci .quando {
    display: block;
    font-family: 'Manrope', sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(242, 239, 233, 0.55);
    margin-bottom: 0.35rem;
  }

  @media (max-width: 760px) {
    .dispacci a { font-size: 0.72rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dispacci li { transition: none; }
  }
</style>

<style>
  /* ══ IL CAMPO ══
     ⚠️ Dentro .casa non c'è UN SOLO z-index, e non ci deve andare: i
     livelli sono l'ordine del DOM. Basta un z-index qui per rompere il
     mix-blend-mode del logotipo. */
  .casa {
    position: fixed;
    inset: 0;
    background: var(--bg-void);
    overflow: hidden;
  }

  /* ── il fondale ── */
  .fondale {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 28%: la soglia trovata a schermo col fotogramma più chiaro. Se la
       riga di visione fatica si scende di qui, non si ingrandisce il testo. */
    opacity: 0.32;
    pointer-events: none;
  }

  /* ── la vignetta: è lei che tiene leggibile tutto ── */
  .vignetta {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 82% 72% at 50% 46%, rgba(8, 9, 11, 0.22) 0%, rgba(8, 9, 11, 0.80) 74%, rgba(8, 9, 11, 0.93) 100%),
      linear-gradient(180deg, rgba(8, 9, 11, 0.75) 0%, transparent 22%, transparent 74%, rgba(8, 9, 11, 0.85) 100%);
  }

  /* ── la cornice: un fotogramma ── */
  .cornice {
    position: absolute;
    inset: 20px;
    border: 1px solid var(--hairline);
    pointer-events: none;
  }

  /* le quattro tacche d'angolo, marcate */
  .tacca { position: absolute; width: 14px; height: 14px; }
  .tacca::before, .tacca::after {
    content: '';
    position: absolute;
    background: var(--text-soft);
  }
  .tacca::before { width: 14px; height: 1px; }
  .tacca::after { width: 1px; height: 14px; }
  .tacca--as { top: -1px; left: -1px; }
  .tacca--ad { top: -1px; right: -1px; }
  .tacca--ad::before { right: 0; } .tacca--ad::after { right: 0; }
  .tacca--bs { bottom: -1px; left: -1px; }
  .tacca--bs::before { bottom: 0; } .tacca--bs::after { bottom: 0; }
  .tacca--bd { bottom: -1px; right: -1px; }
  .tacca--bd::before { bottom: 0; right: 0; } .tacca--bd::after { bottom: 0; right: 0; }

  /* ── le righe in cornice ── */
  .riga {
    position: absolute;
    margin: 0;
    font-family: 'Manrope', sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .riga--as { top: 44px; left: 46px; }
  /* due voci nello stesso angolo: in riga, con il filetto fra loro a
     tenerle distinte senza aggiungere un segno nuovo */
  .riga--ad { top: 38px; right: 46px; display: flex; align-items: baseline; gap: 1rem; }
  .riga--bs { bottom: 44px; left: 46px; }

  /* Il selettore di lingua: un gradino sotto «Chi siamo», perché è un
     rimando e non il comando principale dell'angolo. Stesso trattamento
     che ha in barra su Tipicità. */
  .to-lang {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--text-dim);
    text-decoration: none;
    padding: 0.4rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .to-lang:hover { color: var(--text-soft); border-bottom-color: var(--hairline); }
  .to-lang:focus-visible { outline: 2px solid var(--text-soft); outline-offset: 4px; }

  .chi-siamo {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--text-soft);
    background: none;
    border: 0;
    padding: 0.4rem 0;
    cursor: pointer;
    border-bottom: 1px solid var(--hairline);
  }

  .chi-siamo:hover { border-bottom-color: var(--text-soft); }
  .chi-siamo:focus-visible { outline: 2px solid var(--text-soft); outline-offset: 4px; }

  /* ── il centro ──
     Solo centratura: niente z-index, opacity o transform, altrimenti il
     logotipo perde il fondale con cui deve fondersi. */
  .scena {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: clamp(1.4rem, 3.2vh, 2.6rem);
    padding: 0 clamp(1.6rem, 6vw, 4rem);
    pointer-events: none;
  }

  /* IL LOGOTIPO. Bianco su nero + screen: il nero sparisce e resta il
     segno luminoso, senza rettangolo. */
  .logotipo {
    display: block;
    width: min(56vw, 620px);
    height: auto;
    aspect-ratio: 1280 / 720;
    mix-blend-mode: screen;
  }

  /* Il video del logotipo ha parecchio nero attorno al segno: in screen
     è invisibile, ma nel flusso occupa. Il margine negativo recupera
     quello spazio e riavvicina la riga al logotipo. */
  .visione {
    margin: clamp(-5.5vh, -4vh, -2rem) 0 0;
    /* 22ch era tarato sulle frasi candidate, che erano lunghe. Quella
       scelta è corta e va tenuta SU UNA RIGA SOLA — è quello che la rende
       un'affermazione e non uno slogan — quindi la misura si allarga fino
       a contenerla: 23 battute in italiano, 29 in inglese. Il vincolo in
       vw la fa cedere solo dove lo schermo non la regge davvero. */
    max-width: min(34ch, 88vw);
    text-align: center;
    text-wrap: balance;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: clamp(1.5rem, 3.4vw, 2.5rem);
    line-height: 1.28;
    color: var(--text-soft);
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  .visione.entra { opacity: 1; }
  .visione i { font-style: italic; }

  /* ── i dispacci ──
     Uno alla volta a ogni larghezza: dodici titoli in fila non entrano
     da nessuna parte, e un ticker che scorre è illeggibile sul telefono.
     Sono link veri: quello in vista è raggiungibile col Tab, gli altri
     restano fuori dall'ordine di tabulazione. */
  .dispacci {
    position: absolute;
    left: 46px;
    right: 46px;
    bottom: 92px;
    text-align: center;
    pointer-events: none;
  }

  .dispacci[hidden] { display: none; }

  /* ⚠️ Le voci dei dispacci nascono da JavaScript, quindi NON ricevono
     l'attributo di scoping di Astro: se i loro stili stanno qui non si
     applicano affatto. Stanno nel blocco is:global in fondo al file,
     circoscritti a .dispacci. */

  /* ── i quattro segni ── */
  .segni {
    position: absolute;
    right: 46px;
    bottom: 40px;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .segni-eti {
    font-family: 'Manrope', sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .segni ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .segno {
    display: grid;
    place-items: center;
    box-sizing: content-box;
    width: 27px;
    height: 27px;
    /* bersaglio 44×44 senza cambiare la dimensione del segno */
    padding: 8px;
    margin: -8px;
    --mk-tile: transparent;
    --mk-ink: rgba(242, 239, 233, 0.52);
    transition: transform 0.22s ease;
  }

  .segno svg { display: block; width: 100%; height: 100%; }

  .segno:hover, .segno:focus-visible {
    transform: translateY(-2px);
    --mk-tile: var(--acceso);
    --mk-ink: var(--bg-void);
  }

  .segno:focus-visible { outline: 2px solid var(--text-soft); outline-offset: 3px; border-radius: 4px; }

  /* ══ IL SIPARIO DEL PROFILO ══ */
  .sipario {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: auto;
    overscroll-behavior: contain;
    background: var(--bg-void);
    color: var(--text-soft);
  }

  .sipario::backdrop { background: transparent; }
  .sipario[open] { animation: taglio 0.28s cubic-bezier(0.2, 0, 0, 1) both; }

  @keyframes taglio {
    from { clip-path: inset(0 0 100% 0); }
    to   { clip-path: inset(0 0 0 0); }
  }

  .sipario-in {
    min-height: 100%;
    max-width: 60ch;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    justify-content: safe center;
    padding: clamp(4.5rem, 9vh, 6rem) clamp(1.4rem, 6vw, 3rem) clamp(2.5rem, 6vh, 4rem);
  }

  .chiudi {
    position: absolute;
    top: clamp(0.9rem, 2.4vw, 1.6rem);
    right: clamp(0.9rem, 2.4vw, 1.6rem);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    font-size: 1.7rem;
    line-height: 1;
    color: inherit;
    background: none;
    border: 0;
    opacity: 0.6;
    cursor: pointer;
  }

  .chiudi:hover { opacity: 1; }
  .chiudi:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; opacity: 1; }

  .kicker {
    font-family: 'Manrope', sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin: 0 0 2.2rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--hairline);
  }

  .blocco-profilo { margin: 0 0 2.4rem; }

  .titoletto {
    font-family: 'Manrope', sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--imagina-ink);
    margin: 0 0 0.9rem;
  }

  .profilo {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: clamp(1.02rem, 1.6vw, 1.18rem);
    line-height: 1.55;
    color: var(--text-soft);
    margin: 0 0 1rem;
  }

  .profilo:last-child { margin-bottom: 0; }
  .profilo b { font-weight: 700; }

  .profilo a {
    color: var(--imagina-ink);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--imagina-ink) 45%, transparent);
  }

  .profilo a:hover { border-bottom-color: var(--imagina-ink); }
  .profilo a:focus-visible { outline: 2px solid var(--imagina-ink); outline-offset: 3px; }

  .piede-blocco {
    position: sticky;
    bottom: 0;
    margin-top: 2.4rem;
    padding-bottom: 0.4rem;
    background: var(--bg-void);
  }

  .piede-blocco::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 2rem;
    background: linear-gradient(to top, var(--bg-void), transparent);
    pointer-events: none;
  }

  .accessi {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--hairline);
    font-family: 'Manrope', sans-serif;
    font-size: 0.82rem;
  }

  .accessi a {
    color: var(--text-dim);
    text-decoration: none;
    padding: 0.3rem 0;
  }

  .accessi a:hover { color: var(--imagina-ink); }
  .accessi a:focus-visible { outline: 2px solid var(--imagina-ink); outline-offset: 3px; }

  .piede {
    margin: 1.4rem 0 0;
    font-family: 'Manrope', sans-serif;
    font-size: 0.7rem;
    color: var(--text-dim);
  }

  /* ══ TELEFONO (§10) ══ */
  @media (max-width: 760px) {
    .cornice { inset: 12px; }
    .riga { font-size: 0.62rem; letter-spacing: 0.12em; }
    .riga--as { top: 28px; left: 28px; right: 28px; }
    .riga--ad { top: 24px; right: 28px; }
    .riga--bs { display: none; }

    .logotipo { width: 78vw; }
    .visione { max-width: 18ch; }

    .dispacci { left: 24px; right: 24px; bottom: 104px; }

    /* i quattro segni scendono in basso al centro */
    .segni {
      right: auto;
      left: 50%;
      transform: translateX(-50%);
      bottom: 34px;
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  /* ══ REDUCED MOTION ══
     Niente video: le due pose, ferme. Il logotipo resta in screen, così
     il poster con alfa non porta rettangoli. */
  @media (prefers-reduced-motion: reduce) {
    .visione { transition: none; }
    .segno { transition: none; }
  }
</style>

<script>
  // ══ LA REGIA DELLA CASA ══
  function casa() {
    const campo = document.querySelector('.casa');
    if (!campo || campo.dataset.on) return;
    campo.dataset.on = '1';

    const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // risparmio dati: se il browser lo dichiara, niente video
    const risparmio = navigator.connection && navigator.connection.saveData === true;
    const fermo = ridotto || risparmio;

    const logo = document.getElementById('logotipo');
    const fondale = document.getElementById('fondale');
    const visione = document.getElementById('visione');

    // ── il logotipo: si compone UNA volta sola, poi resta ──
    // Alla seconda visita non si ricompone: il poster è l'ultimo
    // fotogramma, quindi basta non farlo partire.
    let giaVisto = false;
    try { giaVisto = sessionStorage.getItem('casa-logo') === '1'; } catch {}

    function mostraVisione() { visione.classList.add('entra'); }

    if (fermo || giaVisto) {
      mostraVisione();
    } else {
      logo.addEventListener('ended', () => {
        mostraVisione();
        try { sessionStorage.setItem('casa-logo', '1'); } catch {}
      }, { once: true });
      const p = logo.play();
      if (p && p.catch) p.catch(() => mostraVisione());
    }

    if (!fermo) {
      const f = fondale.play();
      if (f && f.catch) f.catch(() => {});
    }

    // ── il sipario del profilo ──
    // <dialog> nativo: trappola del fuoco, ESC, aria-modal e ritorno del
    // fuoco alla voce d'origine li dà il browser. Qui resta la history:
    // aprire impila, il back del browser chiude invece di uscire.
    const sipario = document.getElementById('ov-imagina');
    let aperto = false, impilato = false, guardia = false;

    function apri(daAncora) {
      if (aperto) return;
      aperto = true;
      sipario.showModal();
      guardia = true;
      if (daAncora) { history.replaceState({ sipario: 1 }, '', '#chi-siamo'); impilato = false; }
      else { history.pushState({ sipario: 1 }, '', '#chi-siamo'); impilato = true; }
      guardia = false;
    }

    function chiudi(daHistory) {
      if (!aperto) return;
      aperto = false;
      sipario.close();
      if (daHistory) return;
      if (impilato) { impilato = false; guardia = true; history.back(); }
      else history.replaceState({}, '', location.pathname + location.search);
    }

    document.querySelectorAll('[data-apre]').forEach((b) => b.addEventListener('click', () => apri(false)));
    sipario.querySelector('[data-chiude]').addEventListener('click', () => chiudi(false));
    sipario.addEventListener('click', (e) => { if (e.target === sipario) chiudi(false); });
    // ESC e ogni altra chiusura nativa devono rimettere in pari la history
    sipario.addEventListener('close', () => { if (aperto) chiudi(false); });

    // in cattura: le View Transitions di Astro ascoltano popstate in
    // bolla, e i nostri stati non sono affari loro
    window.addEventListener('popstate', (e) => {
      const nostro = e.state && e.state.sipario;
      if (!guardia && !aperto && !nostro) return;
      e.stopImmediatePropagation();
      if (guardia) { guardia = false; return; }
      if (nostro) { apri(true); return; }
      if (aperto) chiudi(true);
    }, true);

    if (location.hash === '#chi-siamo') apri(true);

    // ── i dispacci ──
    // Se il feed non risponde o è vuoto la riga non compare: la sezione
    // resta `hidden` e in basso non c'è nessuno scheletro.
    const zona = document.getElementById('dispacci');
    const lista = document.getElementById('dispacci-lista');

    fetch('/api/dispacci?categoria=0')
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        const voci = (d && d.dispacci) || [];
        if (!voci.length) return;

        voci.forEach((v) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = v.link;
          a.rel = 'noopener';
          const quando = document.createElement('span');
          quando.className = 'quando';
          const dt = new Date(v.data);
          quando.textContent = Number.isNaN(dt.getTime())
            ? ''
            // la lingua della data arriva dall'attributo, non dal codice:
            // è l'unica stringa di questa pagina che vive qui dentro, e
            // quando arriverà l'inglese si cambia in src/i18n/home.js
            : dt.toLocaleDateString(zona.dataset.locale || 'it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
          a.appendChild(quando);
          a.appendChild(document.createTextNode(v.titolo));
          li.appendChild(a);
          lista.appendChild(li);
        });

        zona.hidden = false;
        const voci_li = Array.from(lista.children);
        let i = 0;
        voci_li[0].classList.add('in-onda');

        // Ruota ogni sei secondi in dissolvenza. Si ferma al passaggio e
        // al fuoco: chi legge o chi naviga da tastiera deve poter fermare.
        let timer = null;
        const gira = () => {
          voci_li[i].classList.remove('in-onda');
          i = (i + 1) % voci_li.length;
          voci_li[i].classList.add('in-onda');
        };
        const via = () => { if (!timer && voci_li.length > 1) timer = setInterval(gira, 6000); };
        const stop = () => { clearInterval(timer); timer = null; };
        zona.addEventListener('mouseenter', stop);
        zona.addEventListener('mouseleave', via);
        zona.addEventListener('focusin', stop);
        zona.addEventListener('focusout', via);
        via();
      })
      .catch(() => { /* fallback silenzioso: la riga non compare */ });
  }

  document.addEventListener('astro:page-load', casa);
  casa();
</script>
