---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImaginaHeader from '../../components/ImaginaHeader.astro';
import { content } from '../../i18n/entra-in-scena.js';
// NOTA PER PAOLO: pagina contatti minima — da rifinire (form? indirizzo
// specifico per collaborazioni vs stampa? ancora da decidere insieme).

// I testi stanno in src/i18n/entra-in-scena.js. Finché esiste solo `it` non
// c'è rotta /en/ e non c'è selettore di lingua.
const lang = 'it';
const c = content[lang];

// Pagine Imagina su bianco luminoso (cromie 10/07/2026).
const theme = {
  '--bg-void': '#faf9f6',
  '--bg-deep': '#f0eee8',
  '--bg-mid': '#e7e4db',
  '--text-soft': '#1b1a1f',
  '--text-dim': 'rgba(27, 26, 31, 0.66)',
  '--text-faint': 'rgba(27, 26, 31, 0.42)',
  '--hairline': 'rgba(27, 26, 31, 0.13)',
};
---
<BaseLayout title={c.meta.title} description={c.meta.description} lang={lang} theme={theme}>
  <ImaginaHeader slot="header" />

  <main class="container" style="padding-top: 6rem;">
    <h1>{c.titolo}</h1>
    <p><a class="trace-link" href={`mailto:${c.email}`}>{c.email}</a></p>
    <p class="pec">{c.pecEtichetta} {c.pec}</p>
    <p>{c.indirizzo}</p>
  </main>
</BaseLayout>

<style>
  /* la PEC un gradino sotto l'indirizzo ordinario: c'è, si legge, ma non
     compete con quello a cui davvero si scrive */
  .pec { color: var(--text-dim); }
</style>
