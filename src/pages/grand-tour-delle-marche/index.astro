  // ── LA MAPPA CHE RISPONDE: il tema accende i luoghi ──
  const norm = (s) => (s || '').replace(/[’ʼ]/g, "'");
  // ⚠️ circoscritto a #chips: da quando la teca ha il suo gruppo di
  // pastiglie, un querySelectorAll('.chip') su tutta la pagina
  // raccoglierebbe anche quelle delle annate e proverebbe a leggerci
  // dentro i comuni di un nucleo tematico.
  const chips = Array.from(document.querySelectorAll('#chips .chip'));
  const esempi = document.getElementById('esempi');
  const paths = Array.from(document.querySelectorAll('.mappa svg path'));
  const perComune = new Map();
  paths.forEach((p) => {
    const n = norm(p.getAttribute('data-comune'));
    if (!n) return;
    if (!perComune.has(n)) perComune.set(n, []);
    perComune.get(n).push(p);
  });

  const attesa = esempi ? esempi.textContent : '';
  function spegni() {
    paths.forEach((p) => p.classList.remove('acceso'));
  }
  function accendi(chip) {
    spegni();
    norm(chip.dataset.comuni).split('|').forEach((c) => {
      (perComune.get(c) || []).forEach((p) => p.classList.add('acceso'));
    });
    if (esempi) esempi.textContent = chip.textContent.trim() + ': ' + chip.dataset.esempi;
  }
  function scegli(chip) {
    chips.forEach((c) => {
      const on = c === chip;
      c.setAttribute('aria-checked', on ? 'true' : 'false');
      c.tabIndex = on ? 0 : -1;
