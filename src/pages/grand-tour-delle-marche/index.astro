  chips.forEach((c) => {
    c.addEventListener('mouseenter', () => accendi(c));
    c.addEventListener('focus', () => accendi(c));
    c.addEventListener('click', () => scegli(c));
    c.addEventListener('keydown', (e) => {
      const i = chips.indexOf(c);
      let n = null;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') n = (i + 1) % chips.length;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') n = (i - 1 + chips.length) % chips.length;
      else if (e.key === 'Home') n = 0;
      else if (e.key === 'End') n = chips.length - 1;
      else return;
      e.preventDefault();
      scegli(chips[n]);
      chips[n].focus();
    });
  });
  // uscendo dalla lista si torna allo stato di riposo, se non c'è una scelta
  const lista = document.getElementById('chips');
  if (lista) {
    lista.addEventListener('mouseleave', () => {
      const scelto = chips.find((c) => c.getAttribute('aria-checked') === 'true');
      if (scelto) accendi(scelto);
      else { spegni(); if (esempi) esempi.textContent = attesa; }
    });
  }

  // ── il nome del comune al passaggio, con l'anno della prima tappa ──
  const tip = document.getElementById('tip');
  const mappa = document.querySelector('.mappa');
  const eventiMap = tip ? JSON.parse(tip.dataset.eventi || '{}') : {};
  if (tip && mappa) {
    paths.forEach((p) => {
      if (!p.classList.contains('toccato')) return;
      p.addEventListener('mouseenter', () => {
        const nome = p.getAttribute('data-comune');
        // comune + evento (il più recente documentato). Dove l'evento non è
        // documentato resta il solo nome: non si deduce.
        const e = eventiMap[nome] || eventiMap[norm(nome)];
        tip.textContent = e ? `${nome} — ${e.evento}` : nome;
        tip.hidden = false;
      });
      p.addEventListener('mousemove', (e) => {
        const r = mappa.getBoundingClientRect();
        tip.style.left = e.clientX - r.left + 'px';
        tip.style.top = e.clientY - r.top + 'px';
      });
      p.addEventListener('mouseleave', () => { tip.hidden = true; });
    });
  }
</script>
