---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pellicola from '../../components/Pellicola.astro';
import mapSvg from '../../assets/gt-map-comuni.svg?raw';
import temi from '../../assets/gt-temi.json';
import tappe from '../../assets/gt-tappe.json';
import eventi from '../../assets/gt-eventi.json';
import raccontoBacino from '../../assets/gt-racconto.json';

// LANDING GRAND TOUR DELLE MARCHE — la fabula è L'ITINERARIO
// (ANIGAMI-METANARRATIVA §3): la barra dei capitoli è una strada con
// waypoint, lo scroll è strada fatta, i capitoli sono soste, la chiusura
// è ciò che resta dopo la ripartenza. Lessico odeporico, mai da brochure.
//
// ⚠️ OSSATURA NON REPLICABILE: niente deck a quadri, niente moviola,
// niente card orizzontali (sono di Tipicità), niente plancia (è di TIB).
// Qui il gesto è la STRADA: il progresso e i waypoint.
//
// TESTI: le tre soste sono state RISCRITTE — vedi TESTI-GT-CAPITOLI.md
// (07/08/2026), che annulla l'istruzione «[LAVORATO], trascrivere invariati»
// del §3–5 di TESTI-GT.md. Ora dicono il METODO e non gli esempi: niente
// nomi propri (tipologie al posto dei casi), e il filo è la tesi sul
// destination management — una destinazione non si gestisce prima di
// esistere come soggetto. Arco: metodo → forma → esito.
// Exergo, filo del racconto e chiusura da TESTI-GT.md (BOZZE validate
// nell'impianto da Paolo). Dati mappa/temi da TESTI-GT-DATI.md v2.
//
// ⚠️ CORREZIONE FATTUALE (TESTI-GT.md §1): la prima edizione è il 2014,
// non il 2015 — flyer d'archivio + conferma di Paolo.

// I comuni usano apostrofi curvi in un file e dritti nell'altro: senza
// normalizzare, tre comuni non si accenderebbero mai (Sant'Elpidio a Mare,
// Porto Sant'Elpidio, Serra Sant'Abbondio). Verificato sui dati.
const norm = (s) => s.replace(/[’ʼ]/g, "'");

const nucleiOrdine = [
  'enogastronomia', 'vino & spiriti', 'mare & pesca', 'tradizioni & comunità',
  'cultura & spettacolo', 'storia & rievocazioni', 'natura & outdoor',
  'saper fare & design', 'innovazione', 'sport',
];
const etichetta = (k) => k.charAt(0).toUpperCase() + k.slice(1);

// Righe di esempio: le tre fornite da Cowork si trascrivono tali e quali.
// Per gli altri sette nuclei NON invento il "cosa": mostro i luoghi, che
// sono dato verificato. Le righe mancanti sono segnate in SOSPESI.md.
const esempiForniti = {
  'saper fare & design': 'il cappello a Montappone, la carta a Fabriano, la pelle a Tolentino, la fisarmonica a Castelfidardo…',
  'mare & pesca': 'il brodetto a Porto Recanati, le cozze a Pedaso, la piccola pesca a San Benedetto…',
  'storia & rievocazioni': 'i Templari a Castignano, la battaglia delle Nazioni a Sassoferrato, gli scavi di Monte Rinaldo…',
};
const nuclei = nucleiOrdine.filter((k) => temi[k]).map((k) => ({
  key: k,
  label: etichetta(k),
  comuni: temi[k].map(norm),
  esempi: esempiForniti[k] || temi[k].slice(0, 5).map(norm).join(', ') + '…',
  daCompletare: !esempiForniti[k],
}));

const toccati = tappe.comuni.length;
const edizioni = Object.keys(tappe.years).length;
const primaTappa = tappe.first;

const cartoline = [
  { f: '2015-montecarotto.jpg', t: 'Verdicchio in Festa & Jazz — Montecarotto', a: '2015' },
  { f: '2015-fermo.jpg', t: 'Made in Marche Gallery — Fermo', a: '2015' },
  { f: '2015-pollenza.jpg', t: 'Antiquariato e artigianato artistico — Pollenza', a: '2015' },
  { f: '2016-sefro.jpg', t: 'La Trota e il Verdicchio — Sefro', a: '2016' },
  { f: '2016-fabriano.jpg', t: 'Fabriano Creative City', a: '2016' },
  { f: '2016-montedinove.jpg', t: 'Sibillini in Rosa — Montedinove', a: '2016' },
  { f: '2016-recanati.jpg', t: 'Recanati, città del buon vivere', a: '2016' },
  { f: '2016-senigallia.jpg', t: 'Pane Nostrum — Senigallia', a: '2016' },
  { f: '2016-venarotta.jpg', t: 'Le meraviglie del ricamo — Venarotta', a: '2016' },
  { f: '2017-acquasanta.jpg', t: "Festa d'Autunno — Acquasanta Terme", a: '2017' },
  { f: '2017-apecchio.jpg', t: 'Tartufo e Alogastronomia — Apecchio', a: '2017' },
  { f: '2017-pesaro.jpg', t: 'Candele sotto le stelle — Pesaro', a: '2017' },
  { f: '2017-piobbico.jpg', t: 'Sagra del polentone alla carbonara — Piobbico', a: '2017' },
];

// ══════════════════════════════════════════════════════════════════════
// IL COMPENDIO VISUALE DEL RACCONTO — griglia 3×3 (Paolo, 08–09/08/2026)
//
// Nove caselle quadrate, SOLO IMMAGINE: nessuna didascalia, il fotogramma
// e basta. Al clic si apre il video. È il primo dei blocchi visuali che
// ogni sezione della pagina avrà.
//
// Due caselle sono fisse e sette ruotano a ogni visita:
//   1ª  Lavinia Atipica — il filmato d'archivio già in cartella
//   2ª  Grand Tour delle Marche 2026 — TENUTA LIBERA finché Paolo non
//       carica il video: basta scriverne l'id qui sotto e si accende.
//   3ª-9ª  pescate a caso dal bacino di gt-racconto.json.
//
// IL BACINO (64 video, raccolto il 09/08 dai canali di Tipicità): sei
// playlist — Camerino Meraviglia days, Il territorio, Frasassi
// Experience, Grand Tour delle Marche 2021, Pillole di Enosophia,
// Pillole di Senigallia Città Gourmet — più dieci video singoli.
// ⚠️ Le playlist sono state lette dal feed pubblico di YouTube, che ne
// restituisce al massimo quindici per volta: delle due più lunghe
// potrebbe mancare la coda. Si rigenera quando serve.
//
// LE MINIATURE stanno in public/gt/racconto/<id>.jpg, scaricate una
// volta sola. Non si tirano da i.ytimg.com a ogni visita: sarebbe una
// chiamata a YouTube prima ancora che l'utente abbia cliccato, e su un
// sito con un gestore di consenso è esattamente ciò che la facciata
// dell'iframe serve a evitare.
const bacino = raccontoBacino;

// ⚠️ QUI si mette l'id YouTube del Grand Tour 2026, quando c'è.
const GT2026 = '';

// Sorteggio al build: senza JavaScript la griglia è comunque piena e
// completa, ed è questa la versione che leggono i motori. Lo script in
// pagina rimescola a ogni visita.
const mescola = (a) => a.map((v) => [Math.random(), v]).sort((x, y) => x[0] - y[0]).map((x) => x[1]);
const sorteggiati = mescola([...bacino]).slice(0, 7);

const raccontoVideo = [
  { id: 'lavinia', titolo: 'Lavinia Atipica', clip: '/gt/lavinia.mp4', poster: '/gt/lavinia-poster.jpg', yt: '', fissa: true },
  GT2026
    ? { id: 'gt2026', titolo: 'Grand Tour delle Marche 2026', poster: `/gt/racconto/${GT2026}.jpg`, yt: GT2026, fissa: true }
    : { id: 'gt2026', titolo: 'Grand Tour delle Marche 2026 — in arrivo', fissa: true },
  ...sorteggiati.map((v) => ({ id: v.id, titolo: v.titolo, poster: `/gt/racconto/${v.id}.jpg`, yt: v.id })),
];

// Le soste dell'itinerario: sono i waypoint della barra-strada.
//
// ⚠️ L'ETICHETTA NON È IL TITOLO (Paolo, 08/08/2026). In barra i nomi
// stanno corti — una strada si legge di sfuggita, mentre si cammina — e i
// concetti pieni restano negli <h2> delle sezioni: «Laboratorio di
// comunità», «Geometria variabile», «Cartoline dal viaggio». È la stessa
// regola dei lemmi di EVO, e risolve anche la striscia che intorno ai
// 1024px tagliava fuori l'ultima tappa.
const soste = [
  { id: 'racconto', label: 'Il racconto' },
  { id: 'laboratorio-di-comunita', label: 'La comunità' },
  { id: 'geometria-variabile', label: 'La geometria' },
  { id: 'incubatore', label: "L'incubatore" },
  { id: 'strada-fatta', label: 'La strada' },
  { id: 'cartoline', label: 'Le cartoline' },
];

// CROMIA (10/07/2026): carta calda, il colore dei borghi d'estate, con i
// corallo ufficiali (ee726c / f6ac7c) come accento. Per i testi #d1544c,
// tono scurito per leggibilità su fondo chiaro.
const theme = {
  '--bg-void': '#fbf4ec',
  '--bg-deep': '#f4e8da',
  '--bg-mid': '#eeddc9',
  '--text-soft': '#2b1d16',
  '--text-dim': 'rgba(43, 29, 22, 0.72)',
  // 0.70: sotto questa soglia il testo piccolo scende sotto il 4.5:1 AA
  // sulla carta calda (misurato a schermo, non stimato a occhio).
  '--text-faint': 'rgba(43, 29, 22, 0.70)',
  '--hairline': 'rgba(43, 29, 22, 0.16)',
};
---

<BaseLayout
  title="Grand Tour delle Marche — un itinerario tra borghi e comunità"
  description="Grand Tour delle Marche: dal 2014 un laboratorio di comunità a geometria variabile. 73 comuni, 13 edizioni, un solo viaggio tra i borghi marchigiani."
  accent="#d1544c"
  theme={theme}
>
  <Pellicola slot="header" current="grand-tour" mode="light" />

  <!-- ══ PARTENZA ══ -->
  <header class="partenza">
    <div class="partenza-in">
      <h1 class="sr-only">Grand Tour delle Marche</h1>
      <img class="marchio" src="/logos/grand-tour-color.svg" alt="Grand Tour delle Marche" width="420" height="168" />
      <p class="dati">
        <span>dal 2014</span>
        <span>13ª edizione (2026)</span>
        <span>itinerario diffuso tra borghi e comunità delle Marche</span>
      </p>
    </div>
    <div class="cue" aria-hidden="true"></div>
  </header>

  <!-- ══ LA BARRA-ITINERARIO: la strada con le sue tappe ══ -->
  <div class="strada">
    <div class="strada-in">
      <img class="strada-marchio" src="/logos/grand-tour-color.svg" alt="" width="86" height="34" />
      <nav class="waypoints" aria-label="Le soste dell'itinerario">
        <span class="tracciato" aria-hidden="true"><span class="percorso" id="percorso"></span></span>
        {soste.map((s) => (
          <a href={`#${s.id}`} data-wp={s.id}><span class="wp-punto" aria-hidden="true"></span>{s.label}</a>
        ))}
      </nav>
    </div>
  </div>

  <main>
    <!-- ══ EXERGO — la lettera del 2014 ══ -->
    <section class="exergo" aria-label="Esergo">
      <blockquote data-reveal>
        <p>«Non come una guida che ti fa fare il solito giro turistico, ma come un amico che ti porta a scoprire casa sua.»</p>
        <cite>dalla lettera di Gioacchino, 2014</cite>
      </blockquote>
    </section>

    <!-- ══ IL FILO DEL RACCONTO ══ -->
    <section class="sosta" id="racconto" aria-labelledby="h-racconto">
      <div class="wrap">
        <h2 id="h-racconto" data-reveal>Il filo del racconto</h2>
        <div class="racconto">
          <p class="lungo" data-reveal>Il Grand Tour non ha mai elencato tappe: le ha sempre affidate a qualcuno. È nato nel 2014 con una lettera — Gioacchino che scrive al nipote Francesco, emigrato e in procinto di tornare con la sua Heidi, per promettergli un viaggio autentico nelle Marche. Un itinerario nato come invito al ritorno. Sulla strada è arrivata Lavinia Atipica, viaggiatrice dissacrante, curiosa, pronta a mettersi in gioco davanti a ogni bellezza — e tornata anni dopo, come tornano i viaggiatori veri. Oggi il passo lo detta Martino: erede del Picchio leggendario che guidò i Piceni a fondare queste terre, picchio della generazione alpha, con un sano spirito d'avventura. Debutta nel 2026 come guida della community del Grand Tour delle Marche, e a dargli forma è l'illustratrice marchigiana Simona Pagano, che firma anche una serie di illustrazioni che raccontano le Marche in stile cartoon. Da una lettera a un picchio: il racconto cambia voce, la strada resta. Chi segue il Grand Tour non consulta un calendario — tiene il passo di un personaggio.</p>

          {/* IL COMPENDIO VISUALE. I bottoni sono bottoni veri: senza JS
              non aprono niente, ma le anteprime e i titoli restano in
              pagina, e il video di Lavinia resta raggiungibile dal suo
              file. L'ordine lo mescola lo script con `order`, quindi il
              DOM non si tocca e senza JS la griglia è quella scritta. */}
          <ul class="griglia" id="griglia-racconto" aria-label="Il racconto in video">
            {raccontoVideo.map((v) => (
              <li>
                {/* Nessuna didascalia in casella: il fotogramma e basta.
                    Il titolo resta come nome accessibile del bottone —
                    senza, sarebbero nove bersagli muti per chi non vede. */}
                <button
                  class:list={['cella', { vuota: !v.poster }]}
                  type="button"
                  data-yt={v.yt || undefined}
                  data-titolo={v.titolo}
                  data-fissa={v.fissa ? '1' : undefined}
                  aria-label={v.titolo}
                  disabled={!v.yt && !v.clip}
                >
                  {v.poster && (
                    <img class="cella-poster" src={v.poster} alt="" loading="lazy" width="480" height="360" />
                  )}
                  {v.clip && (
                    <video class="cella-clip" src={v.clip} muted loop playsinline preload="none" aria-hidden="true"></video>
                  )}
                </button>
              </li>
            ))}
          </ul>
          <script type="application/json" id="bacino-racconto" set:html={JSON.stringify(bacino)}></script>
        </div>
        {/* CREDITO DI MARTINO (Paolo, 08/08/2026). La riga di credito in
            coda alla sezione è stata tolta: il credito sta dentro il
            racconto, dove ci sono anche i fatti che lo reggono — Martino
            debutta nel 2026 come guida della community del Grand Tour, e
            a dargli forma è l'illustratrice marchigiana Simona Pagano,
            autrice anche della serie di illustrazioni cartoon delle
            Marche. Una firma detta in mezzo ai fatti pesa più di una
            riga in fondo che nessuno legge. */}
      </div>
    </section>

    <!-- ══ LE TRE SOSTE — testi [LAVORATO], invariati ══ -->
    <section class="sosta sosta--alt" id="laboratorio-di-comunita" aria-labelledby="h-lab">
      <div class="wrap">
        <h2 id="h-lab" data-reveal>Laboratorio di comunità</h2>
        <p data-reveal>Prima di ogni programma vengono i mesi che nessuno vede: la mappatura di chi in un territorio produce, coltiva, cucina, ospita, racconta; gli incontri uno a uno con chi ci vive tutto l'anno; il lavoro paziente di mettere allo stesso tavolo persone che nello stesso paese non si erano mai sedute insieme. Quello che arriva al pubblico è la punta. Il resto resta in dote alla comunità che ospita, e non compare in nessuna comunicazione — se non qui, perché qui parliamo del metodo e non di un'edizione.</p>
        <p data-reveal>Oggi si parla molto di destination management, e quasi sempre si comincia dal fondo: il piano, il marchio, la governance. Ma una destinazione non si gestisce prima di esistere come soggetto — prima cioè che chi la abita si riconosca in un racconto comune e accetti di starci dentro. Concertazione, ascolto e coinvolgimento non sono la premessa gentile di quel lavoro: ne sono la condizione. E un evento, in questo, è uno strumento formidabile, perché mette a disposizione ciò che manca sempre: una data, un'occasione e un oggetto concreto attorno a cui trovare un accordo. Non promuove soltanto una destinazione. La costruisce.</p>
      </div>
    </section>

    <section class="sosta" id="geometria-variabile" aria-labelledby="h-geo">
      <div class="wrap">
        <h2 id="h-geo" data-reveal>Geometria variabile</h2>
        <p data-reveal>Un borgo di poche centinaia di abitanti e una città capoluogo non hanno bisogno della stessa cosa. Così in tredici edizioni il formato ha cambiato forma ogni volta: dove non c'era niente il Grand Tour ha inventato da zero un appuntamento che prima non esisteva; dove il tema non stava in un solo paese ha costruito un'esperienza estesa a un intero areale; dove esisteva già una manifestazione radicata è entrato da ospite, senza nessuna intenzione di annettersela.</p>
        <p data-reveal>Non è lo stesso evento replicato: è lo stesso principio in forme diverse. E non è flessibilità per vocazione — è la conseguenza dell'ascolto, perché chi ascolta davvero non può standardizzare. Vale anche per il perimetro: una destinazione non coincide quasi mai con un confine amministrativo. Si tiene insieme per affinità e per vocazione — una valle, un paesaggio, una filiera — e la geometria dell'itinerario segue quella, non la carta.</p>
      </div>
    </section>

    <section class="sosta sosta--alt" id="incubatore" aria-labelledby="h-inc">
      <div class="wrap">
        <h2 id="h-inc" data-reveal>Incubatore</h2>
        <p data-reveal>Non tutto quello che nasce dentro il formato resta legato al suo calendario. Alcune cose imparano a camminare da sole: tornano ogni anno anche quando l'itinerario è altrove, con la propria organizzazione e il proprio pubblico, e a un certo punto non hanno più bisogno di noi. Sono la prova che il laboratorio ha funzionato.</p>
        <p data-reveal>Il segno non è mai quanto dura la festa. È cosa resta quando il Grand Tour è già ripartito: operatori che prima non si conoscevano e adesso si telefonano, un appuntamento che qualcun altro ha preso in mano, una comunità che si è accorta di essere una destinazione. È da qui che un territorio può incamminarsi verso una DMO — non da un organigramma, ma da un gruppo che ha già imparato a decidere insieme.</p>
      </div>
    </section>

    <!-- ══ DOVE & COSA — la mappa che risponde ══
         Il tema accende i luoghi. Niente cursore-anni: non è una moviola. -->
    <section class="sosta strada-fatta" id="strada-fatta" aria-labelledby="h-strada">
      <div class="wrap">
        <h2 id="h-strada" data-reveal>La strada fatta</h2>
        <p class="sotto" data-reveal>{toccati} comuni · {edizioni} edizioni · un solo viaggio</p>

        <div class="dovecosa" data-reveal>
          <div class="mappa">
            <svg viewBox="6 72 988 1006" role="img" aria-label={`Mappa delle Marche: ${toccati} comuni toccati dall'itinerario su 225`}>
              <Fragment set:html={mapSvg} />
            </svg>
            <div class="tip" id="tip" hidden aria-hidden="true" data-eventi={JSON.stringify(eventi)}></div>
          </div>

          <div class="nuclei">
            <span class="nuclei-label" id="lbl-nuclei">I nuclei tematici</span>
            <div class="chip-lista" role="radiogroup" aria-labelledby="lbl-nuclei" id="chips">
              {nuclei.map((n, i) => (
                <button
                  class="chip"
                  role="radio"
                  aria-checked="false"
                  tabindex={i === 0 ? '0' : '-1'}
                  data-tema={n.key}
                  data-comuni={n.comuni.join('|')}
                  data-esempi={n.esempi}
                >{n.label}</button>
              ))}
            </div>
            <p class="esempi" id="esempi" role="status" aria-live="polite">Passa su un nucleo per vedere dove è passato.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ CARTOLINE DAL VIAGGIO ══ -->
    <section class="sosta sosta--alt" id="cartoline" aria-labelledby="h-cart">
      <div class="wrap">
        <h2 id="h-cart" data-reveal>Cartoline dal viaggio</h2>
        <p class="sotto" data-reveal>Dall'archivio: le cartoline ufficiali delle prime edizioni.</p>
      </div>
      <div class="teca" data-reveal>
        <ul>
          {cartoline.map((c, i) => (
            <li style={`--rot:${(i % 3) - 1}deg`}>
              <figure>
                <img src={`/gt/cartoline/${c.f}`} alt={c.t} width="900" height="637" loading="lazy" decoding="async" />
                <figcaption><span class="timbro">{c.a}</span>{c.t}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ══ RIPARTENZA ══ -->
    <section class="ripartenza" aria-label="Chiusura">
      <p data-reveal>Il Grand Tour non finisce: riparte. La prossima sosta è già sulla mappa — e come ogni anno, qualcosa resterà anche dopo.</p>
    </section>
  </main>

  {/* IL SIPARIO DEL VIDEO. <dialog> nativo: trappola del fuoco, ESC e
      ritorno del fuoco alla casella d'origine li dà il browser. L'iframe
      NON esiste finché non si apre — facciata: nessun cookie di YouTube
      prima del clic, e la pagina non paga il player finché non serve. */}
  <dialog class="proiezione" id="proiezione" aria-label="Video">
    <button class="pr-chiudi" type="button" data-chiude aria-label="Chiudi">
      <span aria-hidden="true">&times;</span>
    </button>
    <div class="pr-in">
      <div class="pr-telaio" id="pr-telaio"></div>
      <p class="pr-titolo" id="pr-titolo"></p>
    </div>
  </dialog>
</BaseLayout>

<style is:global>
  ::selection { background: rgba(209, 84, 76, 0.24); color: #2b1d16; }

  /* La mappa è iniettata: gli stili scoped non la aggancerebbero. */
  .mappa svg path {
    fill: #efe3d4;
    stroke: #fbf4ec;
    stroke-width: 1.1;
    transition: fill 0.28s cubic-bezier(0.55, 0.05, 0.18, 1);
  }
  .mappa svg path.toccato { fill: #f6ac7c; }
  .mappa svg path.acceso { fill: #d1544c; }
  @media (prefers-reduced-motion: reduce) {
    .mappa svg path { transition: none; }
  }
</style>

<style>
  .partenza, .strada, main { --ease: cubic-bezier(0.55, 0.05, 0.18, 1); }
  .dati, .nuclei-label, .timbro, .waypoints a, .credit {
    font-family: 'Manrope', sans-serif;
  }

  /* ══ PARTENZA ══ */
  .partenza {
    position: relative;
    min-height: 82svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6rem 1.6rem 5rem;
    background:
      radial-gradient(ellipse 85% 60% at 50% 40%, rgba(246, 172, 124, 0.28), transparent 70%),
      var(--bg-void);
  }
  .marchio { width: min(74vw, 420px); height: auto; display: block; margin: 0 auto; }
  .dati {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0 0.7rem;
    margin: 2.2rem 0 0;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--text-dim);
  }
  .dati span + span::before {
    content: '·';
    margin-right: 0.7rem;
    color: var(--text-faint);
  }
  .cue {
    position: absolute;
    bottom: 1.8rem;
