---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pellicola from '../../components/Pellicola.astro';
import mapSvg from '../../assets/gt-map-comuni.svg?raw';
import temi from '../../assets/gt-temi.json';
import tappe from '../../assets/gt-tappe.json';
import eventi from '../../assets/gt-eventi.json';
import raccontoBacino from '../../assets/gt-racconto.json';
import { content } from '../../i18n/grand-tour.js';

// LANDING GRAND TOUR DELLE MARCHE — la fabula è L'ITINERARIO
// (ANIGAMI-METANARRATIVA §3): la barra dei capitoli è una strada con
// waypoint, lo scroll è strada fatta, i capitoli sono soste, la chiusura
// è ciò che resta dopo la ripartenza. Lessico odeporico, mai da brochure.
//
// ⚠️ OSSATURA NON REPLICABILE: niente deck a quadri, niente moviola,
// niente card orizzontali (sono di Tipicità), niente plancia (è di TIB).
// Qui il gesto è la STRADA: il progresso e i waypoint.
//
// TESTI: le tre soste sono state RISCRITTE — vedi TESTI-GT-CAPITOLI.md
// (07/08/2026), che annulla l'istruzione «[LAVORATO], trascrivere invariati»
// del §3–5 di TESTI-GT.md. Ora dicono il METODO e non gli esempi: niente
// nomi propri (tipologie al posto dei casi), e il filo è la tesi sul
// destination management — una destinazione non si gestisce prima di
// esistere come soggetto. Arco: metodo → forma → esito.
// Exergo, filo del racconto e chiusura da TESTI-GT.md (BOZZE validate
// nell'impianto da Paolo). Dati mappa/temi da TESTI-GT-DATI.md v2.
//
// ⚠️ CORREZIONE FATTUALE (TESTI-GT.md §1): la prima edizione è il 2014,
// non il 2015 — flyer d'archivio + conferma di Paolo.

// I comuni usano apostrofi curvi in un file e dritti nell'altro: senza
// normalizzare, tre comuni non si accenderebbero mai (Sant'Elpidio a Mare,
// Porto Sant'Elpidio, Serra Sant'Abbondio). Verificato sui dati.
const norm = (s) => s.replace(/[’ʼ]/g, "'");

// I TESTI stanno in src/i18n/grand-tour.js, nella stessa forma di
// tipicita.js. Finche' esiste solo `it` non c'e' rotta inglese e non
// c'e' selettore di lingua.
const lang = 'it';
const c = content[lang];

// Le etichette e le righe di esempio dei nuclei stanno in i18n: nel JSON
// restano soltanto le chiavi, che da qui in avanti sono identificatori.
const nuclei = c.temi.ordine.filter((k) => temi[k]).map((k) => ({
  key: k,
  label: c.temi.etichette[k],
  comuni: temi[k].map(norm),
  esempi: c.temi.esempi[k] || temi[k].slice(0, 5).map(norm).join(', ') + '…',
  daCompletare: !c.temi.esempi[k],
}));

const toccati = tappe.comuni.length;
const edizioni = Object.keys(tappe.years).length;
const primaTappa = tappe.first;

const cartoline = c.cartoline.voci;

// LE ANNATE DELLE CARTOLINE. Si ricavano dall'elenco e si ordinano dalla
// più recente: la prima è quella che la teca mostra all'apertura. Nessun
// anno scritto a mano — quando entra una locandina di un'edizione più
// recente, il valore predefinito si sposta da solo.
const annate = [...new Set(cartoline.map((k) => k.a))].sort().reverse();
const annataIniziale = annate[0];

// ══════════════════════════════════════════════════════════════════════
// IL COMPENDIO VISUALE DEL RACCONTO — griglia 3×3 (Paolo, 08–09/08/2026)
//
// Nove caselle quadrate, SOLO IMMAGINE: nessuna didascalia, il fotogramma
// e basta. Al clic si apre il video. È il primo dei blocchi visuali che
// ogni sezione della pagina avrà.
//
// Due caselle sono fisse e sette ruotano a ogni visita:
//   1ª  Lavinia Atipica — il filmato d'archivio già in cartella
//   2ª  Grand Tour delle Marche 2026 — TENUTA LIBERA finché Paolo non
//       carica il video: basta scriverne l'id qui sotto e si accende.
//   3ª-9ª  pescate a caso dal bacino di gt-racconto.json.
//
// IL BACINO (64 video, raccolto il 09/08 dai canali di Tipicità): sei
// playlist — Camerino Meraviglia days, Il territorio, Frasassi
// Experience, Grand Tour delle Marche 2021, Pillole di Enosophia,
// Pillole di Senigallia Città Gourmet — più dieci video singoli.
// ⚠️ Le playlist sono state lette dal feed pubblico di YouTube, che ne
// restituisce al massimo quindici per volta: delle due più lunghe
// potrebbe mancare la coda. Si rigenera quando serve.
//
// LE MINIATURE stanno in public/gt/racconto/<id>.jpg, scaricate una
// volta sola. Non si tirano da i.ytimg.com a ogni visita: sarebbe una
// chiamata a YouTube prima ancora che l'utente abbia cliccato, e su un
// sito con un gestore di consenso è esattamente ciò che la facciata
// dell'iframe serve a evitare.
const bacino = raccontoBacino;

// Id YouTube del Grand Tour 2026 (Paolo, 19/08). La miniatura è già in
// public/gt/racconto/: non si tira da i.ytimg.com a ogni visita.
const GT2026 = '1QqzlfCNBdw';

// Sorteggio al build: senza JavaScript la griglia è comunque piena e
// completa, ed è questa la versione che leggono i motori. Lo script in
// pagina rimescola a ogni visita.
const mescola = (a) => a.map((v) => [Math.random(), v]).sort((x, y) => x[0] - y[0]).map((x) => x[1]);
const sorteggiati = mescola([...bacino]).slice(0, 7);

// IL RACCONTO — testo di Paolo (19/08/2026), sostituisce la versione
// precedente. Trascritto fedelmente: corretti solo tre refusi meccanici
// (una maiuscola a inizio inciso, "grand tour" minuscolo dove altrove è
// marchio, una doppia spaziatura). Le altre osservazioni sono a report,
// non applicate: il testo è suo.
const raccontoTesto = c.racconto.par;

const raccontoVideo = [
  { id: 'lavinia', titolo: c.racconto.lavinia, clip: '/gt/lavinia.mp4', poster: '/gt/lavinia-poster.jpg', yt: '', fissa: true },
  GT2026
    ? { id: 'gt2026', titolo: c.racconto.gt2026, poster: `/gt/racconto/${GT2026}.jpg`, yt: GT2026, fissa: true }
    : { id: 'gt2026', titolo: c.racconto.gt2026Attesa, fissa: true },
  ...sorteggiati.map((v) => ({ id: v.id, titolo: v.titolo, poster: `/gt/racconto/${v.id}.jpg`, yt: v.id })),
];

// Le soste dell'itinerario: sono i waypoint della barra-strada.
//
// ⚠️ L'ETICHETTA NON È IL TITOLO (Paolo, 08/08/2026). In barra i nomi
// stanno corti — una strada si legge di sfuggita, mentre si cammina — e i
// concetti pieni restano negli <h2> delle sezioni: «Laboratorio di
// comunità», «Geometria variabile», «Cartoline dal viaggio». È la stessa
// regola dei lemmi di EVO, e risolve anche la striscia che intorno ai
// 1024px tagliava fuori l'ultima tappa.
const soste = c.strada.soste;

// CROMIA (10/07/2026): carta calda, il colore dei borghi d'estate, con i
// corallo ufficiali (ee726c / f6ac7c) come accento. Per i testi #d1544c,
// tono scurito per leggibilità su fondo chiaro.
const theme = {
  '--bg-void': '#fbf4ec',
  '--bg-deep': '#f4e8da',
  '--bg-mid': '#eeddc9',
  '--text-soft': '#2b1d16',
  '--text-dim': 'rgba(43, 29, 22, 0.72)',
  // 0.70: sotto questa soglia il testo piccolo scende sotto il 4.5:1 AA
  // sulla carta calda (misurato a schermo, non stimato a occhio).
  '--text-faint': 'rgba(43, 29, 22, 0.70)',
  '--hairline': 'rgba(43, 29, 22, 0.16)',
};
---

<BaseLayout
  title={c.meta.title}
  description={c.meta.description}
  lang={lang}
  accent="#d1544c"
  theme={theme}
>
  <Pellicola slot="header" current="grand-tour" mode="light" />

  <!-- ══ PARTENZA ══ -->
  <header class="partenza">
    <div class="partenza-in">
      <h1 class="sr-only">{c.partenza.titolo}</h1>
      <img class="marchio" src="/logos/grand-tour-color.svg" alt={c.partenza.marchioAlt} width="420" height="168" />
      <p class="dati">
        {c.partenza.dati.map((d) => <span>{d}</span>)}
      </p>
    </div>
    <div class="cue" aria-hidden="true"></div>
  </header>

  <!-- ══ LA BARRA-ITINERARIO: la strada con le sue tappe ══ -->
  <div class="strada">
    <div class="strada-in">
      <img class="strada-marchio" src="/logos/grand-tour-color.svg" alt="" width="86" height="34" />
      <nav class="waypoints" aria-label={c.strada.aria}>
        <span class="tracciato" aria-hidden="true"><span class="percorso" id="percorso"></span></span>
        {soste.map((s) => (
          <a href={`#${s.id}`} data-wp={s.id}><span class="wp-punto" aria-hidden="true"></span>{s.label}</a>
        ))}
      </nav>
    </div>
  </div>

  <main>
    {/* ══ L'APERTURA: il visual 2026 ══
        Sta qui, subito sotto il blocco del titolo e prima della lettera,
        e fa il mestiere di un'inquadratura d'apertura: fissa l'orizzonte
        prima che cominci il racconto.

        NON è dietro al marchio. Il logotipo è corallo corsivo su crema e lì
        sopra avrebbe bisogno di un velo, e un velo su una gradazione
        costruita così è sprecarla; in più il soggetto sta in basso al
        centro e tutto il cielo è libero — proprio dove finirebbe il testo.

        DUE TAGLI. L'originale è 2:1 e a quella proporzione va servito da
        tablet in su: la quinta scura degli alberi ai lati è composizione,
        non cornice. Su telefono 2:1 vuol dire 187px d'altezza e il
        viandante diventa un puntino, quindi sotto i 700px arriva un 3:2
        stretto attorno alla figura. L'`aspect-ratio` cambia con lui,
        altrimenti il ritaglio verticale sposterebbe la pagina al
        caricamento.

        È l'immagine più grande della pagina e la prima: `fetchpriority`
        alto e nessun `loading="lazy"`, che su un LCP sarebbe un danno. */}
    <figure class="apertura">
      <picture>
        <source
          type="image/avif"
          media="(max-width: 700px)"
          srcset="/gt/2026/apertura-stretta-560.avif 560w, /gt/2026/apertura-stretta-840.avif 840w, /gt/2026/apertura-stretta-1120.avif 1120w"
          sizes="100vw"
        />
        <source
          type="image/webp"
          media="(max-width: 700px)"
          srcset="/gt/2026/apertura-stretta-560.webp 560w, /gt/2026/apertura-stretta-840.webp 840w, /gt/2026/apertura-stretta-1120.webp 1120w"
          sizes="100vw"
        />
        <source
          type="image/avif"
          srcset="/gt/2026/apertura-1200.avif 1200w, /gt/2026/apertura-1800.avif 1800w, /gt/2026/apertura-2400.avif 2400w"
          sizes="100vw"
        />
        <img
          src="/gt/2026/apertura-1800.webp"
          srcset="/gt/2026/apertura-1200.webp 1200w, /gt/2026/apertura-1800.webp 1800w, /gt/2026/apertura-2400.webp 2400w"
          sizes="100vw"
          alt={c.apertura.alt}
          width="2400"
          height="1200"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </figure>

    <!-- ══ EXERGO — la lettera del 2014 ══ -->
    <section class="exergo" aria-label={c.exergo.aria}>
      <blockquote data-reveal>
        <p>{c.exergo.cit}</p>
        <cite>{c.exergo.fonte}</cite>
      </blockquote>
    </section>

    <!-- ══ IL FILO DEL RACCONTO ══ -->
    <section class="sosta" id="racconto" aria-labelledby="h-racconto">
      <div class="wrap">
        <h2 id="h-racconto" data-reveal>{c.racconto.h2}</h2>
        <div class="racconto">
          {raccontoTesto.map((t) => <p class="lungo" data-reveal>{t}</p>)}

          {/* IL COMPENDIO VISUALE. I bottoni sono bottoni veri: senza JS
              non aprono niente, ma le anteprime e i titoli restano in
              pagina, e il video di Lavinia resta raggiungibile dal suo
              file. L'ordine lo mescola lo script con `order`, quindi il
              DOM non si tocca e senza JS la griglia è quella scritta. */}
          <ul class="griglia" id="griglia-racconto" aria-label={c.racconto.grigliaAria}>
            {raccontoVideo.map((v) => (
              <li>
                {/* Nessuna didascalia in casella: il fotogramma e basta.
                    Il titolo resta come nome accessibile del bottone —
                    senza, sarebbero nove bersagli muti per chi non vede. */}
                <button
                  class:list={['cella', { vuota: !v.poster }]}
                  type="button"
                  data-yt={v.yt || undefined}
                  data-titolo={v.titolo}
                  data-fissa={v.fissa ? '1' : undefined}
                  aria-label={v.titolo}
                  disabled={!v.yt && !v.clip}
                >
                  {v.poster && (
                    <img class="cella-poster" src={v.poster} alt="" loading="lazy" width="480" height="360" />
                  )}
                  {v.clip && (
                    <video class="cella-clip" src={v.clip} muted loop playsinline preload="none" aria-hidden="true"></video>
                  )}
                </button>
              </li>
            ))}
          </ul>
          <script type="application/json" id="bacino-racconto" set:html={JSON.stringify(bacino)}></script>
        </div>
        {/* CREDITO DI MARTINO (Paolo, 08/08/2026). La riga di credito in
            coda alla sezione è stata tolta: il credito sta dentro il
            racconto, dove ci sono anche i fatti che lo reggono — Martino
            debutta nel 2026 come guida della community del Grand Tour, e
            a dargli forma è l'illustratrice marchigiana Simona Pagano,
            autrice anche della serie di illustrazioni cartoon delle
            Marche. Una firma detta in mezzo ai fatti pesa più di una
            riga in fondo che nessuno legge. */}
      </div>
    </section>

    <!-- ══ LE TRE SOSTE — testi [LAVORATO], invariati ══ -->
    <section class="sosta sosta--alt" id="laboratorio-di-comunita" aria-labelledby="h-lab">
      <div class="wrap">
        <h2 id="h-lab" data-reveal>{c.laboratorio.h2}</h2>
        <div class="lab">
          <div class="lab-testo">
            {c.laboratorio.par.map((t) => <p data-reveal set:html={t} />)}
          </div>

          {/* L'ICEBERG. Non un'illustrazione decorativa: è la figura che il
              testo usa già — la punta che si vede e la massa che la regge.
              Disegno tecnico, non disegnino: linea di galleggiamento, la
              parte emersa piccola e nominata, quella sommersa che porta i
              pesi veri. SVG in linea, nessun file, nessuna libreria.
              Per chi non vede è un'immagine sola con la sua descrizione:
              le etichette interne sono già nel testo qui accanto, quindi
              ripeterle a voce sarebbe rumore. */}
          <figure class="iceberg" data-reveal>
            <svg viewBox="0 0 460 400" role="img"
                 aria-label={c.laboratorio.iceberg.aria}>
              <defs>
                {/* l'acqua sfuma verso il fondo: un rettangolo pieno mostrava
                    i propri bordi e sembrava una scatola incollata sopra */}
                <linearGradient id="ib-onda" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#2b1d16" stop-opacity="0.07" />
                  <stop offset="1" stop-color="#2b1d16" stop-opacity="0" />
                </linearGradient>
                {/* l'SVG ritaglia al proprio riquadro: allargare il rettangolo
                    non basta, i bordi restano sul taglio. Una maschera lo
                    dissolve anche ai lati, così l'acqua non ha più contorni. */}
                <linearGradient id="ib-lati" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" stop-color="#000" />
                  <stop offset="0.2" stop-color="#fff" />
                  <stop offset="0.8" stop-color="#fff" />
                  <stop offset="1" stop-color="#000" />
                </linearGradient>
                <mask id="ib-sfuma">
                  <rect x="0" y="0" width="460" height="400" fill="url(#ib-lati)" />
                </mask>
              </defs>

              <g mask="url(#ib-sfuma)">
                <rect class="ib-acqua-banda" x="0" y="132" width="460" height="268" />
                <line class="ib-acqua" x1="0" y1="132" x2="460" y2="132" />
              </g>

              {/* LA PUNTA — due facce: la proporzione è il messaggio, quindi
                  resta piccola davvero (un settimo dell'altezza totale) */}
              <path class="ib-su-a" d="M158 44 L150 132 L100 132 Z" />
              <path class="ib-su-b" d="M158 44 L206 132 L150 132 Z" />

              {/* LA MASSA — tre facce lungo due creste. Stessa tinta della
                  punta, smorzata: è lo STESSO blocco visto sott'acqua, non un
                  sasso grigio accanto a una punta rossa. */}
              <path class="ib-giu-a" d="M100 132 L152 132 L128 252 L104 344 L52 296 L44 200 Z" />
              <path class="ib-giu-b" d="M152 132 L206 132 L190 244 L176 378 L104 344 L128 252 Z" />
              <path class="ib-giu-c" d="M206 132 L268 206 L248 296 L176 378 L190 244 Z" />
              <path class="ib-bordo" d="M100 132 L206 132 L268 206 L248 296 L176 378 L104 344 L52 296 L44 200 Z" />

              {/* le etichette stanno FUORI, con linee di richiamo: è così che
                  si annota un disegno, e il segno resta pulito */}
              <g class="ib-guide">
                <path d="M186 92 H300" /><circle cx="186" cy="92" r="2.5" />
                <path d="M250 186 H300" /><circle cx="250" cy="186" r="2.5" />
                <path d="M258 232 H300" /><circle cx="258" cy="232" r="2.5" />
                <path d="M248 280 H300" /><circle cx="248" cy="280" r="2.5" />
                <path d="M216 328 H300" /><circle cx="216" cy="328" r="2.5" />
              </g>
              <text class="ib-et ib-et--su" x="308" y="97">{c.laboratorio.iceberg.etichette[0]}</text>
              <text class="ib-et" x="308" y="191">{c.laboratorio.iceberg.etichette[1]}</text>
              <text class="ib-et" x="308" y="237">{c.laboratorio.iceberg.etichette[2]}</text>
              <text class="ib-et" x="308" y="285">{c.laboratorio.iceberg.etichette[3]}</text>
              <text class="ib-et" x="308" y="333">{c.laboratorio.iceberg.etichette[4]}</text>
            </svg>
            <figcaption>{c.laboratorio.iceberg.did}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="sosta" id="geometria-variabile" aria-labelledby="h-geo">
      <div class="wrap">
        <h2 id="h-geo" data-reveal>{c.geometria.h2}</h2>
        {c.geometria.par.map((t) => <p data-reveal set:html={t} />)}
      </div>
    </section>

    <section class="sosta sosta--alt" id="incubatore" aria-labelledby="h-inc">
      <div class="wrap">
        <h2 id="h-inc" data-reveal>{c.incubatore.h2}</h2>
        {c.incubatore.par.map((t) => <p data-reveal set:html={t} />)}
      </div>
    </section>

    {/* ══ L'EDIZIONE IN CORSO ══
         Sta PRIMA della mappa, e l'ordine è il ragionamento: qui c'è il
         presente — le tappe del 2026, con la loro data — e la mappa che
         segue diventa la memoria di ciò che si è appena percorso. Sono due
         tempi verbali e non vanno sovrapposti.

         LA STRISCIA È UNA STRADA, NON UNO SCAFFALE. Dietro gli oggetti
         corre un filo continuo con un nodo per tappa: è lo stesso gesto
         della barra-itinerario in cima alla pagina, sceso di scala. La teca
         delle cartoline, che pure scorre, resta invece un archivio — foglie
         sparse, niente filo. Due strisce che si somigliano direbbero la
         stessa cosa due volte.

         Nessun JavaScript serve a leggerla: è una lista che scorre, con
         scroll-snap. Lo script aggiunge solo l'apertura della scena grande
         nel <dialog> che la pagina ha già per i video. */}
    <section class="sosta edizione" id="edizione" aria-labelledby="h-ediz">
      <div class="wrap">
        <h2 id="h-ediz" data-reveal>{c.edizione.h2}</h2>
        <p class="sotto" data-reveal>{c.edizione.sotto}</p>
        {/* qui le frecce vanno da sole in fondo alla gabbia: non c'è una
            riga di pastiglie a cui agganciarsi come nella teca */}
        <div class="scorri scorri--sola" data-scorre="tappe-lista" hidden>
          <button class="scorri-b" type="button" data-verso="-1" aria-label={c.scorri.indietro}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4 7 12l8 8" /></svg>
          </button>
          <button class="scorri-b" type="button" data-verso="1" aria-label={c.scorri.avanti}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8" /></svg>
          </button>
        </div>
      </div>

      <div class="itinerario" data-reveal>
        <ol class="tappe" id="tappe-lista" aria-label={c.edizione.aria}>
          {c.edizione.voci.map((t) => (
            <li class="tappa">
              <article>
                {/* il nodo sul filo: l'oggetto magico del comune. È un
                    segno, non un'informazione — il nome del comune sta
                    scritto qui sotto, quindi per chi non vede è muto. */}
                <span class="t-nodo" aria-hidden="true">
                  <img src={`/gt/2026/oggetti/${t.slug}.avif`} alt="" width="64" height="64" loading="lazy" decoding="async" />
                </span>

                <button
                  class="t-scena"
                  type="button"
                  data-scena={`/gt/2026/tappe/${t.slug}-1600.avif`}
                  data-titolo={`${t.evento} — ${t.comune}`}
                >
                  <picture>
                    <source type="image/avif" srcset={`/gt/2026/tappe/${t.slug}-800.avif 800w, /gt/2026/tappe/${t.slug}-1600.avif 1600w`} sizes="(max-width: 700px) 86vw, 30rem" />
                    <img
                      src={`/gt/2026/tappe/${t.slug}-800.webp`}
                      srcset={`/gt/2026/tappe/${t.slug}-800.webp 800w, /gt/2026/tappe/${t.slug}-1600.webp 1600w`}
                      sizes="(max-width: 700px) 86vw, 30rem"
                      alt={t.alt}
                      width="1200"
                      height="800"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </button>

                <p class="t-quando">{t.quando}</p>
                <h3 class="t-evento">{t.evento}</h3>
                <p class="t-comune">{t.comune}</p>
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ══ DOVE & COSA — la mappa che risponde ══
         Il tema accende i luoghi. Niente cursore-anni: non è una moviola. -->
    <section class="sosta strada-fatta" id="strada-fatta" aria-labelledby="h-strada">
      <div class="wrap">
        <h2 id="h-strada" data-reveal>{c.strada_fatta.h2}</h2>
        <p class="sotto" data-reveal>{c.strada_fatta.sotto.replace('%c', toccati).replace('%e', edizioni)}</p>

        <div class="dovecosa" data-reveal>
          <div class="mappa">
            <svg viewBox="6 72 988 1006" role="img" aria-label={c.strada_fatta.mappaAria.replace('%c', toccati)}>
              <Fragment set:html={mapSvg} />
            </svg>
            <div class="tip" id="tip" hidden aria-hidden="true" data-eventi={JSON.stringify(eventi)}></div>
          </div>

          <div class="nuclei">
            <span class="nuclei-label" id="lbl-nuclei">{c.strada_fatta.nucleiLabel}</span>
            <div class="chip-lista" role="radiogroup" aria-labelledby="lbl-nuclei" id="chips">
              {nuclei.map((n, i) => (
                <button
                  class="chip"
                  role="radio"
                  aria-checked="false"
                  tabindex={i === 0 ? '0' : '-1'}
                  data-tema={n.key}
                  data-comuni={n.comuni.join('|')}
                  data-esempi={n.esempi}
                >{n.label}</button>
              ))}
            </div>
            <p class="esempi" id="esempi" role="status" aria-live="polite">{c.strada_fatta.attesa}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ CARTOLINE DAL VIAGGIO ══ -->
    <section class="sosta sosta--alt" id="cartoline" aria-labelledby="h-cart">
      <div class="wrap">
        <h2 id="h-cart" data-reveal>{c.cartoline.h2}</h2>
        <p class="sotto" data-reveal>{c.cartoline.sotto}</p>

        {/* IL SELETTORE DELLE ANNATE. Stesso gruppo di pastiglie dei nuclei
             tematici — è il linguaggio che questa pagina ha già, e due
             selettori diversi nella stessa pagina sarebbero due cose da
             imparare invece di una. Le annate scendono dalla più recente,
             così la prima pastiglia è anche quella accesa. */}
        <div class="annate" data-reveal>
          <span class="nuclei-label" id="lbl-annate">{c.cartoline.annate.label}</span>
          {/* le frecce in coda alla riga delle pastiglie: stanno dove si
              sceglie l'annata, appena sopra quello che muovono */}
          <div class="annate-riga">
            <div class="chip-lista" role="radiogroup" aria-labelledby="lbl-annate" id="annate">
              {annate.map((a, i) => (
                <button
                  class="chip"
                  role="radio"
                  aria-checked={a === annataIniziale ? 'true' : 'false'}
                  tabindex={i === 0 ? '0' : '-1'}
                  data-annata={a}
                >{a}</button>
              ))}
              <button class="chip" role="radio" aria-checked="false" tabindex="-1" data-annata="*">
                {c.cartoline.annate.tutte}
              </button>
            </div>
            <div class="scorri" data-scorre="teca-lista" hidden>
              <button class="scorri-b" type="button" data-verso="-1" aria-label={c.scorri.indietro}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4 7 12l8 8" /></svg>
              </button>
              <button class="scorri-b" type="button" data-verso="1" aria-label={c.scorri.avanti}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4l8 8-8 8" /></svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      {/* Le cartoline ci sono TUTTE nel markup, di ogni annata: è la
          versione che leggono i motori e quella che resta a chi ha il
          JavaScript spento. Il filtro lo mette lo script qui sotto, prima
          del primo paint.

          La lista prende il fuoco (tabindex="0"): dentro non c'è niente di
          focalizzabile — sono figure, non link — quindi senza questo da
          tastiera la teca non si scorre affatto. Col fuoco addosso le
          frecce della tastiera la muovono da sole, senza JavaScript. */}
      <div class="teca" data-reveal>
        <ul id="teca-lista" tabindex="0" role="group" aria-label={c.cartoline.h2}>
          {cartoline.map((k, i) => (
            <li style={`--rot:${(i % 3) - 1}deg`} data-annata={k.a}>
              <figure>
                <img src={`/gt/cartoline/${k.f}`} alt={k.t} width="900" height="637" loading="lazy" decoding="async" />
                <figcaption><span class="timbro">{k.a}</span>{k.t}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>

      <script is:inline define:vars={{ annataIniziale }}>
        // Filtra PRIMA del primo paint, come il vocabolario di EVO: senza
        // questo la teca comparirebbe con tutte le annate e si
        // accorcerebbe subito dopo, con il salto di layout che ne segue.
        // Va in coda al markup e non nello script in fondo alla pagina,
        // che gira troppo tardi.
        // Se non gira affatto restano visibili tutte: è il ripiego voluto.
        (function () {
          var lista = document.getElementById('teca-lista');
          if (!lista) return;
          var voci = lista.querySelectorAll('li');
          for (var i = 0; i < voci.length; i++) {
            voci[i].hidden = voci[i].dataset.annata !== annataIniziale;
          }
        })();
      </script>
    </section>

    <!-- ══ RIPARTENZA ══ -->
    <section class="ripartenza" aria-label={c.ripartenza.aria}>
      <p data-reveal>{c.ripartenza.par}</p>
    </section>
  </main>

  {/* IL SIPARIO DEL VIDEO. <dialog> nativo: trappola del fuoco, ESC e
      ritorno del fuoco alla casella d'origine li dà il browser. L'iframe
      NON esiste finché non si apre — facciata: nessun cookie di YouTube
      prima del clic, e la pagina non paga il player finché non serve. */}
  <dialog class="proiezione" id="proiezione" aria-label={c.proiezione.etichetta}>
    <button class="pr-chiudi" type="button" data-chiude aria-label={c.proiezione.chiudi}>
      <span aria-hidden="true">&times;</span>
    </button>
    <div class="pr-in">
      <div class="pr-telaio" id="pr-telaio"></div>
      <p class="pr-titolo" id="pr-titolo"></p>
    </div>
  </dialog>
</BaseLayout>

<style is:global>
  ::selection { background: rgba(209, 84, 76, 0.24); color: #2b1d16; }

  /* La mappa è iniettata: gli stili scoped non la aggancerebbero. */
  .mappa svg path {
    fill: #efe3d4;
    stroke: #fbf4ec;
    stroke-width: 1.1;
    transition: fill 0.28s cubic-bezier(0.55, 0.05, 0.18, 1);
  }
  .mappa svg path.toccato { fill: #f6ac7c; }
  .mappa svg path.acceso { fill: #d1544c; }
  @media (prefers-reduced-motion: reduce) {
    .mappa svg path { transition: none; }
  }
</style>

<style>
  .partenza, .strada, main { --ease: cubic-bezier(0.55, 0.05, 0.18, 1); }
  .dati, .nuclei-label, .timbro, .waypoints a, .credit {
    font-family: 'Manrope', sans-serif;
  }

  /* ══ PARTENZA ══ */
  .partenza {
    position: relative;
    min-height: 82svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6rem 1.6rem 5rem;
    background:
      radial-gradient(ellipse 85% 60% at 50% 40%, rgba(246, 172, 124, 0.28), transparent 70%),
      var(--bg-void);
  }
  .marchio { width: min(74vw, 420px); height: auto; display: block; margin: 0 auto; }
  .dati {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0 0.7rem;
    margin: 2.2rem 0 0;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--text-dim);
  }
  .dati span + span::before {
    content: '·';
    margin-right: 0.7rem;
    color: var(--text-faint);
  }
  .cue {
    position: absolute;
    bottom: 1.8rem;
    left: 50%;
    width: 1px;
    height: 52px;
    background: linear-gradient(var(--brand-accent), transparent);
    animation: cue 2.4s ease-in-out infinite;
  }
  @keyframes cue {
    0% { transform: scaleY(0); transform-origin: top; }
    45% { transform: scaleY(1); transform-origin: top; }
    55% { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }
  @media (prefers-reduced-motion: reduce) { .cue { animation: none; opacity: 0.5; } }

  /* ══ L'APERTURA: la fascia del visual 2026 ══ */
  .apertura { margin: 0; }
  .apertura img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    /* su uno schermo largo 2:1 sarebbe più alto di una schermata intera e
       la lettera che segue non si affaccerebbe mai: la fascia si ferma
       prima e ritaglia dall'alto e dal basso, dove ci sono cielo e
       promontorio e non c'è nessuno */
    max-height: min(72svh, 780px);
    /* il fondo tiene il posto mentre carica, nel tono medio dell'immagine */
    background: var(--bg-mid);
  }
  @media (max-width: 700px) {
    .apertura img { aspect-ratio: 3 / 2; }
  }

  /* ══ LA STRADA: barra-itinerario con waypoint ══ */
  .strada {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--bg-void) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .strada-in {
    max-width: 70rem;
    margin: 0 auto;
    padding: 0.6rem 1.6rem;
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }
  /* La strada occupa tutta la larghezza: le si chiede di liberare
     l'angolo dove sta fissa la pellicola (BRIEF-MENU §6). I waypoint
     scorrono e non arrivano al bordo. */
  @media (min-width: 760px) {
    .strada-in { padding-right: 265px; }
  }
  .strada-marchio { height: 30px; width: auto; flex: none; }
  .waypoints {
    position: relative;
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 0.5rem 0 0.35rem;
    flex: 1;
    /* senza questo un figlio flex non scende sotto la larghezza del proprio
       contenuto: la strada sfonderebbe la pagina invece di scorrere */
    min-width: 0;
  }
  .waypoints::-webkit-scrollbar { display: none; }
  /* il tracciato: la strada; il percorso: quanta se n'è fatta */
  .tracciato {
    position: absolute;
    left: 0;
    right: 0;
    top: 0.95rem;
    height: 1px;
    background: var(--hairline);
  }
  .percorso {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--brand-accent);
    transition: width 0.2s linear;
  }
  .waypoints a {
    position: relative;
    flex: 0 0 auto;
    padding-top: 0.9rem;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--text-faint);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s var(--ease);
  }
  .wp-punto {
    position: absolute;
    top: 0.3rem;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--bg-void);
    border: 1px solid var(--text-faint);
    transition: background 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .waypoints a:hover { color: var(--text-soft); }
  .waypoints a:active { color: var(--brand-accent); }
  .waypoints a.passato .wp-punto { background: var(--brand-accent); border-color: var(--brand-accent); }
  .waypoints a[aria-current='true'] { color: var(--brand-accent); }
  .waypoints a[aria-current='true'] .wp-punto {
    background: var(--brand-accent);
    border-color: var(--brand-accent);
    box-shadow: 0 0 0 3px rgba(209, 84, 76, 0.2);
  }

  /* ══ ESERGO ══ */
  .exergo {
    padding: clamp(3.5rem, 10vh, 6.5rem) 1.6rem;
    background: var(--bg-void);
  }
  .exergo blockquote { max-width: 44rem; margin: 0 auto; text-align: center; }
  .exergo p {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    line-height: 1.3;
    color: var(--text-soft);
    margin: 0 0 1.2rem;
    text-wrap: balance;
  }
  .exergo cite {
    font-family: 'Manrope', sans-serif;
    font-style: normal;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* ══ SOSTE ══ */
  .sosta { padding: clamp(3rem, 8vh, 5rem) 0; }
  .sosta--alt { background: var(--bg-deep); }
  .wrap { max-width: 70rem; margin: 0 auto; padding: 0 1.6rem; }
  h2 { font-size: clamp(1.7rem, 3.6vw, 2.3rem); color: var(--brand-accent); margin: 0 0 1.2rem; }
  .sosta p {
    /* 54ch: con Inter l'unità ch è stretta e 64ch rendeva righe da 85-86
       caratteri (misurato a 1440). A 54ch la riga più lunga sta sui 73. */
    max-width: 54ch;
    line-height: 1.78;
    color: var(--text-dim);
    text-wrap: pretty;
  }
  .sotto {
    font-family: 'Manrope', sans-serif;
    font-size: 0.88rem;
    color: var(--text-faint);
    margin: -0.6rem 0 1.8rem;
  }

  /* ── laboratorio di comunità: il testo e l'iceberg ── */
  .lab { display: grid; grid-template-columns: 1.35fr 1fr; gap: 2.6rem; align-items: center; }
  .lab-testo p:last-child { margin-bottom: 0; }
  .iceberg { margin: 0; }
  .iceberg svg { width: 100%; height: auto; display: block; }
  /* la linea d'acqua è il perno del disegno: tratteggiata, non piena,
     perché è un livello di riferimento e non un bordo */
  .ib-acqua { stroke: var(--brand-accent); stroke-width: 1.5; stroke-dasharray: 6 6; opacity: 0.8; }
  .ib-acqua-banda { fill: url(#ib-onda); }
  /* Il volume lo fa lo scarto di tono, non un'ombreggiatura: resta un
     disegno, non un'illustrazione. E la massa è nella TINTA DELLA PUNTA,
     solo smorzata — così si legge come un unico blocco visto sott'acqua
     invece che come un sasso grigio accanto a una punta rossa. */
  .ib-su-a { fill: #a83b34; }
  .ib-su-b { fill: var(--brand-accent); }
  .ib-giu-a { fill: rgba(168, 59, 52, 0.30); }
  .ib-giu-b { fill: rgba(168, 59, 52, 0.19); }
  .ib-giu-c { fill: rgba(168, 59, 52, 0.11); }
  .ib-bordo { fill: none; stroke: rgba(168, 59, 52, 0.42); stroke-width: 1.2; stroke-linejoin: round; }
  .ib-guide path { stroke: rgba(43, 29, 22, 0.28); stroke-width: 1; }
  .ib-guide circle { fill: rgba(168, 59, 52, 0.6); }
  .ib-et {
    font-family: 'Manrope', sans-serif; font-size: 17px; letter-spacing: 0.1em;
    text-transform: uppercase; fill: var(--text-dim);
  }
  /* la voce emersa è l'unica in accento: è il punto del disegno */
  .ib-et--su { fill: #a83b34; font-weight: 500; letter-spacing: 0.12em; }
  .iceberg figcaption {
    margin-top: 0.9rem; font-family: 'Manrope', sans-serif; font-size: 0.78rem;
    letter-spacing: 0.04em; color: var(--text-dim); text-align: center;
  }
  @media (max-width: 820px) {
    .lab { grid-template-columns: 1fr; gap: 2rem; }
    /* il disegno porta le etichette DENTRO l'SVG: se lo si stringe troppo,
       scalano con lui e diventano illeggibili (a 260px scendevano a 9,6px).
       Qui prende la colonna, con un tetto che tiene le etichette sopra i 12px. */
    .iceberg { max-width: 420px; margin: 0 auto; }
  }

  /* ── il filo del racconto ── */
  .racconto { display: grid; grid-template-columns: 1.25fr 1fr; gap: 2.4rem; align-items: start; }
  .lungo { font-size: 1.04rem; }
  /* ══ IL COMPENDIO VISUALE — griglia 3×3 ══
     Caselle quadrate, tre per riga a qualunque larghezza: una griglia
     3×3 che diventa 3×1 non è più una griglia. Sotto i 560px le caselle
     si fanno piccole ma restano nove, e l'insieme resta leggibile
     perché ognuna porta il proprio titolo. */
  .griglia {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.35rem, 1vw, 0.6rem);
  }

  .cella {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 2px;
    background: var(--bg-deep);
    cursor: pointer;
    /* l'ordine lo assegna lo script: il DOM resta quello scritto */
    order: var(--ord, 0);
  }

  .cella-poster, .cella-clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cella-clip { opacity: 0; transition: opacity 0.3s var(--ease); }
  .cella:hover .cella-clip, .cella:focus-visible .cella-clip { opacity: 1; }

  /* Nessuna didascalia: l'unica affordance è il fotogramma che si
     accende. A riposo sta un passo indietro — appena scurito e slavato —
     e al passaggio torna pieno. Il velo si toglie invece di aggiungersi:
     è il contrario del solito, e serve a far capire che la casella è
     viva senza scriverci sopra niente. */
  .cella-poster, .cella-clip {
    filter: saturate(0.72) brightness(0.78);
    transition: filter 0.32s var(--ease), transform 0.32s var(--ease);
  }

  .cella:hover .cella-poster, .cella:focus-visible .cella-poster,
  .cella:hover .cella-clip, .cella:focus-visible .cella-clip {
    filter: saturate(1) brightness(1);
    transform: scale(1.04);
  }

  .cella:focus-visible { outline: 2px solid var(--brand-accent); outline-offset: 2px; }

  /* Le caselle ancora senza materiale: non un rettangolo grigio, ma
     un'atmosfera nel colore del marchio — così l'ossatura si giudica
     completa anche prima che arrivino i video. */
  .cella.vuota {
    background:
      radial-gradient(ellipse 120% 90% at 25% 0%, color-mix(in srgb, var(--brand-accent) 16%, transparent), transparent 70%),
      linear-gradient(135deg, var(--bg-mid), var(--bg-deep) 70%);
    cursor: default;
  }
  .cella.vuota { cursor: default; }

  /* ══ IL SIPARIO DEL VIDEO ══ */
  .proiezione {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(24, 16, 12, 0.94);
    color: #fbf4ec;
  }
  .proiezione::backdrop { background: rgba(24, 16, 12, 0.6); }

  .pr-in {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.9rem;
    padding: clamp(3.5rem, 8vh, 5rem) clamp(1rem, 5vw, 3rem);
  }

  .pr-telaio {
    position: relative;
    width: 100%;
    max-width: 68rem;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  /* le scene sono 3:2, i video 16:9: il telaio cambia proporzione invece
     di incorniciare l'illustrazione di nero su due lati */
  .pr-telaio--scena { aspect-ratio: 3 / 2; background: var(--bg-mid); }
  .pr-telaio :global(.pr-scena) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .pr-telaio :global(iframe),
  .pr-telaio :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .pr-titolo {
    max-width: 68rem;
    margin: 0 auto;
    font-family: 'Manrope', sans-serif;
    font-size: 0.82rem;
    color: rgba(251, 244, 236, 0.75);
  }

  .pr-chiudi {
    position: absolute;
    top: clamp(0.8rem, 2.5vw, 1.4rem);
    right: clamp(0.8rem, 2.5vw, 1.4rem);
    z-index: 2;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    font-size: 1.7rem;
    line-height: 1;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    opacity: 0.7;
  }
  .pr-chiudi:hover { opacity: 1; }
  .pr-chiudi:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .cella-clip, .cella-poster { transition: none; }
    .cella:hover .cella-poster, .cella:focus-visible .cella-poster,
    .cella:hover .cella-clip, .cella:focus-visible .cella-clip { transform: none; }
  }

  .lavinia { margin: 0; }
  .lavinia video {
    width: 100%;
    height: auto;
    display: block;
    background: var(--bg-mid);
    border: 1px solid var(--hairline);
  }
  .lavinia figcaption, .credit {
    font-size: 0.74rem;
    color: var(--text-faint);
    margin-top: 0.6rem;
  }
  .credit { margin-top: 1.6rem; }
