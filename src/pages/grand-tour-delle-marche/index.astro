<script>
  // ── L'ITINERARIO: la strada percorsa e i waypoint superati ──
  const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ══ IL COMPENDIO VISUALE: mescola, anima, proietta ══
  (function compendio() {
    const griglia = document.getElementById('griglia-racconto');
    const sipario = document.getElementById('proiezione');
    // il ripiego del titolo si legge dall'etichetta che il sipario ha già in
    // pagina, invece di stare scritto qui dentro: quando arriverà l'inglese
    // basta cambiarla in src/i18n/grand-tour.js
    const etichettaSipario = (sipario && sipario.getAttribute('aria-label')) || 'Video';
    if (!griglia || !sipario) return;

    const celle = Array.from(griglia.querySelectorAll('.cella'));

    // RIPESCA. Le due caselle fisse — Lavinia e il Grand Tour 2026 — ci
    // sono sempre; le altre sette vengono ripescate a caso dal bacino a
    // ogni visita. Si cambiano solo src e attributi, mai il numero di
    // caselle: la griglia è già disegnata e non salta.
    // Senza JS resta il sorteggio fatto al build, che è comunque una
    // griglia piena — ed è quella che leggono i motori.
    let bacino = [];
    try { bacino = JSON.parse(document.getElementById('bacino-racconto').textContent); } catch {}

    const mobili = celle.filter((c) => !c.dataset.fissa);
    if (bacino.length >= mobili.length) {
      const mazzo = bacino.map((v) => [Math.random(), v]).sort((a, b) => a[0] - b[0]).map((x) => x[1]);
      mobili.forEach((c, i) => {
        const v = mazzo[i];
        c.dataset.yt = v.id;
        c.dataset.titolo = v.titolo;
        c.setAttribute('aria-label', v.titolo);
        c.disabled = false;
        const img = c.querySelector('.cella-poster');
        if (img) img.src = '/gt/racconto/' + v.id + '.jpg';
      });
    }

    // LE POSIZIONI. Anche le due caselle fisse cambiano posto a ogni
    // visita: ci sono sempre, ma non sempre nello stesso riquadro.
    // Si spostano i nodi nel DOM e non si usa `order` del CSS: con
    // `order` l'ordine visivo e quello di tabulazione divergono, e chi
    // naviga da tastiera salterebbe da una casella all'altra senza una
    // logica apparente. Spostando i nodi, i due ordini restano lo stesso.
    (function rimescolaPosizioni() {
      const voci = Array.from(griglia.children);
      for (let i = voci.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [voci[i], voci[j]] = [voci[j], voci[i]];
      }
      const f = document.createDocumentFragment();
      voci.forEach((v) => f.appendChild(v));
      griglia.appendChild(f);
    })();

    // ANTEPRIME: la clip parte al passaggio e si rimette a zero quando
    // esci. preload="none", quindi non si scarica niente finché non
    // serve. Con reduced-motion resta il poster e basta.
    if (!ridotto) {
      celle.forEach((c) => {
        const clip = c.querySelector('.cella-clip');
        if (!clip) return;
        const via = () => { const p = clip.play(); if (p && p.catch) p.catch(() => {}); };
        const stop = () => { clip.pause(); clip.currentTime = 0; };
        c.addEventListener('mouseenter', via);
        c.addEventListener('focus', via);
        c.addEventListener('mouseleave', stop);
        c.addEventListener('blur', stop);
      });
    }

    // PROIEZIONE. L'iframe nasce qui e muore alla chiusura: nessun
    // cookie di YouTube prima del clic, e niente player che continua a
    // girare dietro un sipario chiuso.
    const telaio = document.getElementById('pr-telaio');
    const titolo = document.getElementById('pr-titolo');

    function apri(cella) {
      const yt = cella.dataset.yt;
      const clip = cella.querySelector('.cella-clip');
      telaio.textContent = '';
      if (yt) {
        const f = document.createElement('iframe');
        f.src = `https://www.youtube-nocookie.com/embed/${yt}?autoplay=1&rel=0`;
        f.title = cella.dataset.titolo || etichettaSipario;
        f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture';
        f.allowFullscreen = true;
        telaio.appendChild(f);
      } else if (clip) {
        // finché non c'è il montato su YouTube si proietta la clip che
        // c'è, con i controlli e l'audio a disposizione
        const v = document.createElement('video');
        v.src = clip.getAttribute('src');
        v.controls = true;
        v.autoplay = true;
        v.playsInline = true;
        telaio.appendChild(v);
      } else return;
      titolo.textContent = cella.dataset.titolo || '';
      sipario.setAttribute('aria-label', cella.dataset.titolo || etichettaSipario);
      sipario.showModal();
    }

    function chiudi() { if (sipario.open) sipario.close(); }

    celle.forEach((c) => c.addEventListener('click', () => apri(c)));
    sipario.querySelector('[data-chiude]').addEventListener('click', chiudi);
    sipario.addEventListener('click', (e) => { if (e.target === sipario) chiudi(); });
    // Svuotare il telaio alla chiusura ferma il video, qualunque sia; e
    // toglie la proporzione 3:2 delle scene, o il video aperto subito dopo
    // nascerebbe in una cornice sbagliata.
    sipario.addEventListener('close', () => {
      telaio.textContent = '';
      titolo.textContent = '';
      telaio.classList.remove('pr-telaio--scena');
    });

    // LE SCENE DELL'EDIZIONE IN CORSO. Stanno qui dentro, e non più in
    // fondo allo script, perché il sipario è una costante di questa
    // funzione: fuori non esiste. Riusano il sipario dei video invece di
    // aprirne un secondo — trappola del fuoco, ESC e ritorno del fuoco al
    // bottone d'origine li dà il browser, e la pagina non impara un gesto
    // nuovo. Senza JavaScript le scene restano in pagina a 800px: si perde
    // l'ingrandimento, non il contenuto.
    document.querySelectorAll('.t-scena').forEach((b) => {
      b.addEventListener('click', () => {
        telaio.textContent = '';
        const img = document.createElement('img');
        img.src = b.dataset.scena;
        // l'alt vero è già sulla miniatura: lo si riporta, così chi apre
        // la scena grande non trova un'immagine muta
        const dentro = b.querySelector('img');
        img.alt = dentro ? dentro.alt : '';
        img.className = 'pr-scena';
        telaio.appendChild(img);
        telaio.classList.add('pr-telaio--scena');
        titolo.textContent = b.dataset.titolo || '';
        sipario.setAttribute('aria-label', b.dataset.titolo || etichettaSipario);
        sipario.showModal();
      });
    });
  })();
  const percorso = document.getElementById('percorso');
  const wp = Array.from(document.querySelectorAll('.waypoints a'));
  const soste = wp.map((a) => document.getElementById(a.dataset.wp)).filter(Boolean);

  function strada() {
    const h = document.documentElement;
    const max = h.scrollHeight - innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
    if (percorso) percorso.style.width = (p * 100).toFixed(1) + '%';
    // un waypoint è "passato" quando la sua sosta è stata raggiunta
    let corrente = -1;
    soste.forEach((s, i) => {
      const t = s.getBoundingClientRect().top;
      wp[i].classList.toggle('passato', t <= innerHeight * 0.5);
      if (t <= innerHeight * 0.5) corrente = i;
