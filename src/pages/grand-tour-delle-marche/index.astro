  // ── LE FRECCE DELLE STRISCE ──
  // Un solo pezzo di codice per tutte e due le strisce: ognuna dichiara nel
  // suo `data-scorre` l'id di quella che muove. Il passo è la larghezza di
  // una scheda più il gap, letti dal vivo — così resta giusto a qualunque
  // taglia di schermo, senza numeri scritti a mano qui dentro.
  const rinfrescaStrisce = [];
  document.querySelectorAll('[data-scorre]').forEach((guida) => {
    const pista = document.getElementById(guida.dataset.scorre);
    if (!pista) return;
    const [indietro, avanti] = guida.querySelectorAll('.scorri-b');

    function passo() {
      const prima = pista.querySelector('li:not([hidden])');
      const vuoto = parseFloat(getComputedStyle(pista).columnGap) || 0;
      return prima ? prima.getBoundingClientRect().width + vuoto : pista.clientWidth * 0.8;
    }

    // ⚠️ `scrollWidth > clientWidth` NON basta a dire che c'è qualcosa da
    // raggiungere: la striscia ha una gronda a destra larga quanto il
    // margine della gabbia, e quella sborda anche quando le schede ci
    // stanno tutte — con tre cartoline in teca le frecce comparivano per
    // 47px di vuoto. Le schede sono tutte in vista finché lo sbordo non
    // supera la gronda destra.
    // La tolleranza di 4px assorbe gli scrollLeft frazionari degli schermi
    // a densità alta, che altrimenti lascerebbero un bottone acceso su un
    // estremo già raggiunto.
    function rinfresca() {
      const fuori = pista.scrollWidth - pista.clientWidth;
      const gronda = parseFloat(getComputedStyle(pista).paddingRight) || 0;
      guida.hidden = fuori <= gronda + 4;
      indietro.disabled = pista.scrollLeft <= 4;
      avanti.disabled = pista.scrollLeft >= fuori - 4;
    }

    guida.addEventListener('click', (e) => {
      const b = e.target.closest('.scorri-b');
      if (!b) return;
      pista.scrollBy({ left: Number(b.dataset.verso) * passo(), behavior: ridotto ? 'auto' : 'smooth' });
    });

    pista.addEventListener('scroll', rinfresca, { passive: true });
    addEventListener('resize', rinfresca);
    rinfresca();
    rinfrescaStrisce.push(rinfresca);
  });

  // ── LE ANNATE DELLA TECA ──
  // Stesso gruppo di pastiglie dei nuclei, stesse frecce: chi ha imparato
  // il primo selettore sa già usare il secondo. Qui però la scelta è un
  // filtro e basta — niente accensione al passaggio, perché far cambiare
  // la teca mentre il dito passa sopra una pastiglia è un dispetto.
  const pastiglieAnnate = Array.from(document.querySelectorAll('#annate .chip'));
  const teca = document.getElementById('teca-lista');
  if (pastiglieAnnate.length && teca) {
    const cartoline = Array.from(teca.querySelectorAll('li'));

    function filtra(annata) {
      cartoline.forEach((v) => {
        v.hidden = annata !== '*' && v.dataset.annata !== annata;
      });
      // la teca è una striscia che scorre: cambiando annata si torna
      // all'inizio, o si resta a guardare il vuoto dove prima c'era il 2015
      teca.scrollTo({ left: 0, behavior: 'instant' });
      // un'annata con poche cartoline può non sbordare affatto: le frecce
      // vanno rifatte i conti addosso, e il salto a zero non sempre emette
      // un evento di scorrimento che le sveglierebbe da solo
      rinfrescaStrisce.forEach((f) => f());
    }

    function scegliAnnata(pastiglia) {
      pastiglieAnnate.forEach((p) => {
        const on = p === pastiglia;
        p.setAttribute('aria-checked', on ? 'true' : 'false');
        p.tabIndex = on ? 0 : -1;
      });
      filtra(pastiglia.dataset.annata);
    }

    pastiglieAnnate.forEach((p) => {
      p.addEventListener('click', () => scegliAnnata(p));
      p.addEventListener('keydown', (e) => {
        const i = pastiglieAnnate.indexOf(p);
        let n = null;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') n = (i + 1) % pastiglieAnnate.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') n = (i - 1 + pastiglieAnnate.length) % pastiglieAnnate.length;
        else if (e.key === 'Home') n = 0;
        else if (e.key === 'End') n = pastiglieAnnate.length - 1;
        else return;
        e.preventDefault();
        scegliAnnata(pastiglieAnnate[n]);
        pastiglieAnnate[n].focus();
      });
    });

    // la pastiglia accesa all'apertura deve essere anche quella raggiunta
    // per prima dal tabulatore: il markup la segna con aria-checked, qui
    // si allinea il tabindex
    const accesa = pastiglieAnnate.find((p) => p.getAttribute('aria-checked') === 'true');
    if (accesa) pastiglieAnnate.forEach((p) => { p.tabIndex = p === accesa ? 0 : -1; });
  }

  // ── il nome del comune al passaggio, con l'anno della prima tappa ──
  const tip = document.getElementById('tip');
  const mappa = document.querySelector('.mappa');
  const eventiMap = tip ? JSON.parse(tip.dataset.eventi || '{}') : {};
  if (tip && mappa) {
    paths.forEach((p) => {
      if (!p.classList.contains('toccato')) return;
      p.addEventListener('mouseenter', () => {
        const nome = p.getAttribute('data-comune');
        // comune + evento (il più recente documentato). Dove l'evento non è
        // documentato resta il solo nome: non si deduce.
        const e = eventiMap[nome] || eventiMap[norm(nome)];
        tip.textContent = e ? `${nome} — ${e.evento}` : nome;
        tip.hidden = false;
      });
      p.addEventListener('mousemove', (e) => {
        const r = mappa.getBoundingClientRect();
        tip.style.left = e.clientX - r.left + 'px';
        tip.style.top = e.clientY - r.top + 'px';
      });
      p.addEventListener('mouseleave', () => { tip.hidden = true; });
    });
  }
</script>
