---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pellicola from '../../components/Pellicola.astro';
import mapSvg from '../../assets/gt-map-comuni.svg?raw';
import temi from '../../assets/gt-temi.json';
import tappe from '../../assets/gt-tappe.json';
import eventi from '../../assets/gt-eventi.json';

// LANDING GRAND TOUR DELLE MARCHE — la fabula è L'ITINERARIO
// (ANIGAMI-METANARRATIVA §3): la barra dei capitoli è una strada con
// waypoint, lo scroll è strada fatta, i capitoli sono soste, la chiusura
// è ciò che resta dopo la ripartenza. Lessico odeporico, mai da brochure.
//
// ⚠️ OSSATURA NON REPLICABILE: niente deck a quadri, niente moviola,
// niente card orizzontali (sono di Tipicità), niente plancia (è di TIB).
// Qui il gesto è la STRADA: il progresso e i waypoint.
//
// TESTI: le tre soste sono state RISCRITTE — vedi TESTI-GT-CAPITOLI.md
// (07/08/2026), che annulla l'istruzione «[LAVORATO], trascrivere invariati»
// del §3–5 di TESTI-GT.md. Ora dicono il METODO e non gli esempi: niente
// nomi propri (tipologie al posto dei casi), e il filo è la tesi sul
// destination management — una destinazione non si gestisce prima di
// esistere come soggetto. Arco: metodo → forma → esito.
// Exergo, filo del racconto e chiusura da TESTI-GT.md (BOZZE validate
// nell'impianto da Paolo). Dati mappa/temi da TESTI-GT-DATI.md v2.
//
// ⚠️ CORREZIONE FATTUALE (TESTI-GT.md §1): la prima edizione è il 2014,
// non il 2015 — flyer d'archivio + conferma di Paolo.

// I comuni usano apostrofi curvi in un file e dritti nell'altro: senza
// normalizzare, tre comuni non si accenderebbero mai (Sant'Elpidio a Mare,
// Porto Sant'Elpidio, Serra Sant'Abbondio). Verificato sui dati.
const norm = (s) => s.replace(/[’ʼ]/g, "'");

const nucleiOrdine = [
  'enogastronomia', 'vino & spiriti', 'mare & pesca', 'tradizioni & comunità',
  'cultura & spettacolo', 'storia & rievocazioni', 'natura & outdoor',
  'saper fare & design', 'innovazione', 'sport',
];
const etichetta = (k) => k.charAt(0).toUpperCase() + k.slice(1);

// Righe di esempio: le tre fornite da Cowork si trascrivono tali e quali.
// Per gli altri sette nuclei NON invento il "cosa": mostro i luoghi, che
// sono dato verificato. Le righe mancanti sono segnate in SOSPESI.md.
const esempiForniti = {
  'saper fare & design': 'il cappello a Montappone, la carta a Fabriano, la pelle a Tolentino, la fisarmonica a Castelfidardo…',
  'mare & pesca': 'il brodetto a Porto Recanati, le cozze a Pedaso, la piccola pesca a San Benedetto…',
  'storia & rievocazioni': 'i Templari a Castignano, la battaglia delle Nazioni a Sassoferrato, gli scavi di Monte Rinaldo…',
};
const nuclei = nucleiOrdine.filter((k) => temi[k]).map((k) => ({
  key: k,
  label: etichetta(k),
  comuni: temi[k].map(norm),
  esempi: esempiForniti[k] || temi[k].slice(0, 5).map(norm).join(', ') + '…',
  daCompletare: !esempiForniti[k],
}));

const toccati = tappe.comuni.length;
const edizioni = Object.keys(tappe.years).length;
const primaTappa = tappe.first;

const cartoline = [
  { f: '2015-montecarotto.jpg', t: 'Verdicchio in Festa & Jazz — Montecarotto', a: '2015' },
  { f: '2015-fermo.jpg', t: 'Made in Marche Gallery — Fermo', a: '2015' },
  { f: '2015-pollenza.jpg', t: 'Antiquariato e artigianato artistico — Pollenza', a: '2015' },
  { f: '2016-sefro.jpg', t: 'La Trota e il Verdicchio — Sefro', a: '2016' },
  { f: '2016-fabriano.jpg', t: 'Fabriano Creative City', a: '2016' },
  { f: '2016-montedinove.jpg', t: 'Sibillini in Rosa — Montedinove', a: '2016' },
  { f: '2016-recanati.jpg', t: 'Recanati, città del buon vivere', a: '2016' },
  { f: '2016-senigallia.jpg', t: 'Pane Nostrum — Senigallia', a: '2016' },
  { f: '2016-venarotta.jpg', t: 'Le meraviglie del ricamo — Venarotta', a: '2016' },
  { f: '2017-acquasanta.jpg', t: "Festa d'Autunno — Acquasanta Terme", a: '2017' },
  { f: '2017-apecchio.jpg', t: 'Tartufo e Alogastronomia — Apecchio', a: '2017' },
  { f: '2017-pesaro.jpg', t: 'Candele sotto le stelle — Pesaro', a: '2017' },
  { f: '2017-piobbico.jpg', t: 'Sagra del polentone alla carbonara — Piobbico', a: '2017' },
];

// Le soste dell'itinerario: sono i waypoint della barra-strada.
//
// ⚠️ L'ETICHETTA NON È IL TITOLO (Paolo, 08/08/2026). In barra i nomi
// stanno corti — una strada si legge di sfuggita, mentre si cammina — e i
// concetti pieni restano negli <h2> delle sezioni: «Laboratorio di
// comunità», «Geometria variabile», «Cartoline dal viaggio». È la stessa
// regola dei lemmi di EVO, e risolve anche la striscia che intorno ai
// 1024px tagliava fuori l'ultima tappa.
const soste = [
  { id: 'racconto', label: 'Il racconto' },
  { id: 'laboratorio-di-comunita', label: 'La comunità' },
  { id: 'geometria-variabile', label: 'La geometria' },
  { id: 'incubatore', label: "L'incubatore" },
  { id: 'strada-fatta', label: 'La strada' },
  { id: 'cartoline', label: 'Le cartoline' },
];

// CROMIA (10/07/2026): carta calda, il colore dei borghi d'estate, con i
// corallo ufficiali (ee726c / f6ac7c) come accento. Per i testi #d1544c,
// tono scurito per leggibilità su fondo chiaro.
const theme = {
  '--bg-void': '#fbf4ec',
  '--bg-deep': '#f4e8da',
  '--bg-mid': '#eeddc9',
  '--text-soft': '#2b1d16',
  '--text-dim': 'rgba(43, 29, 22, 0.72)',
  // 0.70: sotto questa soglia il testo piccolo scende sotto il 4.5:1 AA
  // sulla carta calda (misurato a schermo, non stimato a occhio).
  '--text-faint': 'rgba(43, 29, 22, 0.70)',
  '--hairline': 'rgba(43, 29, 22, 0.16)',
};
---

<BaseLayout
  title="Grand Tour delle Marche — un itinerario tra borghi e comunità"
  description="Grand Tour delle Marche: dal 2014 un laboratorio di comunità a geometria variabile. 73 comuni, 13 edizioni, un solo viaggio tra i borghi marchigiani."
  accent="#d1544c"
  theme={theme}
>
  <Pellicola slot="header" current="grand-tour" mode="light" />

  <!-- ══ PARTENZA ══ -->
  <header class="partenza">
    <div class="partenza-in">
      <h1 class="sr-only">Grand Tour delle Marche</h1>
      <img class="marchio" src="/logos/grand-tour-color.svg" alt="Grand Tour delle Marche" width="420" height="168" />
      <p class="dati">
        <span>dal 2014</span>
        <span>13ª edizione (2026)</span>
        <span>itinerario diffuso tra borghi e comunità delle Marche</span>
      </p>
    </div>
    <div class="cue" aria-hidden="true"></div>
  </header>

  <!-- ══ LA BARRA-ITINERARIO: la strada con le sue tappe ══ -->
  <div class="strada">
    <div class="strada-in">
      <img class="strada-marchio" src="/logos/grand-tour-color.svg" alt="" width="86" height="34" />
      <nav class="waypoints" aria-label="Le soste dell'itinerario">
        <span class="tracciato" aria-hidden="true"><span class="percorso" id="percorso"></span></span>
        {soste.map((s) => (
          <a href={`#${s.id}`} data-wp={s.id}><span class="wp-punto" aria-hidden="true"></span>{s.label}</a>
        ))}
      </nav>
    </div>
  </div>

  <main>
    <!-- ══ EXERGO — la lettera del 2014 ══ -->
    <section class="exergo" aria-label="Esergo">
      <blockquote data-reveal>
        <p>«Non come una guida che ti fa fare il solito giro turistico, ma come un amico che ti porta a scoprire casa sua.»</p>
        <cite>dalla lettera di Gioacchino, 2014</cite>
      </blockquote>
    </section>

    <!-- ══ IL FILO DEL RACCONTO ══ -->
    <section class="sosta" id="racconto" aria-labelledby="h-racconto">
      <div class="wrap">
        <h2 id="h-racconto" data-reveal>Il filo del racconto</h2>
        <div class="racconto">
          <p class="lungo" data-reveal>Il Grand Tour non ha mai elencato tappe: le ha sempre affidate a qualcuno. È nato nel 2014 con una lettera — Gioacchino che scrive al nipote Francesco, emigrato e in procinto di tornare con la sua Heidi, per promettergli un viaggio autentico nelle Marche. Un itinerario nato come invito al ritorno. Sulla strada è arrivata Lavinia Atipica, viaggiatrice dissacrante, curiosa, pronta a mettersi in gioco davanti a ogni bellezza — e tornata anni dopo, come tornano i viaggiatori veri. Oggi il passo lo detta Martino: erede del Picchio leggendario che guidò i Piceni a fondare queste terre, picchio della generazione alpha, con un sano spirito d'avventura. Da una lettera a un picchio: il racconto cambia voce, la strada resta. Chi segue il Grand Tour non consulta un calendario — tiene il passo di un personaggio.</p>

          <figure class="lavinia" data-reveal>
            <video controls preload="none" poster="/gt/lavinia-poster.jpg" width="640" height="360">
              <source src="/gt/lavinia.mp4" type="video/mp4" />
            </video>
            <figcaption>Lavinia Atipica, dall'archivio del Grand Tour.</figcaption>
          </figure>
        </div>
        {/* ⚠️ CORREZIONE FATTUALE (Paolo, 08/08/2026): Martino NON è di
            Simona Pagano. L'attribuzione era in due punti — questa riga di
            credito e, dentro il testo, «la matita dell'artista ascolana
            Simona Pagano nelle piume». Tolte entrambe: lasciarne una sola
            avrebbe spostato l'errore, non risolto.
            IN SOSPESO: chi è l'autore di Martino, e se Simona Pagano vada
            accreditata per qualcos'altro (Lavinia?). Il credito giusto va
            rimesso appena si sa. */}
      </div>
    </section>

    <!-- ══ LE TRE SOSTE — testi [LAVORATO], invariati ══ -->
    <section class="sosta sosta--alt" id="laboratorio-di-comunita" aria-labelledby="h-lab">
      <div class="wrap">
        <h2 id="h-lab" data-reveal>Laboratorio di comunità</h2>
        <p data-reveal>Prima di ogni programma vengono i mesi che nessuno vede: la mappatura di chi in un territorio produce, coltiva, cucina, ospita, racconta; gli incontri uno a uno con chi ci vive tutto l'anno; il lavoro paziente di mettere allo stesso tavolo persone che nello stesso paese non si erano mai sedute insieme. Quello che arriva al pubblico è la punta. Il resto resta in dote alla comunità che ospita, e non compare in nessuna comunicazione — se non qui, perché qui parliamo del metodo e non di un'edizione.</p>
        <p data-reveal>Oggi si parla molto di destination management, e quasi sempre si comincia dal fondo: il piano, il marchio, la governance. Ma una destinazione non si gestisce prima di esistere come soggetto — prima cioè che chi la abita si riconosca in un racconto comune e accetti di starci dentro. Concertazione, ascolto e coinvolgimento non sono la premessa gentile di quel lavoro: ne sono la condizione. E un evento, in questo, è uno strumento formidabile, perché mette a disposizione ciò che manca sempre: una data, un'occasione e un oggetto concreto attorno a cui trovare un accordo. Non promuove soltanto una destinazione. La costruisce.</p>
      </div>
    </section>

    <section class="sosta" id="geometria-variabile" aria-labelledby="h-geo">
      <div class="wrap">
        <h2 id="h-geo" data-reveal>Geometria variabile</h2>
        <p data-reveal>Un borgo di poche centinaia di abitanti e una città capoluogo non hanno bisogno della stessa cosa. Così in tredici edizioni il formato ha cambiato forma ogni volta: dove non c'era niente il Grand Tour ha inventato da zero un appuntamento che prima non esisteva; dove il tema non stava in un solo paese ha costruito un'esperienza estesa a un intero areale; dove esisteva già una manifestazione radicata è entrato da ospite, senza nessuna intenzione di annettersela.</p>
        <p data-reveal>Non è lo stesso evento replicato: è lo stesso principio in forme diverse. E non è flessibilità per vocazione — è la conseguenza dell'ascolto, perché chi ascolta davvero non può standardizzare. Vale anche per il perimetro: una destinazione non coincide quasi mai con un confine amministrativo. Si tiene insieme per affinità e per vocazione — una valle, un paesaggio, una filiera — e la geometria dell'itinerario segue quella, non la carta.</p>
      </div>
    </section>

    <section class="sosta sosta--alt" id="incubatore" aria-labelledby="h-inc">
      <div class="wrap">
        <h2 id="h-inc" data-reveal>Incubatore</h2>
        <p data-reveal>Non tutto quello che nasce dentro il formato resta legato al suo calendario. Alcune cose imparano a camminare da sole: tornano ogni anno anche quando l'itinerario è altrove, con la propria organizzazione e il proprio pubblico, e a un certo punto non hanno più bisogno di noi. Sono la prova che il laboratorio ha funzionato.</p>
        <p data-reveal>Il segno non è mai quanto dura la festa. È cosa resta quando il Grand Tour è già ripartito: operatori che prima non si conoscevano e adesso si telefonano, un appuntamento che qualcun altro ha preso in mano, una comunità che si è accorta di essere una destinazione. È da qui che un territorio può incamminarsi verso una DMO — non da un organigramma, ma da un gruppo che ha già imparato a decidere insieme.</p>
      </div>
    </section>

    <!-- ══ DOVE & COSA — la mappa che risponde ══
         Il tema accende i luoghi. Niente cursore-anni: non è una moviola. -->
    <section class="sosta strada-fatta" id="strada-fatta" aria-labelledby="h-strada">
      <div class="wrap">
        <h2 id="h-strada" data-reveal>La strada fatta</h2>
        <p class="sotto" data-reveal>{toccati} comuni · {edizioni} edizioni · un solo viaggio</p>

        <div class="dovecosa" data-reveal>
          <div class="mappa">
            <svg viewBox="6 72 988 1006" role="img" aria-label={`Mappa delle Marche: ${toccati} comuni toccati dall'itinerario su 225`}>
              <Fragment set:html={mapSvg} />
            </svg>
            <div class="tip" id="tip" hidden aria-hidden="true" data-eventi={JSON.stringify(eventi)}></div>
          </div>

          <div class="nuclei">
            <span class="nuclei-label" id="lbl-nuclei">I nuclei tematici</span>
            <div class="chip-lista" role="radiogroup" aria-labelledby="lbl-nuclei" id="chips">
              {nuclei.map((n, i) => (
                <button
                  class="chip"
                  role="radio"
                  aria-checked="false"
                  tabindex={i === 0 ? '0' : '-1'}
                  data-tema={n.key}
                  data-comuni={n.comuni.join('|')}
                  data-esempi={n.esempi}
                >{n.label}</button>
              ))}
            </div>
            <p class="esempi" id="esempi" role="status" aria-live="polite">Passa su un nucleo per vedere dove è passato.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ CARTOLINE DAL VIAGGIO ══ -->
    <section class="sosta sosta--alt" id="cartoline" aria-labelledby="h-cart">
      <div class="wrap">
        <h2 id="h-cart" data-reveal>Cartoline dal viaggio</h2>
        <p class="sotto" data-reveal>Dall'archivio: le cartoline ufficiali delle prime edizioni.</p>
      </div>
      <div class="teca" data-reveal>
        <ul>
          {cartoline.map((c, i) => (
            <li style={`--rot:${(i % 3) - 1}deg`}>
              <figure>
                <img src={`/gt/cartoline/${c.f}`} alt={c.t} width="900" height="637" loading="lazy" decoding="async" />
                <figcaption><span class="timbro">{c.a}</span>{c.t}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ══ RIPARTENZA ══ -->
    <section class="ripartenza" aria-label="Chiusura">
      <p data-reveal>Il Grand Tour non finisce: riparte. La prossima sosta è già sulla mappa — e come ogni anno, qualcosa resterà anche dopo.</p>
    </section>
  </main>
</BaseLayout>

<style is:global>
  ::selection { background: rgba(209, 84, 76, 0.24); color: #2b1d16; }

  /* La mappa è iniettata: gli stili scoped non la aggancerebbero. */
  .mappa svg path {
    fill: #efe3d4;
    stroke: #fbf4ec;
    stroke-width: 1.1;
    transition: fill 0.28s cubic-bezier(0.55, 0.05, 0.18, 1);
  }
  .mappa svg path.toccato { fill: #f6ac7c; }
  .mappa svg path.acceso { fill: #d1544c; }
  @media (prefers-reduced-motion: reduce) {
    .mappa svg path { transition: none; }
  }
</style>

<style>
  .partenza, .strada, main { --ease: cubic-bezier(0.55, 0.05, 0.18, 1); }
  .dati, .nuclei-label, .timbro, .waypoints a, .credit {
    font-family: 'Manrope', sans-serif;
  }

  /* ══ PARTENZA ══ */
  .partenza {
    position: relative;
    min-height: 82svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6rem 1.6rem 5rem;
    background:
      radial-gradient(ellipse 85% 60% at 50% 40%, rgba(246, 172, 124, 0.28), transparent 70%),
      var(--bg-void);
  }
  .marchio { width: min(74vw, 420px); height: auto; display: block; margin: 0 auto; }
  .dati {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0 0.7rem;
    margin: 2.2rem 0 0;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--text-dim);
  }
  .dati span + span::before {
    content: '·';
    margin-right: 0.7rem;
    color: var(--text-faint);
  }
  .cue {
    position: absolute;
    bottom: 1.8rem;
    left: 50%;
    width: 1px;
    height: 52px;
    background: linear-gradient(var(--brand-accent), transparent);
    animation: cue 2.4s ease-in-out infinite;
  }
  @keyframes cue {
    0% { transform: scaleY(0); transform-origin: top; }
    45% { transform: scaleY(1); transform-origin: top; }
    55% { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }
  @media (prefers-reduced-motion: reduce) { .cue { animation: none; opacity: 0.5; } }

  /* ══ LA STRADA: barra-itinerario con waypoint ══ */
  .strada {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--bg-void) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .strada-in {
    max-width: 70rem;
    margin: 0 auto;
    padding: 0.6rem 1.6rem;
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }
  /* La strada occupa tutta la larghezza: le si chiede di liberare
     l'angolo dove sta fissa la pellicola (BRIEF-MENU §6). I waypoint
     scorrono e non arrivano al bordo. */
  @media (min-width: 760px) {
    .strada-in { padding-right: 265px; }
  }
  .strada-marchio { height: 30px; width: auto; flex: none; }
  .waypoints {
    position: relative;
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 0.5rem 0 0.35rem;
    flex: 1;
    /* senza questo un figlio flex non scende sotto la larghezza del proprio
       contenuto: la strada sfonderebbe la pagina invece di scorrere */
    min-width: 0;
  }
  .waypoints::-webkit-scrollbar { display: none; }
  /* il tracciato: la strada; il percorso: quanta se n'è fatta */
  .tracciato {
    position: absolute;
    left: 0;
    right: 0;
    top: 0.95rem;
    height: 1px;
    background: var(--hairline);
  }
  .percorso {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--brand-accent);
    transition: width 0.2s linear;
  }
  .waypoints a {
    position: relative;
    flex: 0 0 auto;
    padding-top: 0.9rem;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--text-faint);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s var(--ease);
  }
  .wp-punto {
    position: absolute;
    top: 0.3rem;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--bg-void);
    border: 1px solid var(--text-faint);
    transition: background 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .waypoints a:hover { color: var(--text-soft); }
  .waypoints a:active { color: var(--brand-accent); }
  .waypoints a.passato .wp-punto { background: var(--brand-accent); border-color: var(--brand-accent); }
  .waypoints a[aria-current='true'] { color: var(--brand-accent); }
  .waypoints a[aria-current='true'] .wp-punto {
    background: var(--brand-accent);
    border-color: var(--brand-accent);
    box-shadow: 0 0 0 3px rgba(209, 84, 76, 0.2);
  }

  /* ══ ESERGO ══ */
  .exergo {
    padding: clamp(3.5rem, 10vh, 6.5rem) 1.6rem;
    background: var(--bg-void);
  }
  .exergo blockquote { max-width: 44rem; margin: 0 auto; text-align: center; }
  .exergo p {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.5rem, 4vw, 2.4rem);
    line-height: 1.3;
    color: var(--text-soft);
    margin: 0 0 1.2rem;
    text-wrap: balance;
  }
  .exergo cite {
    font-family: 'Manrope', sans-serif;
    font-style: normal;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* ══ SOSTE ══ */
  .sosta { padding: clamp(3rem, 8vh, 5rem) 0; }
  .sosta--alt { background: var(--bg-deep); }
  .wrap { max-width: 70rem; margin: 0 auto; padding: 0 1.6rem; }
  h2 { font-size: clamp(1.7rem, 3.6vw, 2.3rem); color: var(--brand-accent); margin: 0 0 1.2rem; }
  .sosta p {
    /* 54ch: con Inter l'unità ch è stretta e 64ch rendeva righe da 85-86
       caratteri (misurato a 1440). A 54ch la riga più lunga sta sui 73. */
    max-width: 54ch;
    line-height: 1.78;
    color: var(--text-dim);
    text-wrap: pretty;
  }
  .sotto {
    font-family: 'Manrope', sans-serif;
    font-size: 0.88rem;
    color: var(--text-faint);
    margin: -0.6rem 0 1.8rem;
  }

  /* ── il filo del racconto ── */
  .racconto { display: grid; grid-template-columns: 1.25fr 1fr; gap: 2.4rem; align-items: start; }
  .lungo { font-size: 1.04rem; }
  .lavinia { margin: 0; }
  .lavinia video {
    width: 100%;
    height: auto;
    display: block;
    background: var(--bg-mid);
    border: 1px solid var(--hairline);
  }
  .lavinia figcaption, .credit {
    font-size: 0.74rem;
    color: var(--text-faint);
    margin-top: 0.6rem;
  }
  .credit { margin-top: 1.6rem; }
  @media (max-width: 820px) { .racconto { grid-template-columns: 1fr; gap: 1.8rem; } }

  /* ══ DOVE & COSA ══ */
  .dovecosa { display: grid; grid-template-columns: 1fr 1fr; gap: 2.4rem; align-items: start; }
  /* stessa ragione dei waypoint: la striscia di chip deve poter scorrere
     dentro la sua cella, non allargare la griglia */
  .nuclei { min-width: 0; }
  .mappa { position: relative; }
  .mappa svg { width: 100%; height: auto; display: block; }
  .tip {
    position: absolute;
    z-index: 4;
    transform: translate(-50%, -125%);
    background: var(--text-soft);
    color: var(--bg-void);
    font-family: 'Manrope', sans-serif;
    font-size: 0.7rem;
    padding: 0.3rem 0.55rem;
    white-space: nowrap;
    pointer-events: none;
  }
  .nuclei-label {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 1rem;
  }
  .chip-lista { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    font-family: 'Manrope', sans-serif;
    font-size: 0.8rem;
    color: var(--text-dim);
    background: transparent;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.44rem 0.9rem;
    cursor: pointer;
    transition: background 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .chip:hover { border-color: var(--brand-accent); color: var(--text-soft); }
  .chip:active { background: rgba(209, 84, 76, 0.12); }
  .chip[aria-checked='true'] {
    background: var(--brand-accent);
    border-color: var(--brand-accent);
    color: #fff;
  }
  .esempi {
    margin: 1.4rem 0 0;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--text-dim);
    min-height: 3.4rem; /* altezza riservata: la riga non fa saltare il blocco */
    text-wrap: pretty;
  }
  @media (max-width: 900px) {
    .dovecosa { grid-template-columns: 1fr; gap: 1.6rem; }
    .mappa { max-width: 26rem; margin: 0 auto; }
    /* i nuclei diventano una striscia che scorre, non un muro di chip */
    .chip-lista {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 0.3rem;
      -webkit-mask-image: linear-gradient(90deg, #000 88%, transparent 100%);
      mask-image: linear-gradient(90deg, #000 88%, transparent 100%);
    }
    .chip-lista::-webkit-scrollbar { display: none; }
    .chip { flex: 0 0 auto; }
    .esempi { min-height: 4.6rem; }
  }

  /* ══ TECA DELLE CARTOLINE ══ */
  .teca { margin-top: 1.6rem; }
  .teca ul {
    list-style: none;
    margin: 0;
    padding: 1.2rem max(calc((100vw - 70rem) / 2 + 1.6rem), 1.6rem) 1.6rem;
    display: flex;
    gap: 1.4rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .teca ul::-webkit-scrollbar { display: none; }
  .teca li { flex: 0 0 min(74vw, 22rem); scroll-snap-align: center; }
  .teca figure { margin: 0; transform: rotate(var(--rot)); transition: transform 0.3s var(--ease); }
  .teca figure:hover { transform: rotate(0deg); }
  .teca img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 900 / 637; /* altezza riservata: nessuno scarto al caricamento */
    object-fit: cover;
    background: var(--bg-mid);
    box-shadow: 0 6px 22px rgba(43, 29, 22, 0.14);
  }
  .teca figcaption {
    font-family: 'Manrope', sans-serif;
    font-size: 0.76rem;
    color: var(--text-dim);
    margin-top: 0.7rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  /* il timbro: l'anno resta leggibile (il corallo su carta non arriva ad AA
     a questo corpo), il colore di marchio resta nel bordo */
  .timbro {
    flex: none;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    border: 1px solid var(--brand-accent);
    border-radius: 2px;
    padding: 0.08rem 0.32rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .teca figure, .teca figure:hover { transition: none; transform: none; }
  }

  /* ══ RIPARTENZA ══ */
  .ripartenza {
    border-top: 1px solid var(--hairline);
    padding: clamp(2.6rem, 7vh, 4rem) 1.6rem;
    text-align: center;
  }
  .ripartenza p {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.2rem, 2.6vw, 1.6rem);
    line-height: 1.45;
    color: var(--text-soft);
    max-width: 40rem;
    margin: 0 auto;
    text-wrap: balance;
  }

  /* ══ FUOCO DISEGNATO ══ */
  .waypoints a:focus-visible,
  .chip:focus-visible {
    outline: none;
    color: var(--brand-accent);
    box-shadow: 0 0 0 2px var(--bg-void), 0 0 0 4px var(--brand-accent);
    border-radius: 999px;
  }
  .waypoints a:focus-visible { border-radius: 3px; }

  @media (max-width: 620px) {
    .wrap { padding: 0 1.2rem; }
    .dati { flex-direction: column; gap: 0.4rem; }
    .dati span + span::before { content: none; margin: 0; }
    .strada-marchio { height: 24px; }
  }
</style>

<script>
  // ── L'ITINERARIO: la strada percorsa e i waypoint superati ──
  const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const percorso = document.getElementById('percorso');
  const wp = Array.from(document.querySelectorAll('.waypoints a'));
  const soste = wp.map((a) => document.getElementById(a.dataset.wp)).filter(Boolean);

  function strada() {
    const h = document.documentElement;
    const max = h.scrollHeight - innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
    if (percorso) percorso.style.width = (p * 100).toFixed(1) + '%';
    // un waypoint è "passato" quando la sua sosta è stata raggiunta
    let corrente = -1;
    soste.forEach((s, i) => {
      const t = s.getBoundingClientRect().top;
      wp[i].classList.toggle('passato', t <= innerHeight * 0.5);
      if (t <= innerHeight * 0.5) corrente = i;
    });
    wp.forEach((a, i) => a.setAttribute('aria-current', i === corrente ? 'true' : 'false'));
  }
  addEventListener('scroll', strada, { passive: true });
  addEventListener('resize', strada);
  strada();

  // ── LA MAPPA CHE RISPONDE: il tema accende i luoghi ──
  const norm = (s) => (s || '').replace(/[’ʼ]/g, "'");
  const chips = Array.from(document.querySelectorAll('.chip'));
  const esempi = document.getElementById('esempi');
  const paths = Array.from(document.querySelectorAll('.mappa svg path'));
  const perComune = new Map();
  paths.forEach((p) => {
    const n = norm(p.getAttribute('data-comune'));
    if (!n) return;
    if (!perComune.has(n)) perComune.set(n, []);
    perComune.get(n).push(p);
  });

  const attesa = esempi ? esempi.textContent : '';
  function spegni() {
    paths.forEach((p) => p.classList.remove('acceso'));
  }
  function accendi(chip) {
    spegni();
    norm(chip.dataset.comuni).split('|').forEach((c) => {
      (perComune.get(c) || []).forEach((p) => p.classList.add('acceso'));
    });
    if (esempi) esempi.textContent = chip.textContent.trim() + ': ' + chip.dataset.esempi;
  }
  function scegli(chip) {
    chips.forEach((c) => {
      const on = c === chip;
      c.setAttribute('aria-checked', on ? 'true' : 'false');
      c.tabIndex = on ? 0 : -1;
    });
    accendi(chip);
  }

  chips.forEach((c) => {
    c.addEventListener('mouseenter', () => accendi(c));
    c.addEventListener('focus', () => accendi(c));
    c.addEventListener('click', () => scegli(c));
    c.addEventListener('keydown', (e) => {
      const i = chips.indexOf(c);
      let n = null;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') n = (i + 1) % chips.length;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') n = (i - 1 + chips.length) % chips.length;
      else if (e.key === 'Home') n = 0;
      else if (e.key === 'End') n = chips.length - 1;
      else return;
      e.preventDefault();
      scegli(chips[n]);
      chips[n].focus();
    });
  });
  // uscendo dalla lista si torna allo stato di riposo, se non c'è una scelta
  const lista = document.getElementById('chips');
  if (lista) {
    lista.addEventListener('mouseleave', () => {
      const scelto = chips.find((c) => c.getAttribute('aria-checked') === 'true');
      if (scelto) accendi(scelto);
      else { spegni(); if (esempi) esempi.textContent = attesa; }
    });
  }

  // ── il nome del comune al passaggio, con l'anno della prima tappa ──
  const tip = document.getElementById('tip');
  const mappa = document.querySelector('.mappa');
  const eventiMap = tip ? JSON.parse(tip.dataset.eventi || '{}') : {};
  if (tip && mappa) {
    paths.forEach((p) => {
      if (!p.classList.contains('toccato')) return;
      p.addEventListener('mouseenter', () => {
        const nome = p.getAttribute('data-comune');
        // comune + evento (il più recente documentato). Dove l'evento non è
        // documentato resta il solo nome: non si deduce.
        const e = eventiMap[nome] || eventiMap[norm(nome)];
        tip.textContent = e ? `${nome} — ${e.evento}` : nome;
        tip.hidden = false;
      });
      p.addEventListener('mousemove', (e) => {
        const r = mappa.getBoundingClientRect();
        tip.style.left = e.clientX - r.left + 'px';
        tip.style.top = e.clientY - r.top + 'px';
      });
      p.addEventListener('mouseleave', () => { tip.hidden = true; });
    });
  }
</script>
