---
import BaseLayout from '../layouts/BaseLayout.astro';

// ══════════════════════════════════════════════════════════════════════
// LA HOME — LA CASA (BRIEF-HOME v4, 09/08/2026)
//
// Un campo scuro a piena pagina dentro una cornice. Al centro il
// logotipo Imagina che si compone UNA VOLTA SOLA e resta. Sotto, la riga
// di visione. Dietro, molto attenuato, un fondale che respira. Sul
// filetto in basso i dispacci dal feed. In basso a destra i quattro
// segni dei progetti, piccoli.
//
// Niente scroll, niente overlay di marchio, niente Mutamenti: chi
// atterra qui deve ricevere la visione di IMAGINA, non quella dei
// singoli progetti. I quattro progetti stanno in un angolo come timbri.
//
// ⚠️ REGOLE SOVRANE — la parola "anigami" non compare mai (vive solo in
// info@anigami.it); mai "quattro festival"; i giochi di senso non si
// spiegano.
//
// ⚠️⚠️ IL PUNTO IN CUI È FACILE SBAGLIARE: il logotipo è bianco su nero e
// va in `mix-blend-mode: screen`, che mangia il nero e lascia passare
// solo il segno luminoso. Il blend agisce sul CONTESTO DI IMPILAMENTO
// più vicino: se un antenato del video ha z-index, opacity < 1,
// transform, filter o will-change, il logo si fonde con il vuoto e il
// rettangolo nero riappare. Per questo qui i livelli sono ordinati
// SOLO dall'ordine nel DOM — fondale, vignetta, cornice, contenuto — e
// non c'è un solo z-index dentro .casa.
// ══════════════════════════════════════════════════════════════════════

// I quattro segni (§9). Sul campo scuro si usano le varianti accese,
// come sulla pellicola delle pagine scure.
const segni = [
  { id: 'tipicita', simbolo: 'mk-tipicita', nome: 'Tipicità Festival', href: '/tipicita/', acceso: '#05606a' },
  { id: 'grand-tour', simbolo: 'mk-grand-tour', nome: 'Grand Tour delle Marche', href: '/grand-tour-delle-marche/', acceso: '#d1544c' },
  { id: 'tipicita-in-blu', simbolo: 'mk-tipicita-in-blu', nome: 'Tipicità in Blu', href: '/tipicita-in-blu/', acceso: '#209fb6' },
  { id: 'evo', simbolo: 'mk-evo', nome: 'EVO', href: '/evo/', acceso: '#b8497a' },
];

// Il campo scuro. Neutro di proposito: il fondale è materiale caldo e
// deve poter tingere la pagina senza litigare con una dominante.
const theme = {
  '--bg-void': '#08090b',
  '--bg-deep': '#101216',
  '--bg-mid': '#191c21',
  '--text-soft': '#f2efe9',
  '--text-dim': 'rgba(242, 239, 233, 0.72)',
  '--text-faint': 'rgba(242, 239, 233, 0.55)',
  '--hairline': 'rgba(242, 239, 233, 0.22)',
  '--imagina-ink': '#f26fae',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Imagina Srl Società Benefit',
  url: 'https://anigami.it',
  email: 'info@anigami.it',
  foundingDate: '1991',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Viale Giacomo Leopardi, 14',
    addressLocality: 'Camerino',
    addressRegion: 'Marche',
    postalCode: '62032',
    addressCountry: 'IT',
  },
  vatID: 'IT01115460436',
};
---

<BaseLayout
  title="Imagina Srl Società Benefit"
  description="Imagina Srl Società Benefit, Camerino: dal 1991 marketing territoriale e comunicazione integrata. Un territorio non si promuove: si mette in condizione di raccontarsi."
  theme={theme}
  structuredData={structuredData}
>
  <main class="casa">
    <h1 class="sr-only">Imagina Srl Società Benefit</h1>

    {/* 1 · IL FONDALE — primo nel DOM, sotto tutto il resto senza z-index */}
    <video
      class="fondale"
      id="fondale"
      src="/home/imagina-fondo.mp4"
      poster="/home/imagina-fondo-poster.jpg"
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
      tabindex="-1"
    ></video>

    {/* 2 · LA VIGNETTA — è questa che tiene leggibile il testo */}
    <div class="vignetta" aria-hidden="true"></div>

    {/* 3 · LA CORNICE — filetto inset con le quattro tacche d'angolo */}
    <div class="cornice" aria-hidden="true">
      <span class="tacca tacca--as"></span><span class="tacca tacca--ad"></span>
      <span class="tacca tacca--bs"></span><span class="tacca tacca--bd"></span>
    </div>

    {/* 4 · LE RIGHE IN CORNICE */}
    <p class="riga riga--as">Imagina Srl Società Benefit</p>
    <div class="riga riga--ad">
      <button class="chi-siamo" type="button" data-apre="ov-imagina">Chi siamo</button>
    </div>
    <p class="riga riga--bs">Camerino, Marche · dal 1991</p>

    {/* 5 · IL CENTRO — il logotipo e la visione.
        Nessun antenato con z-index/opacity/transform fra il video e il
        fondale: la scena è solo una griglia di centratura. */}
    <div class="scena">
      <video
        class="logotipo"
        id="logotipo"
        src="/home/imagina-logo.mp4"
        poster="/home/imagina-logo-poster.png"
        muted
        playsinline
        preload="auto"
        aria-hidden="true"
        tabindex="-1"
      ></video>

      <p class="visione" id="visione"><i>Un territorio non si promuove.</i> Si mette in condizione di raccontarsi.</p>
    </div>

    {/* 6 · I DISPACCI — la riga non esiste finché il feed non risponde.
        `hidden` in partenza: se la fetch fallisce o torna vuota resta
        così, e in basso non c'è nessuno scheletro. */}
    <section class="dispacci" id="dispacci" aria-label="Dispacci" hidden>
      <ul id="dispacci-lista"></ul>
    </section>

    {/* 7 · I QUATTRO SEGNI */}
    <nav class="segni" aria-label="I progetti">
      <span class="segni-eti" aria-hidden="true">i progetti</span>
      <ul>
        {segni.map((s) => (
          <li>
            <a class="segno" href={s.href} style={`--acceso: ${s.acceso}`}>
              <svg viewBox="0 0 78.96 78.96" aria-hidden="true"><use href={`#${s.simbolo}`} /></svg>
              <span class="sr-only">{s.nome}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </main>

  {/* L'UNICO SIPARIO RIMASTO: il profilo. I quattro di marchio e quello
      di Mutamenti sono stati rimossi con la v4. */}
  <dialog id="ov-imagina" class="sipario" aria-labelledby="ov-imagina-t">
    <button class="chiudi" type="button" data-chiude aria-label="Chiudi">
      <span aria-hidden="true">×</span>
    </button>
    <div class="sipario-in">
      <h2 class="kicker" id="ov-imagina-t">Imagina Srl Società Benefit</h2>

      <section class="blocco-profilo">
        <h3 class="titoletto">Chi siamo</h3>
        <p class="profilo">Imagina è una società benefit con sede a Camerino, nelle Marche. Dal 1991 lavora nel marketing territoriale e nella comunicazione integrata, con una specializzazione netta su due comparti: l'agroalimentare e il turistico-territoriale.</p>
        <p class="profilo">È una microimpresa che opera su scala internazionale, e la cosa sta in piedi per una ragione precisa: Imagina è il referente di un partenariato pubblico-privato che oggi conta circa trecento entità, pubbliche e private, che si riconoscono nel valore territorio. Non è una rete di patrocini: è la struttura con cui si lavora tutto l'anno.</p>
        <p class="profilo">Da questo trentennio nasce il patrimonio di progettualità che vive sotto il marchio ombrello Tipicità e nelle sue declinazioni — <a href="/tipicita/">Tipicità Festival</a>, il <a href="/grand-tour-delle-marche/">Grand Tour delle Marche</a>, <a href="/tipicita-in-blu/">Tipicità in Blu</a> ed <a href="/evo/">EVO</a>. Quattro progetti autonomi, quattro linguaggi, una sola rete.</p>
      </section>

      <section class="blocco-profilo">
        <h3 class="titoletto">Come lavoriamo</h3>
        <p class="profilo">Contaminazione, osmosi, cross fertilization: è il carburante con cui Imagina attiva processi di networking fra filiere e fra territori. Reti lunghe e reti corte che producono racconti nuovi e occasioni nuove, usando la crossmedialità globale per veicolare specificità locali.</p>
        <p class="profilo">Il metodo ha un ordine e costa tempo. Prima si ascolta cosa dice il territorio, e ci vogliono mesi. Poi si incontrano comunità diverse e si confrontano le differenze invece di appianarle. Poi si mette a fuoco il posizionamento — locale nella sostanza, globale nello sguardo. Solo alla fine si costruiscono azioni su misura, perché nessuna comunità somiglia a un'altra abbastanza da meritare lo stesso formato.</p>
        <p class="profilo">Il lavoro arriva chiavi in mano: analisi di fattibilità, progettazione, coordinamento, organizzazione generale. E arriva da un gruppo di professionisti con esperienza pluriennale in Italia e all'estero nella pianificazione, nella progettazione e nella comunicazione integrata.</p>
      </section>

      <section class="blocco-profilo">
        <h3 class="titoletto">Cosa facciamo</h3>
        <p class="profilo"><b>Marketing e sviluppo territoriale</b> — progetti di marketing, coaching e networking territoriale; creazione e sviluppo di marchi ombrello; processi di cross-fertilization fra filiere; percorsi bottom-up per lo sviluppo turistico; co-creazione degli asset di un territorio; itinerari turistici generali e tematici; progetti di cooperazione transnazionale.</p>
        <p class="profilo"><b>Eventi e format</b> — progettazione, organizzazione e gestione chiavi in mano di festival, congressi, convegni, fiere ed esposizioni; hackathon; corsi di formazione professionale; press tour ed educational tour.</p>
        <p class="profilo"><b>Comunicazione</b> — campagne crossmediali su web, social e direct mailing customizzato; ufficio stampa e rapporti con i media locali, nazionali e di settore; piani di relazioni pubbliche; consulenza di immagine; produzione video; pubblicazioni, dalle guide alle monografie.</p>
      </section>

      <section class="blocco-profilo">
        <h3 class="titoletto">Dove</h3>
        <p class="profilo">Imagina opera in quasi tutte le regioni italiane. Fuori dai confini, una rete di relazioni costruita nel tempo l'ha portata a lavorare in Germania, Francia, Spagna, Regno Unito, Slovenia, Croazia, Montenegro e Albania, e più lontano in Stati Uniti, Canada, Argentina, Emirati Arabi, Norvegia e Giappone.</p>
      </section>

      {/* ⚠️ Questo blocco SPIEGA L'ISTITUTO GIURIDICO, non celebra l'azienda:
          è una richiesta esplicita di Paolo. Chi esce deve aver imparato
          qualcosa che non sapeva. Non accorciare, non alleggerire. */}
      <section class="blocco-profilo">
        <h3 class="titoletto">Che cosa significa essere società benefit</h3>
        <p class="profilo">Società benefit non è una certificazione e non è un premio. È una forma giuridica, introdotta in Italia dalla legge di stabilità 2016 — legge 208/2015, commi 376-384 — che ha fatto dell'Italia il primo Paese europeo ad averla nel proprio ordinamento.</p>
        <p class="profilo">E non è nemmeno il non profit. Una società benefit resta un'impresa che fa utili e li distribuisce. Quello che cambia è l'oggetto sociale: accanto allo scopo di lucro, nello statuto vengono scritte una o più finalità di beneficio comune. Da quel momento non sono più intenzioni. Sono vincoli, e vincolano gli amministratori, che devono bilanciare tre interessi invece di uno solo: quello dei soci, quello delle finalità dichiarate e quello delle persone su cui l'attività dell'impresa ha effetto.</p>
        <p class="profilo">Da qui discendono tre obblighi concreti. Va nominato un responsabile dell'impatto. Va redatta ogni anno una relazione di impatto, allegata al bilancio e pubblicata sul sito. E quella relazione non può essere un racconto: l'impatto va misurato con uno standard di valutazione esterno e indipendente, che copre quattro aree — governance, lavoratori, altri portatori d'interesse, ambiente.</p>
        <p class="profilo">C'è anche una sanzione, ed è la parte che rende la cosa seria. Un'impresa che si dichiara società benefit senza perseguire davvero le finalità che ha scritto ricade nella disciplina della pubblicità ingannevole, sotto la vigilanza dell'Autorità Garante della Concorrenza e del Mercato. Non è un'etichetta che si appende: è un impegno che ha un costo e che qualcuno può venire a verificare.</p>
        <p class="profilo"><b>Per Imagina</b> questo significa una cosa sola, e la si può dire in una riga: la cura del territorio non è il contorno del lavoro, è il lavoro. Valorizzare i talenti di una regione ad ampio spettro — gli artigiani e i ricercatori, i produttori e gli studenti, chi tiene aperta una bottega in un borgo e chi in un laboratorio studia il mare. Il profitto serve a tenere in piedi la struttura; lo scopo è che i territori dove lavoriamo stiano meglio di come li abbiamo trovati.</p>
      </section>

      <div class="piede-blocco">
        <nav class="accessi" aria-label="Approfondimenti e contatti">
          <a href="/note-di-produzione/">Note di produzione</a>
          <a href="/relazione-di-impatto/">Relazione di impatto</a>
          <a href="/entra-in-scena/">Entra in scena</a>
          <a href="mailto:info@anigami.it">info@anigami.it</a>
        </nav>
        <p class="piede">Viale Giacomo Leopardi, 14 – Camerino (MC) · P.IVA/C.F. IT 01115460436</p>
      </div>
    </div>
  </dialog>
</BaseLayout>

<style is:global>
  /* La casa è una sola inquadratura: non si scorre. */
  html, body { height: 100%; overflow: hidden; background: #08090b; }
  /* Il piede classico non esiste in home: vive dentro il sipario. */
  body > footer.site-footer { display: none; }

  /* ══ LE VOCI DEI DISPACCI ══
     Sono create da JavaScript e quindi prive dell'attributo di scoping:
     vanno vestite da qui. Tutto circoscritto a .dispacci, così non
     esce niente dal perimetro della home. */
  .dispacci ul {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    min-height: 3.2em;
  }

  .dispacci li {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease, visibility 0.6s;
  }

  .dispacci li.in-onda { opacity: 1; visibility: visible; }

  .dispacci a {
    pointer-events: auto;
    display: inline-block;
    max-width: 62ch;
    font-family: 'Manrope', sans-serif;
    font-size: 0.78rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: rgba(242, 239, 233, 0.72);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .dispacci a:hover {
    color: #f2efe9;
    border-bottom-color: rgba(242, 239, 233, 0.22);
  }

  .dispacci a:focus-visible { outline: 2px solid #f2efe9; outline-offset: 4px; }

  .dispacci .quando {
    display: block;
    font-family: 'Manrope', sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(242, 239, 233, 0.55);
    margin-bottom: 0.35rem;
  }

  @media (max-width: 760px) {
    .dispacci a { font-size: 0.72rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dispacci li { transition: none; }
  }
</style>

<style>
  /* ══ IL CAMPO ══
     ⚠️ Dentro .casa non c'è UN SOLO z-index, e non ci deve andare: i
     livelli sono l'ordine del DOM. Basta un z-index qui per rompere il
     mix-blend-mode del logotipo. */
  .casa {
    position: fixed;
    inset: 0;
    background: var(--bg-void);
    overflow: hidden;
  }

  /* ── il fondale ── */
  .fondale {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 28%: la soglia trovata a schermo col fotogramma più chiaro. Se la
       riga di visione fatica si scende di qui, non si ingrandisce il testo. */
    opacity: 0.32;
    pointer-events: none;
  }

  /* ── la vignetta: è lei che tiene leggibile tutto ── */
  .vignetta {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 82% 72% at 50% 46%, rgba(8, 9, 11, 0.22) 0%, rgba(8, 9, 11, 0.80) 74%, rgba(8, 9, 11, 0.93) 100%),
      linear-gradient(180deg, rgba(8, 9, 11, 0.75) 0%, transparent 22%, transparent 74%, rgba(8, 9, 11, 0.85) 100%);
  }

  /* ── la cornice: un fotogramma ── */
  .cornice {
    position: absolute;
    inset: 20px;
    border: 1px solid var(--hairline);
    pointer-events: none;
  }

  /* le quattro tacche d'angolo, marcate */
  .tacca { position: absolute; width: 14px; height: 14px; }
  .tacca::before, .tacca::after {
    content: '';
    position: absolute;
    background: var(--text-soft);
  }
  .tacca::before { width: 14px; height: 1px; }
  .tacca::after { width: 1px; height: 14px; }
  .tacca--as { top: -1px; left: -1px; }
  .tacca--ad { top: -1px; right: -1px; }
  .tacca--ad::before { right: 0; } .tacca--ad::after { right: 0; }
  .tacca--bs { bottom: -1px; left: -1px; }
  .tacca--bs::before { bottom: 0; } .tacca--bs::after { bottom: 0; }
  .tacca--bd { bottom: -1px; right: -1px; }
  .tacca--bd::before { bottom: 0; right: 0; } .tacca--bd::after { bottom: 0; right: 0; }

  /* ── le righe in cornice ── */
  .riga {
    position: absolute;
    margin: 0;
    font-family: 'Manrope', sans-serif;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .riga--as { top: 44px; left: 46px; }
  .riga--ad { top: 38px; right: 46px; }
  .riga--bs { bottom: 44px; left: 46px; }

  .chi-siamo {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--text-soft);
    background: none;
    border: 0;
    padding: 0.4rem 0;
    cursor: pointer;
    border-bottom: 1px solid var(--hairline);
  }

  .chi-siamo:hover { border-bottom-color: var(--text-soft); }
  .chi-siamo:focus-visible { outline: 2px solid var(--text-soft); outline-offset: 4px; }

  /* ── il centro ──
     Solo centratura: niente z-index, opacity o transform, altrimenti il
     logotipo perde il fondale con cui deve fondersi. */
  .scena {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: clamp(1.4rem, 3.2vh, 2.6rem);
    padding: 0 clamp(1.6rem, 6vw, 4rem);
    pointer-events: none;
  }

  /* IL LOGOTIPO. Bianco su nero + screen: il nero sparisce e resta il
     segno luminoso, senza rettangolo. */
  .logotipo {
    display: block;
    width: min(56vw, 620px);
    height: auto;
    aspect-ratio: 1280 / 720;
    mix-blend-mode: screen;
  }

  /* Il video del logotipo ha parecchio nero attorno al segno: in screen
     è invisibile, ma nel flusso occupa. Il margine negativo recupera
     quello spazio e riavvicina la riga al logotipo. */
  .visione {
    margin: clamp(-5.5vh, -4vh, -2rem) 0 0;
    max-width: 22ch;
    text-align: center;
    text-wrap: balance;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: clamp(1.5rem, 3.4vw, 2.5rem);
    line-height: 1.28;
    color: var(--text-soft);
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  .visione.entra { opacity: 1; }
  .visione i { font-style: italic; }

  /* ── i dispacci ──
     Uno alla volta a ogni larghezza: dodici titoli in fila non entrano
     da nessuna parte, e un ticker che scorre è illeggibile sul telefono.
     Sono link veri: quello in vista è raggiungibile col Tab, gli altri
     restano fuori dall'ordine di tabulazione. */
  .dispacci {
    position: absolute;
    left: 46px;
    right: 46px;
    bottom: 92px;
    text-align: center;
    pointer-events: none;
  }

  .dispacci[hidden] { display: none; }

  /* ⚠️ Le voci dei dispacci nascono da JavaScript, quindi NON ricevono
     l'attributo di scoping di Astro: se i loro stili stanno qui non si
     applicano affatto. Stanno nel blocco is:global in fondo al file,
     circoscritti a .dispacci. */

  /* ── i quattro segni ── */
  .segni {
    position: absolute;
    right: 46px;
    bottom: 40px;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .segni-eti {
    font-family: 'Manrope', sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .segni ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .segno {
    display: grid;
    place-items: center;
    box-sizing: content-box;
    width: 27px;
    height: 27px;
    /* bersaglio 44×44 senza cambiare la dimensione del segno */
    padding: 8px;
    margin: -8px;
    --mk-tile: transparent;
    --mk-ink: rgba(242, 239, 233, 0.52);
    transition: transform 0.22s ease;
  }

  .segno svg { display: block; width: 100%; height: 100%; }

  .segno:hover, .segno:focus-visible {
    transform: translateY(-2px);
    --mk-tile: var(--acceso);
    --mk-ink: var(--bg-void);
  }

  .segno:focus-visible { outline: 2px solid var(--text-soft); outline-offset: 3px; border-radius: 4px; }

  /* ══ IL SIPARIO DEL PROFILO ══ */
  .sipario {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: auto;
    overscroll-behavior: contain;
    background: var(--bg-void);
    color: var(--text-soft);
  }

  .sipario::backdrop { background: transparent; }
  .sipario[open] { animation: taglio 0.28s cubic-bezier(0.2, 0, 0, 1) both; }

  @keyframes taglio {
    from { clip-path: inset(0 0 100% 0); }
    to   { clip-path: inset(0 0 0 0); }
  }

  .sipario-in {
    min-height: 100%;
    max-width: 60ch;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    justify-content: safe center;
    padding: clamp(4.5rem, 9vh, 6rem) clamp(1.4rem, 6vw, 3rem) clamp(2.5rem, 6vh, 4rem);
  }

  .chiudi {
    position: absolute;
    top: clamp(0.9rem, 2.4vw, 1.6rem);
    right: clamp(0.9rem, 2.4vw, 1.6rem);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    font-size: 1.7rem;
    line-height: 1;
    color: inherit;
    background: none;
    border: 0;
    opacity: 0.6;
    cursor: pointer;
  }

  .chiudi:hover { opacity: 1; }
  .chiudi:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; opacity: 1; }

  .kicker {
    font-family: 'Manrope', sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin: 0 0 2.2rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--hairline);
  }

  .blocco-profilo { margin: 0 0 2.4rem; }

  .titoletto {
    font-family: 'Manrope', sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--imagina-ink);
    margin: 0 0 0.9rem;
  }

  .profilo {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: clamp(1.02rem, 1.6vw, 1.18rem);
    line-height: 1.55;
    color: var(--text-soft);
    margin: 0 0 1rem;
  }

  .profilo:last-child { margin-bottom: 0; }
  .profilo b { font-weight: 700; }

  .profilo a {
    color: var(--imagina-ink);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--imagina-ink) 45%, transparent);
  }

  .profilo a:hover { border-bottom-color: var(--imagina-ink); }
  .profilo a:focus-visible { outline: 2px solid var(--imagina-ink); outline-offset: 3px; }

  .piede-blocco {
    position: sticky;
    bottom: 0;
    margin-top: 2.4rem;
    padding-bottom: 0.4rem;
    background: var(--bg-void);
  }

  .piede-blocco::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 2rem;
    background: linear-gradient(to top, var(--bg-void), transparent);
    pointer-events: none;
  }

  .accessi {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--hairline);
    font-family: 'Manrope', sans-serif;
    font-size: 0.82rem;
  }

  .accessi a {
    color: var(--text-dim);
    text-decoration: none;
    padding: 0.3rem 0;
  }

  .accessi a:hover { color: var(--imagina-ink); }
  .accessi a:focus-visible { outline: 2px solid var(--imagina-ink); outline-offset: 3px; }

  .piede {
    margin: 1.4rem 0 0;
    font-family: 'Manrope', sans-serif;
    font-size: 0.7rem;
    color: var(--text-dim);
  }

  /* ══ TELEFONO (§10) ══ */
  @media (max-width: 760px) {
    .cornice { inset: 12px; }
    .riga { font-size: 0.62rem; letter-spacing: 0.12em; }
    .riga--as { top: 28px; left: 28px; right: 28px; }
    .riga--ad { top: 24px; right: 28px; }
    .riga--bs { display: none; }

    .logotipo { width: 78vw; }
    .visione { max-width: 18ch; }

    .dispacci { left: 24px; right: 24px; bottom: 104px; }

    /* i quattro segni scendono in basso al centro */
    .segni {
      right: auto;
      left: 50%;
      transform: translateX(-50%);
      bottom: 34px;
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  /* ══ REDUCED MOTION ══
     Niente video: le due pose, ferme. Il logotipo resta in screen, così
     il poster con alfa non porta rettangoli. */
  @media (prefers-reduced-motion: reduce) {
    .visione { transition: none; }
    .segno { transition: none; }
  }
</style>

<script>
  // ══ LA REGIA DELLA CASA ══
  function casa() {
    const campo = document.querySelector('.casa');
    if (!campo || campo.dataset.on) return;
    campo.dataset.on = '1';

    const ridotto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // risparmio dati: se il browser lo dichiara, niente video
    const risparmio = navigator.connection && navigator.connection.saveData === true;
    const fermo = ridotto || risparmio;

    const logo = document.getElementById('logotipo');
    const fondale = document.getElementById('fondale');
    const visione = document.getElementById('visione');

    // ── il logotipo: si compone UNA volta sola, poi resta ──
    // Alla seconda visita non si ricompone: il poster è l'ultimo
    // fotogramma, quindi basta non farlo partire.
    let giaVisto = false;
    try { giaVisto = sessionStorage.getItem('casa-logo') === '1'; } catch {}

    function mostraVisione() { visione.classList.add('entra'); }

    if (fermo || giaVisto) {
      mostraVisione();
    } else {
      logo.addEventListener('ended', () => {
        mostraVisione();
        try { sessionStorage.setItem('casa-logo', '1'); } catch {}
      }, { once: true });
      const p = logo.play();
      if (p && p.catch) p.catch(() => mostraVisione());
    }

    if (!fermo) {
      const f = fondale.play();
      if (f && f.catch) f.catch(() => {});
    }

    // ── il sipario del profilo ──
    // <dialog> nativo: trappola del fuoco, ESC, aria-modal e ritorno del
    // fuoco alla voce d'origine li dà il browser. Qui resta la history:
    // aprire impila, il back del browser chiude invece di uscire.
    const sipario = document.getElementById('ov-imagina');
    let aperto = false, impilato = false, guardia = false;

    function apri(daAncora) {
      if (aperto) return;
      aperto = true;
      sipario.showModal();
      guardia = true;
      if (daAncora) { history.replaceState({ sipario: 1 }, '', '#chi-siamo'); impilato = false; }
      else { history.pushState({ sipario: 1 }, '', '#chi-siamo'); impilato = true; }
      guardia = false;
    }

    function chiudi(daHistory) {
      if (!aperto) return;
      aperto = false;
      sipario.close();
      if (daHistory) return;
      if (impilato) { impilato = false; guardia = true; history.back(); }
      else history.replaceState({}, '', location.pathname + location.search);
    }

    document.querySelectorAll('[data-apre]').forEach((b) => b.addEventListener('click', () => apri(false)));
    sipario.querySelector('[data-chiude]').addEventListener('click', () => chiudi(false));
    sipario.addEventListener('click', (e) => { if (e.target === sipario) chiudi(false); });
    // ESC e ogni altra chiusura nativa devono rimettere in pari la history
    sipario.addEventListener('close', () => { if (aperto) chiudi(false); });

    // in cattura: le View Transitions di Astro ascoltano popstate in
    // bolla, e i nostri stati non sono affari loro
    window.addEventListener('popstate', (e) => {
      const nostro = e.state && e.state.sipario;
      if (!guardia && !aperto && !nostro) return;
      e.stopImmediatePropagation();
      if (guardia) { guardia = false; return; }
      if (nostro) { apri(true); return; }
      if (aperto) chiudi(true);
    }, true);

    if (location.hash === '#chi-siamo') apri(true);

    // ── i dispacci ──
    // Se il feed non risponde o è vuoto la riga non compare: la sezione
    // resta `hidden` e in basso non c'è nessuno scheletro.
    const zona = document.getElementById('dispacci');
    const lista = document.getElementById('dispacci-lista');

    fetch('/api/dispacci?categoria=0')
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        const voci = (d && d.dispacci) || [];
        if (!voci.length) return;

        voci.forEach((v) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = v.link;
          a.rel = 'noopener';
          const quando = document.createElement('span');
          quando.className = 'quando';
          const dt = new Date(v.data);
          quando.textContent = Number.isNaN(dt.getTime())
            ? ''
            : dt.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
          a.appendChild(quando);
          a.appendChild(document.createTextNode(v.titolo));
          li.appendChild(a);
          lista.appendChild(li);
        });

        zona.hidden = false;
        const voci_li = Array.from(lista.children);
        let i = 0;
        voci_li[0].classList.add('in-onda');

        // Ruota ogni sei secondi in dissolvenza. Si ferma al passaggio e
        // al fuoco: chi legge o chi naviga da tastiera deve poter fermare.
        let timer = null;
        const gira = () => {
          voci_li[i].classList.remove('in-onda');
          i = (i + 1) % voci_li.length;
          voci_li[i].classList.add('in-onda');
        };
        const via = () => { if (!timer && voci_li.length > 1) timer = setInterval(gira, 6000); };
        const stop = () => { clearInterval(timer); timer = null; };
        zona.addEventListener('mouseenter', stop);
        zona.addEventListener('mouseleave', via);
        zona.addEventListener('focusin', stop);
        zona.addEventListener('focusout', via);
        via();
      })
      .catch(() => { /* fallback silenzioso: la riga non compare */ });
  }

  document.addEventListener('astro:page-load', casa);
  casa();
</script>
