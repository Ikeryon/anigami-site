---
import BaseLayout from '../layouts/BaseLayout.astro';

// ══════════════════════════════════════════════════════════════════════
// LA HOME — IL PALCOSCENICO (BRIEF-HOME.md, tavolo del 07/08/2026)
//
// Una sola inquadratura, nessuno scroll. Il bianco #faf9f6 è il palco
// vuoto; al centro l'unico gesto (il logo che si compone, UNA volta);
// tutto il resto sono cose da APRIRE, non da scorrere. Ogni apertura è
// un taglio di montaggio a copertura piena, ogni chiusura riporta al
// palco. I due soli verbi di regia: il TAGLIO (cambio di punto di
// vista) e la DISSOLVENZA (non-ritorno).
//
// ⚠️ REGOLE SOVRANE — la parola "anigami" non compare mai (vive solo
// in info@anigami.it); mai "quattro festival" (sono i progetti
// principali); i giochi di senso non si spiegano.
//
// Il footer classico NON esiste in home: vive dentro l'overlay Imagina.
// I quattro nomi restano <a> veri verso le landing: senza JS il sito è
// integralmente navigabile e le route esistenti restano raggiungibili.
// ══════════════════════════════════════════════════════════════════════

// I quattro progetti. `verso` = il dato di metodo che il pubblico non
// vede (BRIEF-HOME §5, trascritto tale e quale: non si riformula).
// `campo` = la cromia del marchio che si accende sul palco bianco.
const progetti = [
  {
    id: 'tipicita',
    nome: 'Tipicità',
    href: '/tipicita/',
    verso: 'otto mesi di produzione per tre giorni di festival',
    riga: 'Il festival delle traiettorie indigene. Fermo, dal 1993.',
    logo: '/logos/tipicita-wordmark-white.svg',
    logoW: 662,
    logoH: 201,
    campo: '#035f6a',
    inchiostro: '#fcfcfa',
  },
  {
    id: 'grand-tour',
    nome: 'Grand Tour delle Marche',
    href: '/grand-tour-delle-marche/',
    verso: 'ciò che resta quando è già ripartito',
    riga: 'Un itinerario che dura una stagione: 73 comuni e la strada continua.',
    logo: '/logos/grand-tour.svg',
    logoW: 257,
    logoH: 103,
    // ⚠️ DECISIONE DA VALIDARE CON PAOLO. Il Grand Tour è l'unico dei
    // quattro senza un colore pieno nella propria cromia: la sua carta
    // calda #fbf4ec è indistinguibile dal bianco del palco, e il corallo
    // #ee726c/#d1544c non regge il testo (2,6:1 e 3,8:1, sotto l'AA).
    // Si usa allora il suo inchiostro, il bruno caldo #2b1d16 già
    // dichiarato come --text-soft della landing: il nastro corallo del
    // marchio si accende, e tutto il testo passa (14,8:1).
    // Alternativa provata e scartata: campo sabbia #f4e8da con il logo a
    // colori — corretto ma senza il "taglio" del colore pieno.
    campo: '#2b1d16',
    inchiostro: '#fbf4ec',
  },
  {
    id: 'tipicita-in-blu',
    nome: 'Tipicità in Blu',
    href: '/tipicita-in-blu/',
    verso: "due sponde dell'Adriatico, un solo cantiere",
    riga: 'Mare, laboratorio di futuro. Ancona, la Mole, la rotta.',
    logo: '/logos/tipicita-in-blu-white.svg',
    logoW: 259,
    logoH: 76,
    campo: '#112f49',
    inchiostro: '#eaf2f6',
  },
  {
    id: 'evo',
    nome: 'EVO',
    href: '/evo/',
    verso: 'si impara a cooperare giocando',
    riga: 'I linguaggi del gioco. Macerata, ogni dicembre.',
    logo: '/logos/evo.svg',
    logoW: 435,
    logoH: 140,
    campo: '#7f1244',
    inchiostro: '#f6e7ee',
  },
];

// MUTAMENTI — feed statico finché non arriva Directus (BRIEF-HOME §2).
// ⚠️ NESSUN DATO INVENTATO: ogni riga è un fatto già presente e
// approvato altrove nel sito (note di produzione, landing EVO e GT,
// schema.org di Tipicità). Da sostituire col feed vero.
const mutamenti = [
  { data: '12–14 marzo 2027', testo: 'Tipicità, Fermo.' },
  { data: '2026', testo: 'Grand Tour delle Marche, tredicesima edizione.' },
  { data: '1 luglio 2026', testo: 'La trasformazione in Società Benefit è effettiva.' },
  { data: 'dicembre 2025', testo: 'EVO, i linguaggi del gioco: piazza e centro storico di Macerata diventano uno spazio di gioco all’aperto.' },
];

// Bianco luminoso: non un #fff da laboratorio, una carta calda.
const theme = {
  '--bg-void': '#faf9f6',
  '--bg-deep': '#f0eee8',
  '--bg-mid': '#e7e4db',
  '--text-soft': '#1b1a1f',
  '--text-dim': 'rgba(27, 26, 31, 0.66)',
  '--text-faint': 'rgba(27, 26, 31, 0.42)',
  // Il magenta del marchio (#e6007e) sulla carta sta a 4,27:1: sotto l'AA
  // per il testo piccolo. Dove il magenta fa da inchiostro si usa questo
  // tono scurito (5,8:1); il gradiente resta quello ufficiale.
  '--imagina-ink': '#c1006a',
  '--hairline': 'rgba(27, 26, 31, 0.13)',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Imagina Srl Società Benefit',
  url: 'https://anigami.it',
  email: 'info@anigami.it',
  foundingDate: '1991',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Viale Giacomo Leopardi, 14',
    addressLocality: 'Camerino',
    addressRegion: 'Marche',
    postalCode: '62032',
    addressCountry: 'IT',
  },
  vatID: 'IT01115460436',
};
---

<BaseLayout
  title="Imagina Srl Società Benefit"
  description="Imagina Srl Società Benefit, Camerino: dal 1991 progetta e produce piattaforme di valorizzazione territoriale. La struttura di produzione dietro Tipicità, Grand Tour delle Marche, Tipicità in Blu ed EVO."
  theme={theme}
  structuredData={structuredData}
>
  <main class="palco">
    <h1 class="sr-only">Imagina Srl Società Benefit</h1>

    <!-- ══ ALTO DESTRA · le voci della casa ══ -->
    <div class="cornice">
      <a class="voce-casa" href="/note-di-produzione/" data-apre="ov-imagina">Imagina</a>
      <button class="voce-minore" type="button" data-apre="ov-mutamenti">Mutamenti</button>
    </div>

    <!-- ══ CENTRO · il logo che si compone, una volta sola ══ -->
    <div class="scena">
      <video
        id="hero"
        class="hero"
        width="1920"
        height="1080"
        muted
        playsinline
        preload="metadata"
        poster="/home/hero-imagina-poster.jpg"
        aria-label="Il logo di Imagina che si compone"
      >
        <source src="/home/hero-imagina.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- ══ BASSO · le quattro voci, sola tipografia ══ -->
    <nav class="voci" aria-label="I progetti principali">
      <ul>
        {progetti.map((p) => (
          <li>
            {/* il nome PRIMA del verso nel DOM: il verso è fuori flusso
                (position: absolute), quindi la resa non cambia, ma il nome
                accessibile del link comincia dal nome del progetto. */}
            <a class="voce" href={p.href} data-apre={`ov-${p.id}`}>
              <span class="nome">{p.nome}</span>
              <span class="verso">{p.verso}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </main>

  <!-- ══════════ I SIPARI ══════════ -->

  <!-- Il profilo della casa: qui dentro vive anche il piede pagina. -->
  <dialog id="ov-imagina" class="sipario sipario--casa" aria-labelledby="ov-imagina-t">
    <button class="chiudi" type="button" data-chiude aria-label="Chiudi">
      <span aria-hidden="true">×</span>
    </button>
    <div class="sipario-in casa-in">
      <h2 class="kicker" id="ov-imagina-t">Imagina Srl Società Benefit</h2>

      {/* PROFILO v2 (BRIEF-HOME §4, 07/08 — fonte: Company Profile 2025).
          Cinque blocchi con titoletti brevi: il profilo è l'unico punto del
          sito in cui Imagina parla di sé, e chi lo apre sta probabilmente
          valutando se lavorare con voi. Si scansiona, non si legge tutto
          d'un fiato. Testi trascritti tali e quali. */}

      <section class="blocco-profilo">
        <h3 class="titoletto">Chi siamo</h3>
        <p class="profilo">Imagina è una società benefit con sede a Camerino, nelle Marche. Dal 1991 lavora nel marketing territoriale e nella comunicazione integrata, con una specializzazione netta su due comparti: l'agroalimentare e il turistico-territoriale.</p>
        <p class="profilo">È una microimpresa che opera su scala internazionale, e la cosa sta in piedi per una ragione precisa: Imagina è il referente di un partenariato pubblico-privato che oggi conta circa trecento entità, pubbliche e private, che si riconoscono nel valore territorio. Non è una rete di patrocini: è la struttura con cui si lavora tutto l'anno.</p>
        <p class="profilo">Da questo trentennio nasce il patrimonio di progettualità che vive sotto il marchio ombrello Tipicità e nelle sue declinazioni — <a href="/tipicita/">Tipicità Festival</a>, il <a href="/grand-tour-delle-marche/">Grand Tour delle Marche</a>, <a href="/tipicita-in-blu/">Tipicità in Blu</a> ed <a href="/evo/">EVO</a>. Quattro progetti autonomi, quattro linguaggi, una sola rete.</p>
      </section>

      <section class="blocco-profilo">
        <h3 class="titoletto">Come lavoriamo</h3>
        <p class="profilo">Contaminazione, osmosi, cross fertilization: è il carburante con cui Imagina attiva processi di networking fra filiere e fra territori. Reti lunghe e reti corte che producono racconti nuovi e occasioni nuove, usando la crossmedialità globale per veicolare specificità locali.</p>
        <p class="profilo">Il metodo ha un ordine e costa tempo. Prima si ascolta cosa dice il territorio, e ci vogliono mesi. Poi si incontrano comunità diverse e si confrontano le differenze invece di appianarle. Poi si mette a fuoco il posizionamento — locale nella sostanza, globale nello sguardo. Solo alla fine si costruiscono azioni su misura, perché nessuna comunità somiglia a un'altra abbastanza da meritare lo stesso formato.</p>
        <p class="profilo">Il lavoro arriva chiavi in mano: analisi di fattibilità, progettazione, coordinamento, organizzazione generale. E arriva da un gruppo di professionisti con esperienza pluriennale in Italia e all'estero nella pianificazione, nella progettazione e nella comunicazione integrata.</p>
      </section>

      <section class="blocco-profilo">
        <h3 class="titoletto">Cosa facciamo</h3>
        <p class="profilo"><b>Marketing e sviluppo territoriale</b> — progetti di marketing, coaching e networking territoriale; creazione e sviluppo di marchi ombrello; processi di cross-fertilization fra filiere; percorsi bottom-up per lo sviluppo turistico; co-creazione degli asset di un territorio; itinerari turistici generali e tematici; progetti di cooperazione transnazionale.</p>
        <p class="profilo"><b>Eventi e format</b> — progettazione, organizzazione e gestione chiavi in mano di festival, congressi, convegni, fiere ed esposizioni; hackathon; corsi di formazione professionale; press tour ed educational tour.</p>
        <p class="profilo"><b>Comunicazione</b> — campagne crossmediali su web, social e direct mailing customizzato; ufficio stampa e rapporti con i media locali, nazionali e di settore; piani di relazioni pubbliche; consulenza di immagine; produzione video; pubblicazioni, dalle guide alle monografie.</p>
      </section>

      <section class="blocco-profilo">
        <h3 class="titoletto">Dove</h3>
        <p class="profilo">Imagina opera in quasi tutte le regioni italiane. Fuori dai confini, una rete di relazioni costruita nel tempo l'ha portata a lavorare in Germania, Francia, Spagna, Regno Unito, Slovenia, Croazia, Montenegro e Albania, e più lontano in Stati Uniti, Canada, Argentina, Emirati Arabi, Norvegia e Giappone.</p>
      </section>

      {/* ⚠️ Questo blocco SPIEGA L'ISTITUTO GIURIDICO, non celebra l'azienda:
          è una richiesta esplicita di Paolo. Chi esce deve aver imparato
          qualcosa che non sapeva, non essersi fatto un'idea di quanto siamo
          bravi. Per questo la forma giuridica viene prima, e solo alla fine
          si dice cosa comporta per Imagina. Non accorciare, non alleggerire. */}
      <section class="blocco-profilo">
        <h3 class="titoletto">Che cosa significa essere società benefit</h3>
        <p class="profilo">Società benefit non è una certificazione e non è un premio. È una forma giuridica, introdotta in Italia dalla legge di stabilità 2016 — legge 208/2015, commi 376-384 — che ha fatto dell'Italia il primo Paese europeo ad averla nel proprio ordinamento.</p>
        <p class="profilo">E non è nemmeno il non profit. Una società benefit resta un'impresa che fa utili e li distribuisce. Quello che cambia è l'oggetto sociale: accanto allo scopo di lucro, nello statuto vengono scritte una o più finalità di beneficio comune. Da quel momento non sono più intenzioni. Sono vincoli, e vincolano gli amministratori, che devono bilanciare tre interessi invece di uno solo: quello dei soci, quello delle finalità dichiarate e quello delle persone su cui l'attività dell'impresa ha effetto.</p>
        <p class="profilo">Da qui discendono tre obblighi concreti. Va nominato un responsabile dell'impatto. Va redatta ogni anno una relazione di impatto, allegata al bilancio e pubblicata sul sito. E quella relazione non può essere un racconto: l'impatto va misurato con uno standard di valutazione esterno e indipendente, che copre quattro aree — governance, lavoratori, altri portatori d'interesse, ambiente.</p>
        <p class="profilo">C'è anche una sanzione, ed è la parte che rende la cosa seria. Un'impresa che si dichiara società benefit senza perseguire davvero le finalità che ha scritto ricade nella disciplina della pubblicità ingannevole, sotto la vigilanza dell'Autorità Garante della Concorrenza e del Mercato. Non è un'etichetta che si appende: è un impegno che ha un costo e che qualcuno può venire a verificare.</p>
        <p class="profilo"><b>Per Imagina</b> questo significa una cosa sola, e la si può dire in una riga: la cura del territorio non è il contorno del lavoro, è il lavoro. Valorizzare i talenti di una regione ad ampio spettro — gli artigiani e i ricercatori, i produttori e gli studenti, chi tiene aperta una bottega in un borgo e chi in un laboratorio studia il mare. Il profitto serve a tenere in piedi la struttura; lo scopo è che i territori dove lavoriamo stiano meglio di come li abbiamo trovati.</p>
      </section>

      <!-- il piede di sito: resta agganciato in basso mentre il profilo
           scorre, così gli accessi non finiscono mai fuori campo -->
      <div class="piede-blocco">
        <nav class="accessi" aria-label="Approfondimenti e contatti">
          <a href="/note-di-produzione/">Note di produzione</a>
          <a href="/entra-in-scena/">Entra in scena</a>
          <button type="button" data-apre="ov-mutamenti" data-sostituisce>Mutamenti</button>
          <a href="mailto:info@anigami.it">info@anigami.it</a>
        </nav>
        <p class="piede">Viale Giacomo Leopardi, 14 – Camerino (MC) · P.IVA/C.F. IT 01115460436</p>
      </div>
    </div>
  </dialog>

  <!-- I quattro sipari di marchio: campo pieno, logo, una riga, Entra. -->
  {progetti.map((p) => (
    <dialog
      id={`ov-${p.id}`}
      class="sipario sipario--marchio"
      aria-label={p.nome}
      style={`--campo: ${p.campo}; --inchiostro: ${p.inchiostro}`}
    >
      <button class="chiudi" type="button" data-chiude aria-label="Chiudi">
        <span aria-hidden="true">×</span>
      </button>
      <div class="sipario-in marchio-in">
        <p class="verso-tocco">{p.verso}</p>
        <img class="marchio" src={p.logo} alt={p.nome} width={p.logoW} height={p.logoH} />
        <p class="riga">{p.riga}</p>
        <a class="entra" href={p.href}>Entra <span aria-hidden="true">→</span></a>
      </div>
    </dialog>
  ))}

  <!-- Mutamenti: unico sipario che entra in dissolvenza, non di taglio. -->
  <dialog id="ov-mutamenti" class="sipario sipario--mutamenti" aria-labelledby="ov-mutamenti-t">
    <button class="chiudi" type="button" data-chiude aria-label="Chiudi">
      <span aria-hidden="true">×</span>
    </button>
    <div class="sipario-in mutamenti-in">
      <h2 class="kicker" id="ov-mutamenti-t">Mutamenti</h2>
      <ul class="feed">
        {mutamenti.map((m) => (
          <li>
            <span class="quando">{m.data}</span>
            <span class="cosa">{m.testo}</span>
          </li>
        ))}
      </ul>
    </div>
  </dialog>
</BaseLayout>

<style is:global>
  /* La home è UNA inquadratura: non si scorre, in nessuna direzione. */
  html, body { height: 100%; overflow: hidden; }
  /* Il footer classico non esiste in home: vive dentro il sipario Imagina. */
  body > footer.site-footer { display: none; }
</style>

<style>
  /* ══ IL PALCO ══
     Tre fasce: la cornice in alto, la scena al centro (che prende tutto
     lo spazio residuo), le voci in basso. Nessuna misura dipende dal
     caricamento del video → zero layout shift. */
  .palco {
    position: fixed;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: var(--bg-void);
  }

  /* ── alto destra: la casa e la voce minore ── */
  .cornice {
    justify-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.35rem;
    padding: clamp(1.1rem, 2.6vw, 1.9rem) clamp(1.2rem, 3vw, 2.4rem) 0;
  }

  .voce-casa {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    line-height: 1.1;
    color: var(--text-soft);
    text-decoration: none;
    padding: 0.2rem 0;
  }

  .voce-minore {
    font-family: 'Manrope', sans-serif;
    font-size: 0.63rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    /* --text-dim e non --text-faint: a 10px maiuscoletto il faint sta a
       2,5:1 sulla carta, sotto il minimo AA. */
    color: var(--text-dim);
    background: none;
    border: 0;
    padding: 0.25rem 0;
    cursor: pointer;
  }

  .voce-casa:hover, .voce-minore:hover { color: var(--imagina-ink); }

  .voce-casa:focus-visible,
  .voce-minore:focus-visible {
    outline: 2px solid var(--imagina-ink);
    outline-offset: 3px;
  }

  /* ── centro: il logo che si compone ──
     Il fondo del video È il fondo pagina: nessun bordo, nessuna ombra,
     nessun raggio. object-fit: contain con max-height fa "letterbox"
     su un colore identico → invisibile. */
  .scena {
    display: grid;
    place-items: center;
    min-height: 0;
    padding: 0 1.2rem;
  }

  /* width in percentuale (non in vw): il vw ignora il padding della scena
     e faceva sfondare la colonna della griglia di 15px sul telefono. */
  .hero {
    display: block;
    width: 100%;
    max-width: 1040px;
    height: auto;
    aspect-ratio: 16 / 9;
    max-height: min(58svh, 585px);
    object-fit: contain;
    background: var(--bg-void);
  }

  /* ── basso: le quattro voci ──
     Il verso è fuori dal flusso (position: absolute nello slot condiviso
     sopra i nomi): compare e sparisce senza spostare un pixel. Nessuna
     transizione = è un taglio, non una dissolvenza. */
  .voci {
    position: relative;
    padding: 3.4rem clamp(1.2rem, 4vw, 2.4rem) clamp(2.2rem, 6vh, 4rem);
  }

  .voci ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0 clamp(0.9rem, 2.4vw, 1.8rem);
  }

  .voci li { display: flex; align-items: baseline; }

  .voci li:not(:last-child)::after {
    content: '·';
    color: var(--text-faint);
    margin-left: clamp(0.9rem, 2.4vw, 1.8rem);
  }

  .voce {
    display: block;
    text-decoration: none;
    padding: 0.35rem 0;
  }

  .nome {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: clamp(1.1rem, 2.3vw, 1.85rem);
    line-height: 1.15;
    color: var(--text-soft);
  }

  /* Il taglio dell'attenzione: chi non è puntato scende in sordina.
     --text-dim e non --text-faint: le voci restano link leggibili anche
     da spente (il faint le porterebbe a 2,5:1). */
  .voci ul:hover .nome { color: var(--text-dim); }
  .voci ul .voce:hover .nome { color: var(--text-soft); }

  .verso {
    position: absolute;
    left: 0;
    right: 0;
    top: 0.9rem;
    text-align: center;
    font-family: 'Manrope', sans-serif;
    font-size: clamp(0.74rem, 1.4vw, 0.86rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.4;
    color: var(--text-dim);
    opacity: 0;
    pointer-events: none;
  }

  .voce:hover .verso,
  .voce:focus-visible .verso { opacity: 1; }

  .voce:focus-visible {
    outline: 2px solid var(--imagina-ink);
    outline-offset: 4px;
  }

  /* ══ I SIPARI ══
     <dialog> nativo: focus trap, ESC, aria-modal e ritorno del focus
     alla voce d'origine li dà il browser. Qui restano il taglio, la
     cromia e la chiusura fuori campo. */
  .sipario {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: auto;
    overscroll-behavior: contain;
    background: var(--campo, var(--bg-void));
    color: var(--inchiostro, var(--text-soft));
  }

  .sipario::backdrop { background: transparent; }

  /* IL TAGLIO — copertura piena in 280ms, easing secco, niente rimbalzo.
     Il sipario cala dall'alto e copre il palco. */
  .sipario[open] { animation: taglio 0.28s cubic-bezier(0.2, 0, 0, 1) both; }

  @keyframes taglio {
    from { clip-path: inset(0 0 100% 0); }
    to   { clip-path: inset(0 0 0 0); }
  }

  /* LA DISSOLVENZA — solo per Mutamenti (e per il logo). */
  .sipario--mutamenti[open] { animation: dissolvenza 0.32s ease both; }

  @keyframes dissolvenza {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .sipario-in {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    /* "safe": quando il contenuto è più alto della finestra si allinea in
       alto invece di far sparire il capo oltre il bordo superiore. */
    justify-content: center;
    justify-content: safe center;
    padding: clamp(4.5rem, 9vh, 6rem) clamp(1.4rem, 6vw, 3rem) clamp(2.5rem, 6vh, 4rem);
  }

  .chiudi {
    position: absolute;
    top: clamp(0.9rem, 2.4vw, 1.6rem);
    right: clamp(0.9rem, 2.4vw, 1.6rem);
    z-index: 2;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    font-size: 1.7rem;
    line-height: 1;
    color: inherit;
    background: none;
    border: 0;
    opacity: 0.6;
    cursor: pointer;
  }

  .chiudi:hover { opacity: 1; }
  .chiudi:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; opacity: 1; }

  /* --text-dim e non --text-faint: a 11px maiuscoletto spaziato il faint
     resta sotto il minimo AA sulla carta. */
  .kicker {
    font-family: 'Manrope', sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin: 0 0 1.6rem;
  }

  /* ── il sipario della casa ── */
  .casa-in { max-width: 60ch; margin: 0 auto; width: 100%; }

  /* Il profilo è diventato una lettura lunga: il corpo scende di mezzo
     punto rispetto alla v1 e l'interlinea sale, così cinque blocchi si
     scansionano invece di pesare. */
  .profilo {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: clamp(1.02rem, 1.6vw, 1.18rem);
    line-height: 1.55;
    color: var(--text-soft);
    margin: 0 0 1rem;
  }

  .profilo:last-child { margin-bottom: 0; }
  .profilo b { font-weight: 700; }

  /* i quattro link ai progetti: qui il magenta scurito regge il testo
     piccolo (5,8:1), quindi l'accento può stare nella parola */
  .profilo a {
    color: var(--imagina-ink);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--imagina-ink) 45%, transparent);
  }

  .profilo a:hover { border-bottom-color: var(--imagina-ink); }
  .profilo a:focus-visible { outline: 2px solid var(--imagina-ink); outline-offset: 3px; }

  /* Il kicker e i titoletti sono due maiuscoletti spaziati a poche righe
     di distanza: senza un filetto si leggevano come due righe della
     stessa cosa. Il filetto lo promuove a testata dell'overlay. */
  .casa-in > .kicker {
    padding-bottom: 1.1rem;
    margin-bottom: 2.2rem;
    border-bottom: 1px solid var(--hairline);
  }

  .blocco-profilo { margin: 0 0 2.4rem; }

  .titoletto {
    font-family: 'Manrope', sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--imagina-ink);
    margin: 0 0 0.9rem;
  }

  .piede-blocco {
    position: sticky;
    bottom: 0;
    margin-top: 2.4rem;
    padding-bottom: 0.4rem;
    background: var(--bg-void);
  }

  /* Con un profilo lungo il testo scorre sotto il piede: una sfumatura
     corta sopra il filetto ammorbidisce il taglio, che altrimenti
     tronca le righe di netto. */
  .piede-blocco::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 2rem;
    background: linear-gradient(to top, var(--bg-void), transparent);
    pointer-events: none;
  }

  .accessi {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--hairline);
    font-family: 'Manrope', sans-serif;
    font-size: 0.82rem;
  }

  .accessi a, .accessi button {
    color: var(--text-dim);
    text-decoration: none;
    background: none;
    border: 0;
    padding: 0.3rem 0;
    font: inherit;
    cursor: pointer;
  }

  .accessi a:hover, .accessi button:hover { color: var(--imagina-ink); }
  .accessi a:focus-visible, .accessi button:focus-visible {
    outline: 2px solid var(--imagina-ink); outline-offset: 3px;
  }

  .piede {
    margin: 1.4rem 0 0;
    font-family: 'Manrope', sans-serif;
    font-size: 0.7rem;
    color: var(--text-dim);
  }

  /* ── i sipari di marchio ── */
  .marchio-in { align-items: center; text-align: center; }

  .marchio {
    display: block;
    width: auto;
    height: auto;
    max-width: min(72vw, 420px);
    max-height: 26svh;
    margin: 0 0 clamp(1.6rem, 4vh, 2.4rem);
  }

  .riga {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: clamp(1.25rem, 3.2vw, 1.9rem);
    line-height: 1.4;
    max-width: 22ch;
    margin: 0 0 clamp(2rem, 5vh, 2.8rem);
  }

  .entra {
    font-family: 'Manrope', sans-serif;
    font-size: 1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    padding: 0.7rem 0.2rem;
    border-bottom: 1px solid currentColor;
  }

  .entra:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }

  /* Su touch il passaggio del mouse non esiste: il verso diventa la
     prima riga del sipario (BRIEF-HOME §3). */
  .verso-tocco { display: none; }

  @media (hover: none) {
    .verso-tocco {
      display: block;
      font-family: 'Manrope', sans-serif;
      font-size: 0.8rem;
      line-height: 1.5;
      /* 0.85 e non 0.72: sotto questa soglia la riga scendeva a 3,6:1
         sul campo petrolio di Tipicità, sotto l'AA per il testo piccolo. */
      opacity: 0.85;
      max-width: 26ch;
      margin: 0 0 clamp(1.8rem, 5vh, 2.6rem);
    }
  }

  /* ── Mutamenti ── */
  .mutamenti-in { max-width: 52ch; margin: 0 auto; width: 100%; }

  .feed { list-style: none; margin: 0; padding: 0; }

  .feed li {
    padding: 1.1rem 0;
    border-top: 1px solid var(--hairline);
  }

  .quando {
    display: block;
    font-family: 'Manrope', sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.35rem;
  }

  .cosa {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: clamp(1.05rem, 2vw, 1.28rem);
    line-height: 1.45;
    color: var(--text-soft);
  }

  /* ══ TELEFONO — stessa inquadratura, voci impilate in basso ══ */
  @media (max-width: 760px) {
    .voci ul { flex-direction: column; align-items: center; gap: 0.55rem; }
    .voci li:not(:last-child)::after { content: none; }
    .voci { padding-top: 1.4rem; }
    .verso { display: none; }
    .hero { max-height: 42svh; }
  }

  /* ══ REDUCED MOTION ══
     Il video lascia il posto al poster (lo decide lo script: senza play()
     resta il poster, che è l'ultimo fotogramma) e i tagli diventano
     dissolvenze istantanee. */
  @media (prefers-reduced-motion: reduce) {
    .sipario[open],
    .sipario--mutamenti[open] { animation: none; }
  }
</style>

<script>
  // ══ LA REGIA DEI SIPARI ══
  // <dialog> nativo: focus trap, ESC, aria-modal e ritorno del focus alla
  // voce d'origine sono del browser. Qui restano tre cose:
  //   1. i quattro nomi sono <a> veri → si intercetta il click semplice,
  //      non quello con modificatori (ctrl/cmd/shift/tasto centrale);
  //   2. la history: aprire fa pushState, il back del browser chiude il
  //      sipario invece di uscire dal sito;
  //   3. il video: gira UNA volta e si ferma sull'ultimo fotogramma.
  //      Con prefers-reduced-motion non parte affatto e resta il poster.
  function regia() {
    const palco = document.querySelector('.palco');
    if (!palco || palco.dataset.regia) return;
    palco.dataset.regia = '1';

    let aperto = null;   // il <dialog> attualmente in scena
    let guardia = false; // stiamo manovrando noi la history
    let impilato = false; // la voce corrente della history è nostra?

    const sipario = (id) => document.getElementById(id);

    // alza il sipario SENZA toccare la history (serve al ritorno dal back
    // e all'apertura da link con l'ancora già dentro)
    function mostra(id) {
      const d = sipario(id);
      if (!d) return false;
      if (aperto === d) return true;
      if (aperto) { const p = aperto; aperto = null; p.close(); }
      aperto = d;
      d.showModal();
      return true;
    }

    // apertura da interazione: impila una voce di history, così il back
    // del browser chiude il sipario invece di uscire dal sito
    function apri(id) {
      if (!mostra(id)) return;
      guardia = true;
      history.pushState({ sipario: id }, '', '#' + id);
      guardia = false;
      impilato = true;
    }

    function chiudi(daHistory) {
      if (!aperto) return;
      const d = aperto;
      aperto = null;
      d.close();
      if (daHistory) return;
      if (impilato) {
        impilato = false;
        guardia = true;
        history.back();
      } else {
        // sipario aperto da un link con l'ancora: non c'è nulla da
        // spopolare, si toglie solo l'ancora dall'indirizzo. Senza questo
        // ramo l'ESC farebbe un back vero e USCIREBBE dal sito.
        history.replaceState({}, '', location.pathname + location.search);
      }
    }

    // ESC (e ogni altra chiusura nativa) deve rimettere in pari la history
    document.querySelectorAll('dialog.sipario').forEach((d) => {
      d.addEventListener('close', () => { if (aperto === d) chiudi(false); });
      // click fuori dal contenuto = click sul dialog stesso
      d.addEventListener('click', (e) => { if (e.target === d) chiudi(false); });
    });

    document.querySelectorAll('[data-chiude]').forEach((b) => {
      b.addEventListener('click', () => chiudi(false));
    });

    // le voci: <a> veri, intercettati solo sul click semplice
    document.querySelectorAll('[data-apre]').forEach((el) => {
      el.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        apri(el.getAttribute('data-apre'));
      });
    });

    // La history in capture: le View Transitions di Astro ascoltano
    // popstate in bubble, e i nostri stati non sono affari loro.
    window.addEventListener('popstate', (e) => {
      const nostro = e.state && e.state.sipario;
      if (!guardia && !aperto && !nostro) return; // non ci riguarda
      e.stopImmediatePropagation();
      if (guardia) { guardia = false; return; }
      if (nostro) { mostra(nostro); impilato = true; return; }
      if (aperto) chiudi(true);
    }, true);

    // link condiviso con l'ancora già dentro: si apre il sipario giusto,
    // ma senza impilare (la voce di history è già quella di partenza)
    const iniziale = location.hash.slice(1);
    if (iniziale && mostra(iniziale)) {
      history.replaceState({ sipario: iniziale }, '', '#' + iniziale);
      impilato = false;
    }

    // ══ IL LOGO CHE SI COMPONE — una volta sola, poi resta ══
    const video = document.getElementById('hero');
    if (video) {
      const fermo = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!fermo) {
        // muted + playsinline: la riproduzione da script è consentita.
        // Se il browser la rifiuta resta il poster, che è l'ultimo
        // fotogramma: la pagina è identica, senza il gesto.
        const p = video.play();
        if (p && p.catch) p.catch(() => {});
      }
    }
  }

  document.addEventListener('astro:page-load', regia);
  regia();
</script>
