---
import BaseLayout from '../../layouts/BaseLayout.astro';
import mapSvg from '../../assets/tipicita-map.svg?raw';
import boxes from '../../assets/tipicita-map-boxes.json';

// LANDING TIPICITÀ — "I QUADRI" (draft, 05/08/2026)
// Impostazione richiesta da Paolo: la pagina è una serie di quadri
// (inquadrature) — uno per capitolo — e le Tracce sono LA MOVIOLA:
// un cursore lungo gli anni che attiva quattro monitor sincronizzati
// (mappa che zooma sul paese · titolo · descrizione ≤280 battute ·
// foto). Mappa = SVG vettoriale, zero immagini, zero servizi esterni.
// Menù a doppia codifica (.Trama .Essenza .Motore .Tracce): MAI spiegarla.
// Video hero: /tipicita/loop.mp4 (visual 2026, 45s). Foto: Jimmy Pessina
// (credit in fondo pagina). Testi lunghi = LAVORATI con Paolo (non
// riscrivere); descrizioni moviola = BOZZE da validare.

// PALETTE (nota Paolo, 05/08): base bianco + PETROLIO #035f6a; accenti
// TIFFANY #14b5bd (hex UFFICIALI estratti dagli SVG del lockup, 05/08). Tiffany = interazione/evidenze; petrolio =
// struttura. Hex tiffany da validare con l'ufficiale del brand.
const theme = {
  '--bg-void': '#fcfcfa',
  '--tiffany': '#14b5bd',
  '--bg-deep': '#eef4f4',
  '--bg-mid': '#e2eded',
  '--text-soft': '#1e2a2c',
  '--text-dim': 'rgba(30, 42, 44, 0.68)',
  '--text-faint': 'rgba(30, 42, 44, 0.44)',
  '--hairline': 'rgba(5, 96, 106, 0.16)',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Tipicità Festival',
  startDate: '2027-03-12',
  endDate: '2027-03-14',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: 'Fermo', address: { '@type': 'PostalAddress', addressLocality: 'Fermo', addressRegion: 'Marche', addressCountry: 'IT' } },
  organizer: { '@type': 'Organization', name: 'Imagina Srl Società Benefit', url: 'https://anigami.it' },
};

// Le tappe della moviola — dati dalla timeline della brochure TF27.
// key = momento identitario (rubino). Descrizioni ≤280 battute [BOZZE].
// DATA UFFICIALE (Paolo, 05/08/2026): la prima edizione è il 1993 — RISOLTO il dubbio 1991/1993.
// px/py = pin sulla CITTÀ (coordinate proiettate geoNaturalEarth1 fitSize 1600×820,
// stessa proiezione della mappa — rigenerare con genmap3 se cambia la mappa).
const stages = [
  { y: '1993', c: '380', px: 855.5, py: 180.8, key: true, t: 'Festival dei prodotti tipici delle Marche', p: 'Fermo',
    // slideshow 1993: scansioni dall'archivio (cartella tracce/slideshow93, 06/08).
    // Ordine narrativo: mostra prodotti → convegno → mestieri → degustazioni → premiazione. Caption = BOZZA.
    photos: ['/tipicita/tracce/1993-1.jpg','/tipicita/tracce/1993-2.jpg','/tipicita/tracce/1993-3.jpg','/tipicita/tracce/1993-4.jpg','/tipicita/tracce/1993-5.jpg','/tipicita/tracce/1993-6.jpg','/tipicita/tracce/1993-7.jpg','/tipicita/tracce/1993-8.jpg','/tipicita/tracce/1993-9.jpg'],
    caption: 'Fermo, 1993 — dall’archivio della prima edizione.',
    d: 'Nasce a Fermo l’evento pionieristico che porta le eccellenze gastronomiche marchigiane su un palcoscenico unico nel suo genere. Il primo lavoro non è raccontare le Marche al mondo: è convincere i marchigiani che ciò che si produce sotto casa vale.' },
  { y: '2011', c: '380', px: 855.5, py: 180.8, key: true, t: 'Made in Marche Festival', p: 'Fermo',
    d: 'Il festival si evolve: accanto alle specialità enogastronomiche entrano il turismo, la moda e l’artigianato d’eccellenza. Una visione integrata del valore territoriale, prima che diventi una formula di moda.' },
  { y: '2015–16', c: '784', px: 1038.5, py: 273.6, t: 'Italian Cuisine World Summit', p: 'Dubai, EAU',
    d: 'Il Made in Marche esce dai confini regionali: Dubai, Italian Cuisine World Summit. Non una vetrina isolata: la prima tappa di una rotta che non si è più fermata.' },
  { y: '2017', c: '784', px: 1035.1, py: 277.5, t: 'Italian Cuisine World Summit', p: 'Abu Dhabi, EAU',
    d: 'Abu Dhabi: la cucina italiana come linguaggio di relazione, i produttori come interpreti. La rotta del Golfo si consolida.' },
  { y: '2018', c: '008', px: 880.8, py: 190.2, t: 'III Settimana della Cucina Italiana nel Mondo', p: 'New York · Tirana e Valona',
    d: 'Due continenti nello stesso anno: New York, poi Tirana e Valona per la III Settimana della Cucina Italiana nel Mondo. L’Adriatico come ponte, non come confine.' },
  { y: '2019', c: '124', px: 497.3, py: 169.3, t: 'IV Settimana della Cucina Italiana nel Mondo', p: 'Ottawa e Montréal',
    d: 'Il Canada entra nella rete: Ottawa e Montréal per la IV Settimana della Cucina Italiana nel Mondo.' },
  { y: '2022', c: '834', px: 974.4, py: 438.6, key: true, t: 'Semplicemente “Festival”', p: 'EXPO2020 Dubai · Dar Es Salaam e Zanzibar',
    d: 'Tipicità diventa semplicemente “Festival”: ecosistema nazionale delle micro-Italie più autentiche. Nello stesso anno, EXPO2020 Dubai e la VII Settimana della Cucina Italiana in Tanzania.' },
  { y: '2023', c: '250', px: 809.2, py: 152.0, t: 'VIII Settimana della Cucina Italiana nel Mondo', p: 'Parigi',
    d: 'Parigi: la presentazione ufficiale della candidatura della cucina italiana a patrimonio immateriale dell’Unesco. Il locale che ha attraversato il mondo chiede il riconoscimento del viaggio.' },
  { y: '2024', c: '392', px: 1383.4, py: 219.2, t: 'IX Settimana della Cucina Italiana nel Mondo', p: 'Tokyo e Osaka',
    d: 'Tokyo e Osaka: il Giappone, ospite storico del festival, ricambia la visita. Le rotte funzionano quando si percorrono nei due sensi.' },
  { y: '2025', c: '032', px: 555.2, py: 582.4, t: 'X Settimana della Cucina Italiana nel Mondo', p: 'EXPO2025 Osaka · Bahia Blanca, Buenos Aires, Ushuaia', photo: '/tipicita/tracce-argentina.jpg',
    caption: 'Lo stand di Bahía Blanca a Tipicità 2026: il viaggio che ricambia.',
    d: 'EXPO2025 Osaka, poi la rotta più lunga mai percorsa: Bahia Blanca, Buenos Aires e Ushuaia, fino alla fine del mondo. E l’anno dopo, l’Argentina sale sui banchi di Fermo.' },
  { y: '2027', c: '380', px: 855.5, py: 180.8, key: true, t: '35ª edizione', p: 'Fermo, 12–14 marzo',
    d: 'La rotta torna a casa: Fermo, 12–14 marzo 2027. Non per fermarsi — per ripartire.' },
];
---

<BaseLayout
  title="Tipicità Festival — Fermo, 12-14 marzo 2027"
  description="Tipicità Festival, Fermo, 12-14 marzo 2027: dal 1993 il festival delle traiettorie indigene tra enogastronomia, artigianato e cultura del territorio."
  accent="#05606a"
  structuredData={structuredData}
  theme={theme}
>
  <a class="to-home" slot="header" href="/">Imagina</a>

  <div class="deck" id="deck">

  <!-- ══ QUADRO 1 · Il campo ══ -->
  <header class="quadro q-hero" id="top">
    <video autoplay muted loop playsinline poster="/tipicita/poster.jpg">
      <source src="/tipicita/loop.mp4" type="video/mp4" />
    </video>
    <div class="veil" aria-hidden="true"></div>
    <div class="q-hero-content">
      <img class="wordmark" src="/logos/tipicita-wordmark-white.svg" alt="Tipicità" />
      <img class="payoff" src="/logos/tipicita-payoff-it.svg" alt="il festival delle traiettorie indigene" />
      <nav class="menu" aria-label="Capitoli">
        <a href="#trama">.Trama</a><a href="#essenza">.Essenza</a><a href="#motore">.Motore</a><a href="#tracce">.Tracce</a>
      </nav>
    </div>
    <div class="cue" aria-hidden="true"></div>
  </header>

  <!-- ══ QUADRO 2 · .Trama ══ -->
  <section class="quadro" id="trama">
    <div class="q-in">
      <h2>Trama</h2>
      <div class="trio">
        <article><h3>Dal locale al globale</h3><p>Festival, rassegne e incontri tematici — enogastronomia, turismo, design, ricerca, sostenibilità. Non capitoli separati: la stessa domanda, vista da angolazioni diverse.</p></article>
        <article><h3>Lab di co-creazione glocal</h3><p>Progetti condivisi con università, imprese, istituzioni. Non per raccontare l'Italia al mondo, ma per costruirla insieme a chi la guarda da fuori.</p></article>
        <article><h3>Piattaforma per il territorio</h3><p>Una rete che mette in relazione persone, luoghi, storie — la stessa rete di circa 300 realtà pubbliche e private che sostiene ogni edizione.</p></article>
      </div>
      <figure class="duo">
        <img src="/tipicita/trama-1.jpg" alt="La pasta di Campofilone esposta a Tipicità" loading="lazy" />
        <img src="/tipicita/trama-2.jpg" alt="Un intervento sul palco di Tipicità: radici e traiettorie" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- ══ QUADRO 3 · .Essenza — il capitolo che si sfoglia ══
       v3 (06/08/2026, richiesta Paolo): card orizzontali con snap, frecce,
       avanzamento; la rotella scorre le card e a fine capitolo prosegue.
       Testi = riscrittura v2 approvata in lavorazione. -->
  <section class="quadro q-ess" id="essenza">
    <video class="ess-bg" id="essbg" muted loop playsinline preload="metadata" aria-hidden="true">
      <source src="/tipicita/essenza-bg.mp4" type="video/mp4" />
    </video>
    <div class="ess-head">
      <h2>Essenza</h2>
      <span class="hint">scorri <span aria-hidden="true">→</span></span>
    </div>
    <div class="hwrap">
      <div class="hscroll" id="hscroll">
        <article class="card lead-card"><span class="idx">01</span>
          <p class="cl">La tipicità<br/>non è un'etichetta.</p>
          <p class="cs">È <strong>la traccia che un territorio lascia</strong> dentro le cose che genera.</p>
        </article>
        <article class="card"><span class="idx">02</span><p class="kick">la traccia</p>
          <p>Il ciauscolo non è tipico delle Marche perché qualcuno l'ha deciso. Lo è perché qualcuno, prima di chiunque altro, ha interpretato in quella forma <strong>il clima, l'allevamento, i tempi di una collina precisa</strong> — quella, e non un'altra.</p>
        </article>
        <article class="card"><span class="idx">03</span><p class="kick">la traccia</p>
          <p>E vale per un salume come per un software: una software house di Mumbai e una di Tolentino non lavoreranno mai allo stesso modo.</p>
          <p>Non è una differenza di competenza. <strong>È una differenza di territorio.</strong></p>
        </article>
        <article class="card photo-card"><span class="idx">04</span>
          <img src="/tipicita/essenza-1.jpg" alt="Salumi e formaggi del territorio sui banchi del festival" loading="lazy" />
        </article>
        <article class="card"><span class="idx">05</span><p class="kick">l'attraversamento</p>
          <p>Ma nessuna tipicità resta viva da sola. Il pomodoro arriva da un altro continente, prima di diventare <strong>più napoletano del napoletano stesso</strong>.</p>
          <p>E la cucina italiana è patrimonio Unesco per il motivo opposto a quello che si crede: perché è un prodotto globale, mutato e mutevole.</p>
        </article>
        <article class="card key-card"><span class="idx">06</span>
          <p>Il locale non sopravvive isolandosi dal mondo — <em>sopravvive attraversandolo</em>.</p>
        </article>
        <article class="card"><span class="idx">07</span><p class="kick">la tensione</p>
          <p><strong>Traiettorie</strong> e <strong>indigene</strong>: due parole che tirano in direzioni opposte, e per questo si tengono in piedi a vicenda.</p>
          <p>Traiettoria è aerea — rotte, mercati, il mondo che si muove. Indigeno è caldo, quasi primordiale — l'istinto di un luogo, prima che diventi racconto.</p>
        </article>
        <article class="card"><span class="idx">08</span><p class="kick">la tensione</p>
          <p>Tipicità sta esattamente in mezzo:</p>
          <p class="cl-small"><strong>racconta il globale attraverso il locale.</strong></p>
        </article>
        <article class="card"><span class="idx">09</span><p class="kick">la rotta</p>
          <p>Nel 1993, quando tutto comincia, l'enogastronomia non è ancora un argomento da prima serata: il primo lavoro è convincere i marchigiani stessi che ciò che si produce sotto casa <strong>non vale meno di un marchio da supermercato</strong>.</p>
        </article>
        <article class="card"><span class="idx">10</span><p class="kick">la rotta</p>
          <p>Da lì il racconto si allarga — i territori, la manualità che attraversa artigianato e digitale — finché, dopo il 2020, il festival apre a chi viene da fuori: <strong>un fenomeno si capisce solo per confronto</strong>.</p>
        </article>
        <article class="card key-card"><span class="idx">11</span>
          <p>Oggi Tipicità sta diventando qualcos'altro ancora: <em>il festival delle traiettorie indigene</em>.</p>
        </article>
      </div>
      <button class="hbtn hprev" id="hprev" aria-label="Card precedente">‹</button>
      <button class="hbtn hnext" id="hnext" aria-label="Card successiva">›</button>
    </div>
    <div class="hprog" aria-hidden="true"><span id="hfill"></span></div>
  </section>

  <!-- ══ QUADRO 4 · .Motore — lo schema in moto ══
       v2 (06/08/2026): non card, non colonna — il disegno tecnico della
       formula. Quattro nodi su una linea di flusso animata; il pannello
       cambia al click; ~300 conta da zero; i nove ingranaggi si montano
       uno a uno. Registro: officina/formula (il codice Ferrari). -->
  <section class="quadro" id="motore">
    <div class="q-in narrow">
      <h2>Motore</h2>
      <div class="banco">
        <span class="blabel" aria-hidden="true">La formula</span>
        <div class="schema" role="tablist" aria-label="La formula">
          <span class="flow" aria-hidden="true"></span>
          <button class="nodo on" id="mtab-0" data-m="0" role="tab" aria-selected="true" aria-controls="mpanel">Traiettorie</button>
          <button class="nodo" id="mtab-1" data-m="1" role="tab" aria-selected="false" aria-controls="mpanel">Carburante</button>
          <button class="nodo" id="mtab-2" data-m="2" role="tab" aria-selected="false" aria-controls="mpanel">Impatto</button>
          <button class="nodo" id="mtab-3" data-m="3" role="tab" aria-selected="false" aria-controls="mpanel">Ingranaggi</button>
        </div>
        <div class="mpanel" id="mpanel" role="tabpanel" tabindex="0" aria-labelledby="mtab-0" aria-live="polite"></div>
      </div>
    </div>
  </section>

  <!-- ══ QUADRO 5 · .Tracce — la moviola ══ -->
  <section class="quadro" id="tracce">
    <div class="q-in">
      <h2>Tracce</h2>
      <p class="lede">Una rotta che si allunga edizione dopo edizione. Trascina il cursore lungo gli anni.</p>

      <div class="moviola" id="moviola" role="tabpanel" tabindex="0" aria-labelledby="ytab-0">
        <div class="mon mon-map" data-mon="MON 01 · MAPPA">
          <svg viewBox="0 0 1600 820" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <g id="mv-world"><Fragment set:html={mapSvg} /></g>
          </svg>
          <div class="pin" id="mv-pin" hidden></div>
        </div>
        <div class="mon mon-title" data-mon="MON 02 · TITOLO">
          <span class="myear" id="mv-year">1993</span>
          <h3 id="mv-title">Festival dei prodotti tipici delle Marche</h3>
          <span class="mplace" id="mv-place">Fermo</span>
        </div>
        <div class="mon mon-desc" data-mon="MON 03 · SINTESI"><p id="mv-desc"></p></div>
        <div class="mon mon-photo" id="mv-photo" data-mon="MON 04 · ARCHIVIO">
          <img id="mv-img-a" class="off" alt="" />
          <img id="mv-img-b" class="off" alt="" />
          <span class="mcap" id="mv-cap">Foto d'archivio — in selezione</span>
        </div>
      </div>

      <div class="anni" id="mv-anni" role="tablist" aria-label="Anni della rotta">
        {stages.map((s, i) => (
          <button class={s.key ? 'anno key' : 'anno'} id={`ytab-${i}`} data-i={i} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls="moviola">{s.y}</button>
        ))}
      </div>
      <input class="scrub" id="mv-scrub" type="range" min="0" max={stages.length - 1} step="1" value="0" aria-label="Cursore degli anni" />
      <p class="credits">Fotografie: Jimmy Pessina · Visual: Tipicità 2026</p>

      <noscript>
        <ol class="fallback">
          {stages.map((s) => <li><b>{s.y}</b> — {s.t} · {s.p}. {s.d}</li>)}
        </ol>
      </noscript>
    </div>
  </section>

  </div>

  <nav class="dots" aria-label="Quadri">
    <button data-q="top" aria-label="Apertura"></button>
    <button data-q="trama" aria-label="Trama"></button>
    <button data-q="essenza" aria-label="Essenza"></button>
    <button data-q="motore" aria-label="Motore"></button>
    <button data-q="tracce" aria-label="Tracce"></button>
  </nav>
  <button class="next" id="deck-next" aria-label="Quadro successivo">↓</button>
</BaseLayout>

<style is:global>
  /* La mappa della moviola (contenuto iniettato) */
  #mv-world path { fill: rgba(255, 255, 255, 0.07); stroke: rgba(255, 255, 255, 0.15); stroke-width: 0.5; }
  #mv-world path.on { fill: #10787f; fill: color-mix(in srgb, #14b5bd 50%, #0b3a41); stroke: #7fe0dc; stroke-width: 0.8; }
  #mv-world { transition: transform 1.5s cubic-bezier(0.55, 0.05, 0.18, 1); transform-origin: 0 0; will-change: transform; }
  @media (prefers-reduced-motion: reduce) { #mv-world { transition: none; } }
  /* il footer di sito non entra nel deck a slide */
  footer.site-footer { display: none; }
  /* Motore: il pannello è iniettato a runtime → stili globali */
  .mpanel p { font-size: 1.08rem; line-height: 1.75; color: rgba(30,42,44,.68); margin: 0 0 1em; }
  .mpanel p strong { font-weight: 500; color: #05606a; }
  .mpanel .mnum { font-family: 'Cormorant Garamond', serif; font-size: clamp(3.2rem, 7vw, 4.6rem);
    font-weight: 600; color: #05606a; line-height: 1; margin: 0 0 0.15em; }
  .mpanel .mnum small { font-size: 0.32em; color: #14b5bd; font-family: 'Manrope', sans-serif;
    letter-spacing: 0.2em; text-transform: uppercase; vertical-align: 0.5em; margin-left: 0.6em; }
  .mpanel .chips { list-style: none; margin: 0.4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .mpanel .chips li { font-family: 'Manrope', sans-serif; font-size: 0.76rem; color: #05606a;
    border: 1px solid rgba(20,181,189,.55); border-radius: 999px; padding: 0.36rem 0.85rem;
    background: rgba(20,181,189,.07); opacity: 0; transform: translateY(8px) scale(0.96);
    transition: opacity 0.4s ease, transform 0.4s ease; }
  .mpanel .chips li.mount { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .mpanel .chips li { opacity: 1; transform: none; transition: none; } }
  /* quadri: aggancio */

</style>

<style>
  .to-home { position: fixed; top: 1.4rem; right: 1.6rem; z-index: 20; font-family: 'Manrope', sans-serif;
    font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none;
    color: #fff; mix-blend-mode: difference; opacity: 0.75; }
  .to-home:hover { opacity: 1; }

  /* Focus da tastiera: anello visibile e coerente su TUTTI i controlli.
     :focus-visible → compare solo con tastiera, non altera lo stato a
     riposo; outline non sposta il layout. Petrolio sui controlli su
     fondo chiaro (≈8:1 sul bianco), bianco su quelli sopra il campo teal. */
  .dots button:focus-visible, .nodo:focus-visible, .anno:focus-visible,
  .hbtn:focus-visible, .next:focus-visible, .scrub:focus-visible {
    outline: 2px solid var(--brand-accent); outline-offset: 2px; }
  .menu a:focus-visible, .to-home:focus-visible {
    outline: 2px solid #fff; outline-offset: 3px; }

  /* IL DECK: navigazione a quadri — una slide alla volta, non scroll
     continuo. Snap obbligatorio; i quadri lunghi scorrono AL LORO
     INTERNO prima di passare al successivo. */
  .deck { height: 100vh; height: 100svh; overflow-y: auto; scroll-snap-type: y mandatory; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { .deck { scroll-behavior: auto; } }
  .quadro { height: 100vh; height: 100svh; display: flex; align-items: center; scroll-snap-align: start;
    scroll-snap-stop: always; position: relative; overflow: hidden; }
  .q-in { max-width: 1050px; margin: 0 auto; padding: clamp(2.5rem, 6vh, 4rem) 1.6rem; width: 100%;
    max-height: 100vh; max-height: 100svh; overflow-y: auto; }
  .q-in.narrow { max-width: 800px; }

  /* puntini di navigazione */
  .dots { position: fixed; right: 1.1rem; top: 50%; transform: translateY(-50%); z-index: 20;
    display: flex; flex-direction: column; gap: 0.7rem; }
  .dots button { width: 9px; height: 9px; border-radius: 50%; border: 1px solid var(--brand-accent);
    background: transparent; cursor: pointer; padding: 0; transition: background 0.25s, transform 0.25s; }
  .dots button.on { background: var(--tiffany); border-color: var(--tiffany); transform: scale(1.35); }
  .q-hero ~ .dots button { border-color: rgba(255,255,255,.8); }
  .next { position: fixed; right: 1.6rem; bottom: 1.4rem; z-index: 20; width: 42px; height: 42px;
    border-radius: 50%; border: 1px solid var(--tiffany); color: var(--tiffany); background: rgba(252,252,250,.75);
    font-size: 1.1rem; cursor: pointer; line-height: 1; }
  .next:hover { background: var(--tiffany); color: #fff; }
  @media (max-width: 640px) { .dots { right: 0.5rem; } }

  h2 { color: var(--brand-accent); font-size: clamp(1.7rem, 3.6vw, 2.3rem); margin-bottom: 1.2em; }
  h2::before { content: '.'; font-weight: 700; color: var(--tiffany); }

  /* ── Quadro 1: il campo col visual ── */
  .q-hero { background: var(--brand-accent); overflow: hidden; flex-direction: column; justify-content: center; text-align: center; }
  .q-hero video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.5; }
