---
import BaseLayout from '../../layouts/BaseLayout.astro';
import mapSvg from '../../assets/tipicita-map.svg?raw';
import boxes from '../../assets/tipicita-map-boxes.json';

// LANDING TIPICITÀ — "I QUADRI" (draft, 05/08/2026)
// Impostazione richiesta da Paolo: la pagina è una serie di quadri
// (inquadrature) — uno per capitolo — e le Tracce sono LA MOVIOLA:
// un cursore lungo gli anni che attiva quattro monitor sincronizzati
// (mappa che zooma sul paese · titolo · descrizione ≤280 battute ·
// foto). Mappa = SVG vettoriale, zero immagini, zero servizi esterni.
// Menù a doppia codifica (.Trama .Essenza .Motore .Tracce): MAI spiegarla.
// Video hero: /tipicita/loop.mp4 (visual 2026, 45s). Foto: Jimmy Pessina
// (credit in fondo pagina). Testi lunghi = LAVORATI con Paolo (non
// riscrivere); descrizioni moviola = BOZZE da validare.

// PALETTE (nota Paolo, 05/08): base bianco + PETROLIO #035f6a; accenti
// TIFFANY #0abab5 e affini. Tiffany = interazione/evidenze; petrolio =
// struttura. Hex tiffany da validare con l'ufficiale del brand.
const theme = {
  '--bg-void': '#fcfcfa',
  '--tiffany': '#0abab5',
  '--bg-deep': '#eef4f4',
  '--bg-mid': '#e2eded',
  '--text-soft': '#1e2a2c',
  '--text-dim': 'rgba(30, 42, 44, 0.68)',
  '--text-faint': 'rgba(30, 42, 44, 0.44)',
  '--hairline': 'rgba(3, 95, 106, 0.16)',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Tipicità Festival',
  startDate: '2027-03-12',
  endDate: '2027-03-14',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: 'Fermo', address: { '@type': 'PostalAddress', addressLocality: 'Fermo', addressRegion: 'Marche', addressCountry: 'IT' } },
  organizer: { '@type': 'Organization', name: 'Imagina Srl Società Benefit', url: 'https://anigami.it' },
};

// Le tappe della moviola — dati dalla timeline della brochure TF27.
// key = momento identitario (rubino). Descrizioni ≤280 battute [BOZZE].
// DATA UFFICIALE (Paolo, 05/08/2026): la prima edizione è il 1993 — RISOLTO il dubbio 1991/1993.
const stages = [
  { y: '1993', c: '380', key: true, t: 'Festival dei prodotti tipici delle Marche', p: 'Fermo',
    d: 'Nasce a Fermo l’evento pionieristico che porta le eccellenze gastronomiche marchigiane su un palcoscenico unico nel suo genere. Il primo lavoro non è raccontare le Marche al mondo: è convincere i marchigiani che ciò che si produce sotto casa vale.' },
  { y: '2011', c: '380', key: true, t: 'Made in Marche Festival', p: 'Fermo',
    d: 'Il festival si evolve: accanto alle specialità enogastronomiche entrano il turismo, la moda e l’artigianato d’eccellenza. Una visione integrata del valore territoriale, prima che diventi una formula di moda.' },
  { y: '2015–16', c: '784', t: 'Italian Cuisine World Summit', p: 'Dubai, EAU',
    d: 'Il Made in Marche esce dai confini regionali: Dubai, Italian Cuisine World Summit. Non una vetrina isolata: la prima tappa di una rotta che non si è più fermata.' },
  { y: '2017', c: '784', t: 'Italian Cuisine World Summit', p: 'Abu Dhabi, EAU',
    d: 'Abu Dhabi: la cucina italiana come linguaggio di relazione, i produttori come interpreti. La rotta del Golfo si consolida.' },
  { y: '2018', c: '008', t: 'III Settimana della Cucina Italiana nel Mondo', p: 'New York · Tirana e Valona',
    d: 'Due continenti nello stesso anno: New York, poi Tirana e Valona per la III Settimana della Cucina Italiana nel Mondo. L’Adriatico come ponte, non come confine.' },
  { y: '2019', c: '124', t: 'IV Settimana della Cucina Italiana nel Mondo', p: 'Ottawa e Montréal',
    d: 'Il Canada entra nella rete: Ottawa e Montréal per la IV Settimana della Cucina Italiana nel Mondo.' },
  { y: '2022', c: '834', key: true, t: 'Semplicemente “Festival”', p: 'EXPO2020 Dubai · Dar Es Salaam e Zanzibar',
    d: 'Tipicità diventa semplicemente “Festival”: ecosistema nazionale delle micro-Italie più autentiche. Nello stesso anno, EXPO2020 Dubai e la VII Settimana della Cucina Italiana in Tanzania.' },
  { y: '2023', c: '250', t: 'VIII Settimana della Cucina Italiana nel Mondo', p: 'Parigi',
    d: 'Parigi: la presentazione ufficiale della candidatura della cucina italiana a patrimonio immateriale dell’Unesco. Il locale che ha attraversato il mondo chiede il riconoscimento del viaggio.' },
  { y: '2024', c: '392', t: 'IX Settimana della Cucina Italiana nel Mondo', p: 'Tokyo e Osaka',
    d: 'Tokyo e Osaka: il Giappone, ospite storico del festival, ricambia la visita. Le rotte funzionano quando si percorrono nei due sensi.' },
  { y: '2025', c: '032', t: 'X Settimana della Cucina Italiana nel Mondo', p: 'EXPO2025 Osaka · Bahia Blanca, Buenos Aires, Ushuaia', photo: '/tipicita/tracce-argentina.jpg',
    caption: 'Lo stand di Bahía Blanca a Tipicità 2026: il viaggio che ricambia.',
    d: 'EXPO2025 Osaka, poi la rotta più lunga mai percorsa: Bahia Blanca, Buenos Aires e Ushuaia, fino alla fine del mondo. E l’anno dopo, l’Argentina sale sui banchi di Fermo.' },
  { y: '2027', c: '380', key: true, t: '35ª edizione', p: 'Fermo, 12–14 marzo',
    d: 'La rotta torna a casa: Fermo, 12–14 marzo 2027. Non per fermarsi — per ripartire.' },
];
---

<BaseLayout
  title="Tipicità Festival — Fermo, 12-14 marzo 2027"
  description="Tipicità Festival, Fermo, 12-14 marzo 2027: dal 1993 il festival delle traiettorie indigene tra enogastronomia, artigianato e cultura del territorio."
  accent="#035f6a"
  structuredData={structuredData}
  theme={theme}
>
  <a class="to-home" slot="header" href="/">Imagina</a>

  <div class="deck" id="deck">

  <!-- ══ QUADRO 1 · Il campo ══ -->
  <header class="quadro q-hero" id="top">
    <video autoplay muted loop playsinline poster="/tipicita/poster.jpg">
      <source src="/tipicita/loop.mp4" type="video/mp4" />
    </video>
    <div class="veil" aria-hidden="true"></div>
    <div class="q-hero-content">
      <p class="kicker">Fermo · 12–14 marzo 2027</p>
      <img class="wordmark" src="/logos/tipicita.svg" alt="Tipicità Festival" />
      <p class="heroline">Il festival delle traiettorie indigene.<br />Racconta il globale attraverso il locale.</p>
      <nav class="menu" aria-label="Capitoli">
        <a href="#trama">.Trama</a><a href="#essenza">.Essenza</a><a href="#motore">.Motore</a><a href="#tracce">.Tracce</a>
      </nav>
    </div>
    <div class="cue" aria-hidden="true"></div>
  </header>

  <!-- ══ QUADRO 2 · .Trama ══ -->
  <section class="quadro" id="trama">
    <div class="q-in">
      <h2>Trama</h2>
      <div class="trio">
        <article><h3>Dal locale al globale</h3><p>Festival, rassegne e incontri tematici — enogastronomia, turismo, design, ricerca, sostenibilità. Non capitoli separati: la stessa domanda, vista da angolazioni diverse.</p></article>
        <article><h3>Lab di co-creazione glocal</h3><p>Progetti condivisi con università, imprese, istituzioni. Non per raccontare l'Italia al mondo, ma per costruirla insieme a chi la guarda da fuori.</p></article>
        <article><h3>Piattaforma per il territorio</h3><p>Una rete che mette in relazione persone, luoghi, storie — la stessa rete di circa 300 realtà pubbliche e private che sostiene ogni edizione.</p></article>
      </div>
      <figure class="duo">
        <img src="/tipicita/trama-1.jpg" alt="La pasta di Campofilone esposta a Tipicità" loading="lazy" />
        <img src="/tipicita/trama-2.jpg" alt="Un intervento sul palco di Tipicità: radici e traiettorie" loading="lazy" />
      </figure>
    </div>
  </section>

  <!-- ══ QUADRO 3 · .Essenza ══
       RISCRITTA su richiesta di Paolo (06/08/2026) dal tavolo
       linguista+scrittore+web editor+UX: tesi in apertura, ciauscolo come
       prova, battute brevi, kicker-guida, filo di avanzamento, reveal
       progressivo. PROPOSTA DA VALIDARE (sostituisce il testo precedente,
       stesse idee, ritmo nuovo). -->
  <section class="quadro" id="essenza">
    <div class="q-in narrow" id="ess-scroll">
      <div class="ess-rail" aria-hidden="true"><span id="ess-fill"></span></div>
      <h2>Essenza</h2>

      <p class="lead beat">La tipicità non è un'etichetta.<br/>È <strong>la traccia che un territorio lascia</strong> dentro le cose che genera.</p>

      <p class="kick beat">la traccia</p>
      <p class="beat">Il ciauscolo non è tipico delle Marche perché qualcuno l'ha deciso. Lo è perché qualcuno, prima di chiunque altro, ha interpretato in quella forma <strong>il clima, l'allevamento, i tempi di una collina precisa</strong> — quella, e non un'altra.</p>
      <p class="beat">E vale per un salume come per un software: una software house di Mumbai e una di Tolentino non lavoreranno mai allo stesso modo. Non è una differenza di competenza. <strong>È una differenza di territorio.</strong></p>

      <figure class="ess-break beat"><img src="/tipicita/essenza-1.jpg" alt="Salumi e formaggi del territorio sui banchi del festival" loading="lazy" /></figure>

      <p class="kick beat">l'attraversamento</p>
      <p class="beat">Ma nessuna tipicità resta viva da sola. Il pomodoro arriva da un altro continente, prima di diventare <strong>più napoletano del napoletano stesso</strong>.</p>
      <p class="beat">E la cucina italiana è patrimonio Unesco non perché sia rimasta uguale nei secoli — per il motivo opposto: è un prodotto globale, mutato e mutevole.</p>
      <p class="keyline beat">Il locale non sopravvive isolandosi dal mondo — sopravvive attraversandolo.</p>

      <p class="kick beat">la tensione</p>
      <p class="beat"><strong>Traiettorie</strong> e <strong>indigene</strong>: due parole che tirano in direzioni opposte, e per questo si tengono in piedi a vicenda. Traiettoria è aerea — rotte, mercati, il mondo che si muove. Indigeno è caldo, quasi primordiale — l'istinto di un luogo, prima che diventi racconto.</p>
      <p class="beat">Tipicità sta esattamente in mezzo: <strong>racconta il globale attraverso il locale</strong>.</p>

      <p class="kick beat">la rotta</p>
      <p class="beat">Nel 1993, quando tutto comincia, l'enogastronomia non è ancora un argomento da prima serata: il primo lavoro è convincere i marchigiani stessi che ciò che si produce sotto casa <strong>non vale meno di un marchio da supermercato</strong>.</p>
      <p class="beat">Da lì il racconto si allarga — i territori, la manualità che attraversa artigianato e digitale — finché, dopo il 2020, il festival apre a chi viene da fuori: <strong>un fenomeno si capisce solo per confronto</strong>.</p>

      <p class="keyline beat">Oggi Tipicità sta diventando qualcos'altro ancora: il festival delle traiettorie indigene.</p>
    </div>
  </section>

  <!-- ══ QUADRO 4 · .Motore ══ -->
  <section class="quadro" id="motore">
    <div class="q-in">
      <h2>Motore</h2>
      <div class="motor">
        <div><h3>Traiettorie</h3><p>Il Made in Marche esce dai confini regionali: dai palchi di Fermo alle fiere di Dubai, New York, Tokyo — non vetrine isolate, tappe della stessa rotta.</p></div>
        <div><h3>Carburante</h3><p class="big">~300</p><p>realtà pubbliche e private — enti, imprese, università — che co-progettano ogni edizione in partnership pubblico-privata.</p></div>
        <div><h3>Impatto</h3><p>Ogni edizione si converte in occasioni concrete: visibilità per i brand, accesso a mercati nazionali e internazionali, relazioni che restano attive oltre i tre giorni di festival.</p></div>
        <div><h3>Ingranaggi</h3>
          <ul class="chips"><li>Sviluppo territoriale</li><li>Biodiversità e sostenibilità</li><li>Turismo esperienziale</li><li>Patrimonio enogastronomico e innovazione</li><li>Manifattura creativa e Made in Italy</li><li>Economia circolare e transizione verde</li><li>Cooperazione accademica e ricerca</li><li>Cultura digitale e comunità intelligenti</li><li>Giovani e competenze per il futuro</li></ul>
        </div>
      </div>
      <figure class="wide"><img src="/tipicita/motore-1.jpg" alt="Il palco istituzionale di Tipicità" loading="lazy" /></figure>
    </div>
  </section>

  <!-- ══ QUADRO 5 · .Tracce — la moviola ══ -->
  <section class="quadro" id="tracce">
    <div class="q-in">
      <h2>Tracce</h2>
      <p class="lede">Una rotta che si allunga edizione dopo edizione. Trascina il cursore lungo gli anni.</p>

      <div class="moviola" id="moviola">
        <div class="mon mon-map" data-mon="MON 01 · MAPPA">
          <svg viewBox="0 0 1600 820" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <g id="mv-world"><Fragment set:html={mapSvg} /></g>
          </svg>
          <div class="pin" id="mv-pin" hidden></div>
        </div>
        <div class="mon mon-title" data-mon="MON 02 · TITOLO">
          <span class="myear" id="mv-year">1993</span>
          <h3 id="mv-title">Festival dei prodotti tipici delle Marche</h3>
          <span class="mplace" id="mv-place">Fermo</span>
        </div>
        <div class="mon mon-desc" data-mon="MON 03 · SINTESI"><p id="mv-desc"></p></div>
        <div class="mon mon-photo" id="mv-photo" data-mon="MON 04 · ARCHIVIO">
          <img id="mv-img" alt="" hidden />
          <span class="mcap" id="mv-cap">Foto d'archivio — in selezione</span>
        </div>
      </div>

      <div class="anni" id="mv-anni" role="tablist" aria-label="Anni della rotta">
        {stages.map((s, i) => (
          <button class={s.key ? 'anno key' : 'anno'} data-i={i} role="tab" aria-selected={i === 0 ? 'true' : 'false'}>{s.y}</button>
        ))}
      </div>
      <input class="scrub" id="mv-scrub" type="range" min="0" max={stages.length - 1} step="1" value="0" aria-label="Cursore degli anni" />
      <p class="credits">Fotografie: Jimmy Pessina · Visual: Tipicità 2026</p>

      <noscript>
        <ol class="fallback">
          {stages.map((s) => <li><b>{s.y}</b> — {s.t} · {s.p}. {s.d}</li>)}
        </ol>
      </noscript>
    </div>
  </section>

  </div>

  <nav class="dots" aria-label="Quadri">
    <button data-q="top" aria-label="Apertura"></button>
    <button data-q="trama" aria-label="Trama"></button>
    <button data-q="essenza" aria-label="Essenza"></button>
    <button data-q="motore" aria-label="Motore"></button>
    <button data-q="tracce" aria-label="Tracce"></button>
  </nav>
  <button class="next" id="deck-next" aria-label="Quadro successivo">↓</button>
</BaseLayout>

<style is:global>
  /* La mappa della moviola (contenuto iniettato) */
  #mv-world path { fill: rgba(255, 255, 255, 0.07); stroke: rgba(255, 255, 255, 0.15); stroke-width: 0.5; }
  #mv-world path.on { fill: color-mix(in srgb, #0abab5 50%, #0b3a41); stroke: #7fe0dc; stroke-width: 0.8; }
  #mv-world { transition: transform 1.5s cubic-bezier(0.55, 0.05, 0.18, 1); transform-origin: 0 0; will-change: transform; }
  @media (prefers-reduced-motion: reduce) { #mv-world { transition: none; } }
  /* il footer di sito non entra nel deck a slide */
  footer.site-footer { display: none; }
</style>

<style>
  .to-home { position: fixed; top: 1.4rem; right: 1.6rem; z-index: 20; font-family: 'Manrope', sans-serif;
    font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none;
    color: #fff; mix-blend-mode: difference; opacity: 0.75; }
  .to-home:hover { opacity: 1; }

  /* IL DECK: navigazione a quadri — una slide alla volta, non scroll
     continuo. Snap obbligatorio; i quadri lunghi scorrono AL LORO
     INTERNO prima di passare al successivo. */
  .deck { height: 100svh; overflow-y: auto; scroll-snap-type: y mandatory; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { .deck { scroll-behavior: auto; } }
  .quadro { height: 100svh; display: flex; align-items: center; scroll-snap-align: start;
    scroll-snap-stop: always; position: relative; overflow: hidden; }
  .q-in { max-width: 1050px; margin: 0 auto; padding: clamp(2.5rem, 6vh, 4rem) 1.6rem; width: 100%;
    max-height: 100svh; overflow-y: auto; }
  .q-in.narrow { max-width: 800px; }

  /* puntini di navigazione */
  .dots { position: fixed; right: 1.1rem; top: 50%; transform: translateY(-50%); z-index: 20;
    display: flex; flex-direction: column; gap: 0.7rem; }
  .dots button { width: 9px; height: 9px; border-radius: 50%; border: 1px solid var(--brand-accent);
    background: transparent; cursor: pointer; padding: 0; transition: background 0.25s, transform 0.25s; }
  .dots button.on { background: var(--tiffany); border-color: var(--tiffany); transform: scale(1.35); }
  .q-hero ~ .dots button { border-color: rgba(255,255,255,.8); }
  .next { position: fixed; right: 1.6rem; bottom: 1.4rem; z-index: 20; width: 42px; height: 42px;
    border-radius: 50%; border: 1px solid var(--tiffany); color: var(--tiffany); background: rgba(252,252,250,.75);
    font-size: 1.1rem; cursor: pointer; line-height: 1; }
  .next:hover { background: var(--tiffany); color: #fff; }
  @media (max-width: 640px) { .dots { right: 0.5rem; } }

  h2 { color: var(--brand-accent); font-size: clamp(1.7rem, 3.6vw, 2.3rem); margin-bottom: 1.2em; }
  h2::before { content: '.'; font-weight: 700; color: var(--tiffany); }

  /* ── Quadro 1: il campo col visual ── */
  .q-hero { background: var(--brand-accent); overflow: hidden; flex-direction: column; justify-content: center; text-align: center; }
  .q-hero video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.5; }
  .q-hero .veil { position: absolute; inset: 0;
    background: radial-gradient(ellipse 90% 75% at 50% 45%, transparent 30%, color-mix(in srgb, var(--brand-accent) 82%, black) 100%); }
  .q-hero-content { position: relative; padding: 0 1.6rem; }
  .kicker { font-family: 'Manrope', sans-serif; font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78); margin: 0 0 1.6rem; }
  .wordmark { height: clamp(84px, 14vw, 150px); width: auto; filter: drop-shadow(0 10px 40px rgba(0, 0, 0, 0.35)); }
  .heroline { font-family: 'Cormorant Garamond', serif; font-size: clamp(1.4rem, 3.4vw, 2.1rem); line-height: 1.3;
    color: #fff; max-width: 26ch; margin: 1.4rem auto 2.2rem; }
  .menu { display: flex; justify-content: center; gap: 1.6rem; flex-wrap: wrap; font-family: 'Manrope', sans-serif;
    font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .menu a { color: rgba(255, 255, 255, 0.9); text-decoration: none; border-bottom: 1px solid transparent; padding-bottom: 3px; }
  .menu a:hover { border-color: var(--tiffany); color: #fff; }
  .cue { position: absolute; bottom: 1.6rem; left: 50%; width: 1px; height: 52px;
    background: linear-gradient(rgba(255, 255, 255, 0.85), transparent); animation: cue 2.4s ease-in-out infinite; }
  @keyframes cue { 0% { transform: scaleY(0); transform-origin: top; } 45% { transform: scaleY(1); transform-origin: top; }
    55% { transform: scaleY(1); transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; } }
  @media (prefers-reduced-motion: reduce) { .cue { animation: none; } .q-hero video { display: none; } }

  /* ── Trama ── */
  .trio { display: grid; grid-template-columns: repeat(auto-fit, minmax(215px, 1fr)); gap: 1.2rem; margin-bottom: 1.8rem; }
  .trio article { background: var(--bg-deep); padding: 1.6rem 1.4rem; }
  .trio h3 { font-size: 1.12rem; margin-bottom: 0.4rem; }
  .trio p { font-size: 0.92rem; line-height: 1.65; color: var(--text-dim); margin: 0; }
  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin: 0; }
  .duo img { width: 100%; height: 300px; object-fit: cover; display: block; }
  @media (max-width: 640px) { .duo { grid-template-columns: 1fr; } .duo img { height: 220px; } }

  /* ── Essenza: lettura guidata ── */
  .q-in.narrow { position: relative; padding-left: 2.4rem; }
  .q-in.narrow p { font-size: 1.05rem; line-height: 1.8; margin-bottom: 1.35em; max-width: 58ch; }
  .q-in.narrow p strong { font-weight: 500; color: var(--brand-accent); }
  .lead { font-family: 'Cormorant Garamond', serif; font-size: clamp(1.7rem, 3.8vw, 2.4rem); line-height: 1.25;
    color: var(--text-soft); margin: 0 0 1.8em !important; max-width: 22ch !important; }
  .lead strong { color: var(--brand-accent); font-weight: 600; }
  .kick { font-family: 'Manrope', sans-serif; font-size: 0.66rem !important; letter-spacing: 0.32em;
    text-transform: uppercase; color: var(--tiffany); margin: 2.4em 0 0.9em !important; }
  .ess-break { margin: 2rem 0; }
  .ess-break img { width: 100%; height: 240px; object-fit: cover; display: block; }
  /* filo di avanzamento della lettura */
  .ess-rail { position: absolute; left: 0.7rem; top: 0; bottom: 0; width: 2px; background: var(--hairline); }
  .ess-rail span { display: block; width: 100%; height: 0%; background: var(--tiffany); transition: height 0.15s linear; }
  /* rivelazione progressiva dei blocchi */
  .beat { opacity: 0; transform: translateY(14px); transition: opacity 0.7s ease, transform 0.7s ease; }
  .beat.vis { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .beat { opacity: 1; transform: none; transition: none; } }
  .keyline { font-family: 'Cormorant Garamond', serif; font-size: clamp(1.4rem, 3vw, 1.9rem); line-height: 1.32;
    color: var(--brand-accent); border-left: 3px solid var(--brand-accent); padding-left: 1.2rem; max-width: 24ch; margin: 2.2rem 0 !important; }

  /* ── Motore ── */
  .motor { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem 2.8rem; margin-bottom: 2rem; }
  .motor h3 { font-size: 1.15rem; color: var(--brand-accent); margin-bottom: 0.4rem; }
  .motor p { font-size: 0.95rem; line-height: 1.68; color: var(--text-dim); margin-bottom: 0.5em; }
  .big { font-family: 'Cormorant Garamond', serif; font-size: clamp(2.4rem, 4.5vw, 3.2rem); font-weight: 600;
    color: var(--brand-accent); line-height: 1; margin: 0.15em 0 0.2em !important; }
  .chips { list-style: none; margin: 0.5rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips li { font-family: 'Manrope', sans-serif; font-size: 0.74rem; color: var(--brand-accent);
    border: 1px solid color-mix(in srgb, var(--tiffany) 55%, transparent); border-radius: 999px;
    padding: 0.32rem 0.8rem; background: color-mix(in srgb, var(--brand-accent) 6%, transparent); }
  figure.wide { margin: 0; }
  figure.wide img { width: 100%; height: 320px; object-fit: cover; display: block; }

  /* ── La moviola ── */
  .lede { color: var(--text-dim); margin: -0.6rem 0 1.6rem; }
  .moviola { display: grid; gap: 8px; grid-template-columns: 1.6fr 1fr;
    grid-template-areas: 'map title' 'map desc' 'photo photo'; background: #04191d; padding: 8px; }
  .mon { position: relative; overflow: hidden; }
  .mon::before { content: attr(data-mon); position: absolute; top: 0.55rem; left: 0.8rem; z-index: 2;
    font-family: 'Manrope', sans-serif; font-size: 0.56rem; letter-spacing: 0.24em;
    color: color-mix(in srgb, var(--tiffany) 75%, white); opacity: 0.85; }
  .mon-map { grid-area: map; background: linear-gradient(180deg, #06272c, #04191d); min-height: 380px; }
  .mon-map svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .pin { position: absolute; width: 13px; height: 13px; border-radius: 50%; background: #a52257;
    transform: translate(-50%, -50%); box-shadow: 0 0 0 0 rgba(165, 34, 87, 0.5); animation: pulse 2s infinite; pointer-events: none; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(165, 34, 87, 0.5); } 70% { box-shadow: 0 0 0 16px rgba(165, 34, 87, 0); } 100% { box-shadow: 0 0 0 0 rgba(165, 34, 87, 0); } }
  .mon-title { grid-area: title; background: #06272c; padding: 1.4rem 1.5rem; display: flex; flex-direction: column; justify-content: center; }
  .myear { font-family: 'Manrope', sans-serif; font-size: 0.72rem; letter-spacing: 0.3em; color: var(--tiffany); }
  .mon-title h3 { color: #fff; font-size: clamp(1.2rem, 2.4vw, 1.6rem); line-height: 1.2; margin: 0.4rem 0 0.35rem; }
  .mplace { font-family: 'Manrope', sans-serif; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255, 255, 255, 0.55); }
  .mon-desc { grid-area: desc; background: #06272c; padding: 1.3rem 1.5rem; }
  .mon-desc p { color: rgba(255, 255, 255, 0.82); font-size: 0.92rem; line-height: 1.7; margin: 0; }
  .mon-photo { grid-area: photo; background: #06272c; min-height: 210px; display: flex; align-items: center; justify-content: center; }
  .mon-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .mcap { position: relative; font-family: 'Manrope', sans-serif; font-size: 0.66rem; letter-spacing: 0.18em;
    text-transform: uppercase; color: rgba(255, 255, 255, 0.5); padding: 0.4rem 0.8rem; background: rgba(4, 25, 29, 0.65); }
  @media (max-width: 780px) { .moviola { grid-template-columns: 1fr; grid-template-areas: 'map' 'title' 'desc' 'photo'; } .mon-map { min-height: 240px; } }

  .anni { display: flex; flex-wrap: wrap; gap: 0.35rem 1.1rem; margin: 1.2rem 0 0.4rem; }
  .anno { font-family: 'Manrope', sans-serif; font-size: 0.74rem; letter-spacing: 0.1em; background: none; border: none;
    color: var(--text-faint); cursor: pointer; padding: 0.3rem 0.1rem; border-bottom: 2px solid transparent; }
  .anno.key { color: #a52257; opacity: 0.75; }
  .anno.on { color: var(--tiffany); border-color: var(--tiffany); opacity: 1; }
  .anno.key.on { color: #a52257; border-color: #a52257; }
  .scrub { width: 100%; accent-color: var(--tiffany); margin: 0.2rem 0 0; }
  .fallback { color: var(--text-dim); font-size: 0.95rem; line-height: 1.7; }

  .credits { text-align: center; margin: 1.6rem 0 0; font-family: 'Manrope', sans-serif; font-size: 0.64rem;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-faint); }
</style>

<script define:vars={{ stages, boxes }}>
  // LA MOVIOLA — il cursore lungo gli anni attiva i monitor sincronizzati.
  const world = document.getElementById('mv-world');
  const pin = document.getElementById('mv-pin');
  const yearEl = document.getElementById('mv-year');
  const titleEl = document.getElementById('mv-title');
  const placeEl = document.getElementById('mv-place');
  const descEl = document.getElementById('mv-desc');
  const imgEl = document.getElementById('mv-img');
  const capEl = document.getElementById('mv-cap');
  const scrub = document.getElementById('mv-scrub');
  const anni = Array.from(document.querySelectorAll('.anno'));
  const mapBox = document.querySelector('.mon-map');
  const VB = { w: 1600, h: 820 };
  let cur = -1;
  let pinTimer = null;

  function activate(i) {
    i = Math.max(0, Math.min(stages.length - 1, i));
    if (i === cur) return;
    cur = i;
    const s = stages[i];
    yearEl.textContent = s.y;
    titleEl.textContent = s.t;
    placeEl.textContent = s.p;
    descEl.textContent = s.d;
    anni.forEach((a, j) => { a.classList.toggle('on', j === i); a.setAttribute('aria-selected', j === i ? 'true' : 'false'); });
    scrub.value = i;
    if (s.photo) { imgEl.src = s.photo; imgEl.alt = s.caption || s.t; imgEl.hidden = false; capEl.textContent = s.caption || ''; }
    else { imgEl.hidden = true; imgEl.removeAttribute('src'); capEl.textContent = "Foto d'archivio — in selezione"; }
    document.querySelectorAll('#mv-world path.on').forEach((p) => p.classList.remove('on'));
    const b = boxes[s.c];
    if (!b) return;
    const w = b.x1 - b.x0, h = b.y1 - b.y0;
    const k = Math.min(6, 1 / Math.max((w * 2.3) / VB.w, (h * 2.3) / VB.h));
    const tx = VB.w / 2 - k * (b.x0 + w / 2), ty = VB.h / 2 - k * (b.y0 + h / 2);
    world.style.transform = `translate(${tx}px, ${ty}px) scale(${k})`;
    document.querySelectorAll(`#mv-world path[data-c="${s.c}"]`).forEach((p) => p.classList.add('on'));
    pin.hidden = true;
    clearTimeout(pinTimer);
    pinTimer = setTimeout(() => {
      const r = mapBox.getBoundingClientRect();
      const scale = Math.max(r.width / VB.w, r.height / VB.h); // slice
      const offX = (r.width - VB.w * scale) / 2, offY = (r.height - VB.h * scale) / 2;
      pin.style.left = (k * b.cx + tx) * scale + offX + 'px';
      pin.style.top = (k * b.cy + ty) * scale + offY + 'px';
      pin.hidden = false;
    }, 1100);
  }

  // ---- deck: puntini, freccia, quadro attivo ----
  const deck = document.getElementById('deck');
  const quadri = Array.from(deck.querySelectorAll('.quadro'));
  const dots = Array.from(document.querySelectorAll('.dots button'));
  const ids = ['top', 'trama', 'essenza', 'motore', 'tracce'];
  function goQ(id) { document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' }); }
  dots.forEach((d) => d.addEventListener('click', () => goQ(d.dataset.q)));
  document.getElementById('deck-next').addEventListener('click', () => {
    const i = ids.findIndex((id, j) => dots[j].classList.contains('on'));
    goQ(ids[Math.min(ids.length - 1, i + 1)]);
  });
  const qObs = new IntersectionObserver((es) => {
    es.forEach((e) => { if (e.isIntersecting) {
      const i = quadri.indexOf(e.target);
      dots.forEach((d, j) => d.classList.toggle('on', j === i));
      document.getElementById('deck-next').style.visibility = i === quadri.length - 1 ? 'hidden' : 'visible';
    } });
  }, { root: deck, threshold: 0.6 });
  quadri.forEach((q) => qObs.observe(q));
  // il menù del quadro 1 naviga il deck
  document.querySelectorAll('.menu a').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault(); goQ(a.getAttribute('href').slice(1));
  }));

  // ---- Essenza: reveal progressivo + filo di avanzamento ----
  const essScroll = document.getElementById('ess-scroll');
  const essFill = document.getElementById('ess-fill');
  const beats = Array.from(document.querySelectorAll('.beat'));
  const bObs = new IntersectionObserver((es) => {
    es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('vis'); bObs.unobserve(e.target); } });
  }, { root: essScroll, threshold: 0.25 });
  beats.forEach((b) => bObs.observe(b));
  essScroll.addEventListener('scroll', () => {
    const max = essScroll.scrollHeight - essScroll.clientHeight;
    essFill.style.height = (max > 0 ? (essScroll.scrollTop / max) * 100 : 100) + '%';
  }, { passive: true });

  scrub.addEventListener('input', () => activate(+scrub.value));
  anni.forEach((a) => a.addEventListener('click', () => activate(+a.dataset.i)));
  document.getElementById('moviola').closest('section').addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') activate(cur + 1);
    if (e.key === 'ArrowLeft') activate(cur - 1);
  });
  activate(0);
</script>
