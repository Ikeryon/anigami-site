     più muovere. Se un domani il testo dovesse soffrire si scende di
     opacità, non si ingrandisce il testo. */
  .fondale {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.30;
    pointer-events: none;
  }

  /* Reduced motion: resta la posa, ferma. Il video non parte nemmeno,
