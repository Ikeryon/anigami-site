---
import BrandLayout from '../../layouts/BrandLayout.astro';
import VideoCard from '../../components/VideoCard.astro';

// LANDING TIPICITÀ IN BLU — la fabula è LA STRUMENTAZIONE
// (ANIGAMI-METANARRATIVA §3): sezioni codificate, dati in evidenza,
// coordinate; più vicina a una carta nautica/protocollo che a un racconto.
// La sobrietà È la sua fabula: qui la cornice non fa letteratura.
//
// ⚠️ OSSATURA NON REPLICABILE: i capitoli sono Rotta · Cantiere ·
// Giornale di bordo. Niente Trama/Essenza/Motore/Tracce (di Tipicità) e
// niente moviola o deck a quadri: quelli sono solo di Tipicità.
// La numerazione 01/02/03 dei capitoli è generata via CSS counter
// (global.css) — è la "codifica" delle sezioni, non un vezzo.
//
// TESTI: trascritti da TESTI-TIB.md (consegna Cowork 06/08/2026, ricerca
// da fonti primarie). Sono BOZZE da validare con Paolo — non riscriverli.
// The Blue Way: piattaforma PRIMA, hackathon come esempi POI (regola di
// Paolo). Eventi pubblici (Sailing Chef) volutamente in secondo piano.

// Video già mappati e verificati (restano dalla versione precedente:
// sono dati reali, non testi da riscrivere).
const bluePillole = [
  { id: 'e7TnD5orNR0', title: 'Reloaded Materials — A Virtuous Chain', meta: '5:33' },
  { id: 'DR14eK82zlM', title: 'Blue Coast Agreements 2030', meta: '5:50' },
  { id: 'UVyXUUTgsHE', title: 'Advanced Training for Shipwrights', meta: '5:02' },
  { id: 'ytD52UB5AfM', title: 'Biodiversity and Alien Species', meta: '5:16' },
  { id: 'SU1TInSVU-E', title: 'Capacity Building', meta: '6:29' },
  { id: 'cB0iVeYEa9I', title: 'Green New Deal', meta: '4:57' },
  { id: 'MkGWbkoyYJ4', title: 'The Birth of a Flag', meta: '2:51' },
  { id: '7jxwlv3Lfyw', title: 'Sea Tourism Sector', meta: '7:51' },
  { id: 'nkd4TodlLn0', title: 'Blueslinks — KIC One Water', meta: '4:56' },
  { id: 'MzrlPIrV24o', title: 'Blueslinks — 1st & 2nd Nautical Info Days', meta: '7:13' },
  { id: '-k-tta-0tqc', title: 'Blueslinks — Learning the Blue Economy through AI', meta: '1:49' },
  { id: '8UJftzvRfIk', title: 'Blueslinks — Project Meeting & Steering Committee, Ecomondo 2024', meta: '2:23' },
];

const hackathons = [
  {
    id: 'ancona-2024',
    title: 'Ancona 2024 — 48 ore per decifrare il mare',
    when: '23–24 maggio 2024',
    where: 'Sala Eventi Unicorn, Passetto, Ancona — nella settimana di Tipicità in Blu',
    facts:
      "Organizzato da Polo Tecnologico Alto Adriatico, Università Politecnica delle Marche, Università di Trieste, IRBIM CNR e OGS, co-finanziato dal progetto EIT Reginna 4.0 e dal PNRR iNEST, in collaborazione con Tipicità in Blu, Comune di Ancona e Confindustria Ancona Piccola Industria. 50 tra studenti maggiorenni, neolaureati e dottorandi. Conduzione di Marco Ardemagni (RAI Caterpillar AM).",
    main: { id: 'iypiTFOGyBk', title: 'The Blue Way Hackathon — 48 ore per decifrare il mare', meta: '3:15' },
    related: [
      { id: 'LnubZd1h3u8', title: 'The Blue Way Hackathon — Le voci dei protagonisti', meta: '5:41' },
      { id: 'aJ2kiPim2q4', title: 'The Blue Way Hackathon — Trailer', meta: '0:46' },
      { id: 'CYjcJINBLUQ', title: 'The Blue Way Hackathon 2024 — documentario completo', meta: '17:34' },
    ],
  },
  {
    id: 'ancona-2025',
    title: 'Ancona 2025 — edizione nautica',
    when: 'maggio 2025, settimana di Tipicità in Blu',
    where: 'Mole Vanvitelliana, Ancona',
    facts:
      'Inquadrato nel progetto Interreg Italia-Croazia Blueslinks, focus su Transition 4.0/5.0 e principi ESG applicati al settore nautico e alla portualità turistica. Quattro team al lavoro su altrettante sfide proposte da PMI del settore: WAVE, PORT PULSE, BLUE ACCESS, KNOT.',
    main: { id: 'xmwevSIJNwY', title: 'The Blue Way Hackathon — Nautical Edition', meta: '4:55' },
    related: [
      { id: 'cH1PlMpigLM', title: 'The Blue Way Hackathon 2025 — WAVE', meta: '3:39' },
      { id: 'eRJNYEPIOR4', title: 'The Blue Way Hackathon 2025 — PORT PULSE', meta: '4:03' },
      { id: '1so4BMui_68', title: 'The Blue Way Hackathon 2025 — BLUE ACCESS', meta: '2:36' },
      { id: 'xcqPtoV4iqg', title: 'The Blue Way Hackathon 2025 — KNOT', meta: '2:52' },
    ],
  },
  {
    id: 'trieste-2025',
    title: 'Trieste 2025 — Sfide per l’Adriatico del Futuro',
    when: '13–14 ottobre 2025, dentro Barcolana57',
    where: 'Urban Center, Corso Cavour 2/2, Trieste',
    facts:
      "Proposto dal progetto PNRR iNEST (Spoke 8) in collaborazione con Barcolana57. 30 partecipanti in rappresentanza di 15 startup e spin-off universitari, cinque team intitolati ai venti dell'Adriatico. Classifica finale: 1° Scirocco (AQUATWIN), 2° Libeccio (Barcolà), 3° ex aequo Tramontana (B.E.M.) e Bora (SCOVAZ), 4° Maestrale (Blue Echo). Giuria: Elena Grech (Commissione Europea), Carlo Bagnoli (iNEST), Franco Scolari (Polo Tecnologico Alto Adriatico), Piero Zecchini (Direttore Barcolana), Sonia Lussi (Confindustria Alto Adriatico).",
    main: { id: 'aEM526rP08Q', title: 'The Blue Way Hack — Sfide per l’Adriatico del Futuro', meta: '3:13' },
    related: [
      { id: '-5aOGey7Aco', title: 'Team Scirocco — AquaTwin (1°)', meta: '2:02' },
      { id: '5zF-WP9ELIk', title: 'Team Libeccio — Barcolà (2°)', meta: '2:19' },
      { id: 'GMhwh01De2Q', title: 'Team Tramontana — B.E.M. (3° ex aequo)', meta: '3:22' },
      { id: 'SiNLWE3-y9M', title: 'Team Bora — Scovaz (3° ex aequo)', meta: '1:45' },
      { id: 'Na-TwzLKaJI', title: 'Team Maestrale — Blue Echo (4°)', meta: '3:25' },
    ],
  },
];

// Il giornale di bordo: voci datate, si legge dall'alto. NON è una
// timeline interattiva (quella è la moviola di Tipicità: non si replica).
const logbook = [
  { date: '2014 · Ancona', text: 'Prima edizione: il festival porta il “laboratorio” fuori dai laboratori. La Mole Vanvitelliana diventa la base.' },
  { date: 'maggio 2024 · Ancona', text: 'Vara The Blue Way: il primo hackathon mette nello stesso equipaggio studenti della Politecnica e di Trieste.' },
  { date: 'maggio 2025 · Ancona', text: 'Dodicesima edizione, sette giorni: Sailing Chef a Marina Dorica, i cantieri Fincantieri aperti alle visite, l’escape room del mare per le scuole, 48 ore di hackathon italo-croato alla Mole.' },
  { date: 'ottobre 2025 · Trieste', text: 'The Blue Way sale a bordo di Barcolana57: quindici spin-off, cinque sfide, un gemello digitale dell’Alto Adriatico sul tavolo.' },
  { date: 'maggio 2026 · Ancona', text: 'Tredicesima edizione, 16–22 maggio. Blue Economy Days con la Commissione Europea: mercati in trasformazione, export digitale, intelligenza artificiale, biodiversità marina e ruolo femminile nello sviluppo costiero. L’Atlante degli artisti marchigiani apre la settimana: anche l’arte tiene il registro.' },
];

const chapters = [
  { id: 'rotta', label: 'Rotta' },
  { id: 'cantiere', label: 'Cantiere' },
  { id: 'giornale-di-bordo', label: 'Giornale di bordo' },
];

// CROMIA (10/07/2026): Tipicità in Blu vive nel blu profondo della sua
// palette ufficiale (112f49), con il 209fb6 come accento luminoso.
// Logo: variante bianca (la versione a colori, 065082, sparirebbe sul blu).
const theme = {
  '--bg-void': '#0a1a2b',
  '--bg-deep': '#112438',
  '--bg-mid': '#173049',
  '--text-soft': '#e9eef2',
  '--text-dim': 'rgba(233, 238, 242, 0.64)',
  '--text-faint': 'rgba(233, 238, 242, 0.4)',
  '--hairline': 'rgba(233, 238, 242, 0.14)',
};

// NOTA PER PAOLO: l'edizione 2026 (16–22 maggio) è già passata rispetto a
// oggi, quindi resta come ultima voce del registro e non viene annunciata
// come prossima. Niente schema.org Event finché non ci sono le date 2027.
---

<BrandLayout
  title="Tipicità in Blu — Ancona, il mare come laboratorio di futuro"
  description="Tipicità in Blu, Ancona: una settimana all'anno l'Adriatico diventa un laboratorio a cielo aperto. Blue economy, ricerca, cooperazione adriatica e la piattaforma The Blue Way."
  accent="#209fb6"
  brandName="Tipicità in Blu"
  chapters={chapters}
  logoSrc="/logos/tipicita-in-blu-white.svg"
  kicker="Ancona · ogni anno a maggio"
  heroLine="Mare, laboratorio di futuro."
  theme={theme}
  variant="v-tib"
>
  <Fragment slot="practical">
    <span class="fix">43°37′N 13°30′E</span>
    <span><strong>Base</strong> Ancona, Mole Vanvitelliana</span>
    <span><strong>Ultima edizione</strong> 13ª · 16–22 maggio 2026</span>
  </Fragment>

  <!-- ══ 01 · ROTTA — la direzione ══ -->
  <section class="chapter" id="rotta">
    <h2 data-reveal>Rotta</h2>

    <p data-reveal>Il mare non è un paesaggio: è un'infrastruttura. Ci passano le merci, l'energia, i dati, il cibo — e le domande a cui nessun laboratorio a terra sa rispondere da solo. Tipicità in Blu esiste per questo: una settimana all'anno, ad Ancona, il mare Adriatico diventa un laboratorio a cielo aperto.</p>

    <!-- il dato in evidenza: lettura da strumento, non da brochure -->
    <div class="quadrante" data-reveal>
      <span class="q-label">Il dato di rotta</span>
      <div class="q-letture">
        <div class="q-lettura">
          <span class="q-num">~3%</span>
          <span class="q-desc">del PIL italiano — quanto vale oggi l'economia del mare</span>
        </div>
        <div class="q-lettura">
          <span class="q-num">&gt;3×</span>
          <span class="q-desc">il potenziale stimato</span>
        </div>
      </div>
      <p class="q-nota">La distanza tra questi due numeri è la rotta: ricerca che diventa impresa, porti che diventano piattaforme, mestieri del mare che diventano carriere per chi oggi studia.</p>
    </div>

    <h3 data-reveal>La posizione</h3>
    <p data-reveal>Ancona non è un punto qualsiasi della costa: è il capoluogo affacciato sul corridoio adriatico-ionico, dove l'Europa sperimenta la cooperazione tra due sponde. Da qui si lavora con università, centri di ricerca e imprese di due nazioni — perché l'Adriatico non divide due coste: le tiene insieme.</p>

    <h3 data-reveal>Chi tiene la barra</h3>
    <p data-reveal>Il festival è co-organizzato con il Comune di Ancona, con Regione Marche, Università Politecnica delle Marche e una rete di partner che va da Fincantieri a MSC, da Marina Dorica a Ecomondo. Non un cartellone di sponsor: l'equipaggio.</p>
  </section>

  <!-- ══ 02 · CANTIERE — The Blue Way ══
       Regola di Paolo: la piattaforma PRIMA, gli hackathon come esempi POI. -->
  <section class="chapter" id="cantiere">
    <h2 data-reveal>Cantiere</h2>

    <p data-reveal><strong>The Blue Way</strong> è un cantiere in movimento: una piattaforma permanente che prende i risultati della ricerca sul mare e li accompagna fino a diventare prototipi, imprese, progetti finanziabili. Promossa con il consorzio iNEST e una rete di atenei dell'arco adriatico — Politecnica delle Marche, Trieste, Udine, Bari, SISSA — con un obiettivo dichiarato: trasformare tre anni di ricerca in soluzioni scalabili.</p>

    <h3 data-reveal>Come lavora il cantiere</h3>
    <p data-reveal>Design sprint, non convegni: squadre multidisciplinari, sfide reali poste da imprese e centri di ricerca, mentori, 30–48 ore di lavoro, un prototipo alla fine. Le sfide sono concrete: biologia degli ecosistemi marini, gestione dei rischi sull'idrosfera, trasporto costiero sostenibile, pianificazione integrata terra-mare, il gemello digitale dell'Alto Adriatico.</p>

    <div class="blue-pillole">
      <h3 data-reveal>Pillole — progetti e buone pratiche</h3>
      <p class="pillole-intro" data-reveal>Una raccolta pensata per chi lavora nella blue economy — europrogettisti, ricercatori, operatori — con casi, progetti europei e buone pratiche condivisi dalla rete The Blue Way.</p>
      <div class="video-grid" data-reveal>
        {bluePillole.map((v) => (
          <VideoCard youtubeId={v.id} title={v.title} meta={v.meta} />
        ))}
      </div>
    </div>

    <div class="blue-hackathons">
      <h3 data-reveal>Gli esempi</h3>
      <p class="pillole-intro" data-reveal>Ad Ancona, l'hackathon nel vivo del festival: laureati e giovani imprenditori di Italia e Croazia, in due lingue, su sfide poste dalle PMI della nautica — Transizione 5.0 ed ESG — dentro il programma Interreg Italia–Croazia BLUESLINKS. A Trieste, dentro Barcolana — la regata più partecipata del mondo — la selezione degli spin-off universitari: quindici squadre, cinque sfide, il Polo Tecnologico Alto Adriatico e KIC One Water al tavolo.</p>

      {hackathons.map((h) => (
        <article class="hack-card" data-reveal>
          <h4>{h.title}</h4>
          <div class="hack-meta">
            <span><strong>Quando</strong> {h.when}</span>
            <span><strong>Dove</strong> {h.where}</span>
          </div>
          <p class="hack-facts">{h.facts}</p>
          <div class="hack-main-video">
            <VideoCard youtubeId={h.main.id} title={h.main.title} meta={h.main.meta} />
          </div>
          <div class="video-grid video-grid--related">
            {h.related.map((v) => (
              <VideoCard youtubeId={v.id} title={v.title} meta={v.meta} />
            ))}
          </div>
        </article>
      ))}
    </div>

    <div class="varco" data-reveal>
      <h3>Per chi progetta</h3>
      <p>Se scrivi progetti europei, qui trovi consorzi già rodati su Interreg e iNEST, due sponde dell'Adriatico già connesse e una piattaforma che sa passare dal paper al prototipo. Il cantiere è aperto.</p>
      <a class="varco-link" href="https://theblueway.it" target="_blank" rel="noopener">theblueway.it</a>
    </div>
  </section>

  <!-- ══ 03 · GIORNALE DI BORDO — le annotazioni ══
       Registro nautico: voci datate, si legge dall'alto. Non interattivo. -->
  <section class="chapter" id="giornale-di-bordo">
    <h2 data-reveal>Giornale di bordo</h2>

    <ol class="registro">
      {logbook.map((v) => (
        <li data-reveal>
          <span class="r-data">{v.date}</span>
          <span class="r-testo">{v.text}</span>
        </li>
      ))}
    </ol>

    <p class="registro-chiusura" data-reveal>Un festival che dura una settimana, un cantiere che lavora tutto l'anno. Il giornale di bordo resta aperto.</p>
    <p class="fix fix--chiusura" data-reveal>43°37′N 13°30′E — prossima annotazione: maggio 2027.</p>
  </section>
</BrandLayout>

<style>
  /* ── La strumentazione: monospazio da plancia per coordinate e date ──
     Stack di sistema: nessun font aggiuntivo da scaricare. */
  .fix {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--brand-accent);
  }

  .fix--chiusura {
    margin-top: 1.4rem;
    color: var(--text-faint);
  }

  /* ── Il quadrante: il dato di rotta come lettura da strumento ── */
  .quadrante {
    border: 1px solid var(--hairline);
    border-left: 2px solid var(--brand-accent);
    background: var(--bg-deep);
    padding: 1.6rem 1.6rem 1.4rem;
    margin: 2rem 0 2.4rem;
  }

  .q-label {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 1.1rem;
  }

  .q-letture {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 3rem;
  }

  .q-lettura {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    max-width: 30ch;
  }

  .q-num {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: clamp(2.2rem, 5vw, 3rem);
    line-height: 1;
    color: var(--brand-accent);
    flex: none;
  }

  .q-desc {
    font-family: 'Manrope', sans-serif;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .q-nota {
    margin: 1.2rem 0 0;
    font-size: 0.95rem;
    color: var(--text-dim);
    max-width: 62ch;
  }

  /* ── Il varco verso la piattaforma ── */
  .varco {
    border-top: 1px solid var(--hairline);
    margin-top: 2.6rem;
    padding-top: 1.8rem;
  }

  .varco p {
    max-width: 62ch;
    color: var(--text-dim);
  }

  .varco-link {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9rem;
    color: var(--brand-accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--brand-accent) 45%, transparent);
    padding-bottom: 2px;
  }

  .varco-link:hover {
    border-color: var(--brand-accent);
  }

  /* ── Il registro: voci datate, allineate come un log ── */
  .registro {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    border-top: 1px solid var(--hairline);
  }

  .registro li {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: 0 1.6rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--hairline);
  }

  .r-data {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--brand-accent);
    padding-top: 0.2rem;
  }

  .r-testo {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-dim);
    max-width: 62ch;
  }

  .registro-chiusura {
    margin-top: 1.8rem;
    max-width: 62ch;
  }

  @media (max-width: 700px) {
    .registro li { grid-template-columns: 1fr; gap: 0.35rem; }
    .r-data { padding-top: 0; }
  }

  /* ── Cantiere: pillole e hackathon (invariati) ── */
  .blue-pillole,
  .blue-hackathons {
    margin-top: 2.4rem;
  }

  .blue-pillole h3,
  .blue-hackathons h3 {
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
  }

  .pillole-intro {
    font-family: 'Manrope', sans-serif;
    font-size: 0.88rem;
    color: var(--text-dim);
    max-width: 62ch;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.6rem 1.2rem;
    margin: 1.4rem 0 0.4rem;
  }

  .video-grid--related {
    margin-top: 1rem;
  }

  .hack-card {
    border-top: 1px solid var(--hairline);
    padding: 2.2rem 0;
  }

  .hack-card:first-of-type {
    margin-top: 1.8rem;
  }

  .hack-card h4 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--brand-accent);
    margin: 0 0 0.5rem;
  }

  .hack-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.4rem;
    font-family: 'Manrope', sans-serif;
    font-size: 0.82rem;
    color: var(--text-dim);
    margin-bottom: 0.8rem;
  }

  .hack-meta strong {
    color: var(--text-soft);
    font-weight: 500;
  }

  .hack-facts {
    font-family: 'Manrope', sans-serif;
    font-size: 0.88rem;
    color: var(--text-dim);
    max-width: 62ch;
  }

  .hack-main-video {
    max-width: 360px;
    margin: 1.2rem 0 0.6rem;
  }
</style>
