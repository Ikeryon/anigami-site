---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pellicola from '../../components/Pellicola.astro';

// LANDING TIPICITÀ IN BLU — la fabula è LA STRUMENTAZIONE
// (ANIGAMI-METANARRATIVA §3): la pagina è una PLANCIA. Sezioni codificate,
// coordinate, dati in evidenza, registro tecnico-nautico. La sobrietà È la
// fabula: qui il virtuosismo sta nella precisione, non nell'effetto.
//
// ⚠️ OSSATURA NON REPLICABILE: due sole matrici, .Rotta e .Cantiere.
// Niente deck a quadri, niente moviola, niente card orizzontali: sono
// dispositivi di Tipicità e non si ereditano. Niente timeline/giornale di
// bordo (rimosso in v2 su indicazione di Paolo).
//
// TESTI: trascritti TALI E QUALI da TESTI-TIB.md v3 (Cowork 19/08/2026),
// che sostituisce integralmente la v2 ed è rivisto sul reportage 2025.
// Non riscriverli. §1 e §5 del file sono diagnosi e avvertenze per Paolo e
// NON vanno in pagina.
// Registro da SCHEDA: si afferma ciò che la piattaforma È, mai "potremmo".
// I quattro formati pubblici ora CI SONO (v3 §4): erano fuori nella v2 per
// tenere un profilo tecnico, ma sono la prova visibile della tesi della
// pagina, e la prova sta dopo la tesi.
//
// MOTO: solo taglio e dissolvenza (ANIGAMI-REGIA §1). Una intenzione per
// viewport, durate 200–600ms, easing unico condiviso con Tipicità.

const theme = {
  '--bg-void': '#0a1a2b',
  '--bg-deep': '#112438',
  '--bg-mid': '#173049',
  '--text-soft': '#e9eef2',
  '--text-dim': 'rgba(233, 238, 242, 0.72)',
  // 0.58: sotto questa soglia il testo piccolo scende sotto il 4.5:1 AA
  // sul fondo #0a1a2b (verificato a schermo, non a occhio).
  '--text-faint': 'rgba(233, 238, 242, 0.58)',
  '--hairline': 'rgba(233, 238, 242, 0.16)',
};

// L'ARCHITETTURA (TESTI-TIB v3 §2.4, blocco nuovo). Va subito dopo la visione:
// è la risposta alla domanda che il lettore si fa da tre paragrafi — che cosa
// succede, di preciso.
// ⚠️ NIENTE DATE IN QUESTO TESTO. Le date della prossima edizione stanno nella
// riga-plancia in cima e in nessun altro posto: se finiscono anche qui, ogni
// anno vanno corrette in tre punti e uno resta indietro.
// NB: il reportage chiama "matrici" questi tre blocchi di calendario. È la
// stessa parola che in codice nomina le due sezioni della pagina (.Rotta e
// .Cantiere) — in pagina non si incrociano mai, perché la nav mostra i nomi
// delle sezioni e non la parola. Le sezioni restano due.
const architettura = [
  {
    nome: 'Il Weekend Blu',
    testo: 'due giorni ad alta intensità fra Marina Dorica e la Mole Vanvitelliana: regate, esperienze di cucina, mostre, visite.',
  },
  {
    nome: 'Le Giornate della Blue Economy',
    testo: 'cinque giorni di lavoro fra la Mole, la Facoltà di Ingegneria dell’Università Politecnica delle Marche e il Passetto: formazione, innovazione, imprese, ricerca, e in chiusura l’hackathon e il forum.',
  },
  {
    nome: 'Il circuito cittadino',
    testo: 'per tutta la durata, mostre e itinerari nei luoghi della città e nei locali che aderiscono, che tengono insieme le due anime e le portano fuori dalle sedi.',
  },
];

// I FORMATI (TESTI-TIB v3 §4). Stanno in .Rotta, dopo l'architettura: sono la
// prova, e la prova va dopo la tesi. Non aprono una terza sezione — la regola
// delle due matrici resta.
const formati = [
  {
    nome: 'Blu Village',
    dove: 'la cittadella della ricerca sul mare, in Piazza Cavour, con l’Università Politecnica delle Marche',
    testo: 'Per una giornata la ricerca sul mare esce dai laboratori e si mette in piazza: exhibit, talk, laboratori, dimostrazioni. Scienza, innovazione, sostenibilità e impresa in un racconto che si può toccare con mano. Il mare smette di essere solo l’elemento identitario del territorio e diventa una piattaforma di conoscenza condivisa.',
  },
  {
    nome: 'Sailing Chef',
    dove: 'Marina Dorica, apre la stagione velica',
    testo: 'Una regata gourmet. Ogni equipaggio riceve una cassetta di prodotti ittici abbinati a eccellenze agricole selezionate; in navigazione la ciurma cucina, e al rientro in porto una giuria assaggia. La classifica nasce dall’incontro fra performance sportiva, creatività culinaria e capacità di raccontare il mare attraverso i sapori.',
  },
  {
    nome: 'Visita il Cantiere',
    dove: 'partenza dalla Mole, accesso gratuito su prenotazione',
    testo: 'Un luogo normalmente chiuso si apre: la cantieristica navale vista da dentro, le professioni blu, i processi produttivi, il design. Cittadini, appassionati, studenti e famiglie entrano nel cuore di un luogo simbolico per l’economia e l’identità marittima della città.',
  },
  {
    nome: 'Menù in Blu e Aperiblu',
    dove: 'nei locali della città',
    testo: 'Il festival esce dalle sedi e si distribuisce in città: per una settimana il circuito dei ristoranti e dei bar propone il pesce dell’Adriatico. È il modo più semplice per dire che il mare, qui, non è un tema di convegno.',
  },
];

// IL QUADRO STRUMENTI: i sette ambiti veri (TESTI-TIB v3 §2.5).
// ⚠️ I dieci tag di prima erano verosimili, ed era quello il problema:
// verosimili invece che veri. Questa è la tassonomia della manifestazione,
// quella disegnata a ruota nel reportage 2025. Sono SETTE, e il numero conta:
// la ruota ha sette settori, e il conto si legge.
const strumenti = [
  'Innovazione e start-up',
  'Idrosfera',
  'Multifunzionalità',
  'Economia circolare',
  'Cantieristica navale',
  'Confronti internazionali',
  'Ricerca e progetti europei',
];

// L'estensione tematica per esteso: in corpo minore, sotto gli ambiti. È la
// parte che un europrogettista legge davvero.
const estensione =
  'Cultura, cibo e territorio, turismo, filiera ittica e acquacoltura, specie autoctone e aliene. Cantieristica, nautica e diporto, infrastrutture e mobilità, sub-fornitura nautica. Intelligenza artificiale e nuove tecnologie, creatività applicata, nuova impresa giovanile. Sostenibilità, economia circolare e del riuso, ciclo delle acque e depurazione. Progetti europei e internazionalizzazione.';

// LE METRICHE (TESTI-TIB v3 §2.6) — cambio di sostanza, non di forma.
// Fuori i 216,7 miliardi e le tre cifre nazionali: non sono numeri di Tipicità
// in Blu ma dell'economia del mare italiana, e un dato non tuo in posizione di
// dato tuo è la cosa che logora di più la fiducia di chi legge.
// Dentro quattro numeri propri, scelti perché INVECCHIANO PIANO: una landing
// dura più di un'edizione. Per la stessa ragione non ci sono le cifre di
// edizione (8 giorni, 34 partner, 31 iniziative): il reportage si contraddice
// sull'edizione a cui appartengono — §5 del documento — e finché non è chiaro
// non vanno attribuite al 2025.
// Niente più conteggio da zero: su «2014» e su «0» un contatore che sale è
// un effetto su numeri che non lo meritano (GRIGLIA-TIB §5).
const metriche = [
  { num: '2014', label: 'l’anno della prima edizione: il festival è oltre il giro di boa del suo primo decennio' },
  { num: 'oltre 30', label: 'i partner pubblici e privati di ogni edizione' },
  { num: 'oltre 25', label: 'le aziende del territorio che la sostengono' },
  { num: '0', label: 'i contributi pubblici ricevuti' },
];

// GLI SPECCHI DEL CANTIERE (TESTI-TIB v3 §3.3): non tre schede pari ma una
// cronologia. L'hackathon non è un evento del 2025 — le edizioni di Ancona
// sono DUE, ed è da lì che è partita quella di Trieste. Un formato che nasce
// in casa, si ripete e poi viene adottato altrove dimostra da sé che The Blue
// Way non è un cartellone ma un cantiere che produce.
// ⚠️ PATERNITÀ: The Blue Way nasce da Tipicità in Blu e dal Polo Tecnologico
// Alto Adriatico. iNEST compare qui perché è nei progetti dentro cui
// l'hackathon 2024 è nato e perché promuove la tappa triestina — non nella
// nascita della piattaforma.
// ⚠️ Le fonti pubbliche sulla tappa di Trieste NON dicono che discende dalle
// due edizioni anconetane: quella è la storia di casa, e qui è affermata come
// tale senza contraddire il fatto che a Trieste i promotori sono iNEST e
// Barcolana.
const cronologia = [
  {
    testa: 'Ancona, maggio 2024',
    sotto: 'la prima edizione',
    par: [
      'Quarantun partecipanti da tutto il mondo, otto squadre, quarantotto ore. Curata dal Polo Tecnologico Alto Adriatico dentro i progetti Reginna 4.0 e iNEST, con l’Università Politecnica delle Marche, l’Università di Trieste, l’OGS, l’IRBIM del CNR e il Comune di Ancona. Vince <b>Finding Algae</b>: un drone che raccoglie le alghe che infestano fondali e litorali. La squadra vincitrice è mista, studenti di Ancona e di Trieste insieme — le due città lavoravano già allo stesso tavolo prima che a Trieste ci fosse una tappa.',
    ],
  },
  {
    testa: 'Ancona, 22–23 maggio 2025',
    sotto: 'la seconda edizione',
    par: [
      '«The nautical edition»: il campo si stringe sulla nautica. Quarantotto ore dentro il BLUESLINKS Innovation Hub del programma Interreg Italia-Croazia, aperte a laureati e giovani startupper delle due sponde, con facilitatori bilingui italiano-croato. Le sfide arrivano dalle imprese e riguardano Transizione 5.0 ed ESG. Networking, presentazione delle challenge, prototipazione, pitch davanti alla giuria, voucher tecnologici ai primi due team. Vince <b>Blue Access</b>, una piattaforma per rendere il turismo marino più accessibile e inclusivo.',
    ],
  },
  {
    testa: 'Trieste, 13–14 ottobre 2025',
    sotto: 'il format cambia città',
    par: [
      'Dalle due edizioni anconetane nasce <b>The Blue Way Hack</b>, all’Urban Center di Trieste dentro Barcolana57. Lo promuove il consorzio di ricerca iNEST e lo organizza il Polo Tecnologico Alto Adriatico; Tipicità in Blu e The Blue Way sono fra i partner, insieme a OGS, alle università di Trieste, Udine, Ancona e Bari e a FermoTech. Trenta partecipanti in rappresentanza di quindici start-up e spin-off universitari da Friuli Venezia Giulia, Veneto, Marche e Puglia; oltre trenta ore su cinque temi — biologia degli ecosistemi marini, rischi fisici e chimici dell’idrosfera, trasporto costiero sostenibile, pianificazione integrata fra terra e mare, gemello digitale dell’Alto Adriatico.',
      'Cambiando città il formato ha alzato il tiro: ad Ancona correvano squadre di studenti, a Trieste imprese già costituite.',
    ],
  },
  {
    testa: 'Il lavoro che non si vede',
    sotto: '',
    par: ['Reti di progetto, scambi tra laboratori, accompagnamento delle idee premiate verso bandi e mercati.'],
  },
];

// Chi trova cosa: scheda, non pitch. Si descrive, non si offre.
const trova = [
  'La ricerca vi trova la strada più corta tra un risultato scientifico e la sua applicazione.',
  'Le imprese vi trovano problemi formulati bene e squadre giovani che li aggrediscono senza rendite di posizione.',
  // ⚠️ iNEST tolto da qui (TESTI-TIB §2bis): non è un consorzio su cui
  // The Blue Way sia "rodato", è un partner di un singolo progetto.
  'Chi progetta su fondi europei vi trova consorzi già rodati sui programmi Interreg, due sponde già connesse, casi pilota documentati.',
  'Le istituzioni vi trovano un formato che tiene insieme sviluppo costiero, formazione e tutela — le tre cose che di solito viaggiano separate.',
  'Gli studenti vi trovano il primo cantiere in cui il mare è una carriera possibile, non una vacanza.',
];

// ── LE IMMAGINI: due famiglie e due soltanto (GRIGLIA-TIB §3) ──
//
// ⚠️ STATO DI RISERVA. In public/tib/ ci sono due file: fondo.mp4 e il suo
// poster. Fotografie di Tipicità in Blu non ne esiste nessuna, né nel
// repository né nelle cartelle collegate — l'archivio è quello del festival di
// Fermo, che è un'altra manifestazione e non si saccheggia per riempire questa.
// Finché il materiale non arriva, ogni lastra resta il campo virato con la sua
// etichetta: dignitoso, e non sembra un errore. Quando le fotografie ci saranno
// basta dare un `src` qui — markup, misure e viratura sono già al loro posto.
//
// La didascalia è obbligatoria e porta un fatto: se non aggiunge niente, la
// lastra non serve.
const lastre = {
  'Blu Village': { idx: '01', did: ['Blu Village', 'Piazza Cavour'], src: null },
  'Sailing Chef': { idx: '02', did: ['Sailing Chef', 'Marina Dorica'], src: null },
  'Visita il Cantiere': { idx: '03', did: ['Visita il Cantiere', 'il bacino'], src: null },
  'Menù in Blu e Aperiblu': { idx: '04', did: ['Menù in Blu', 'i locali della città'], src: null },
};
// l'unica lastra verticale della pagina: 3:4, a fianco della squadra
const lastraSquadra = { idx: '05', did: ['Il tavolo di lavoro', 'Ancona'], src: null };
// l'unica fotografia a colori pieni: la cerniera fra .Rotta e l'architettura
const banda = { did: ['Il waterfront', 'Ancona, dal porto a Marina Dorica'], src: null };

// Le schede tecniche a lato delle due aperture: fatti già affermati altrove in
// pagina, messi in colonna. Una scheda non introduce mai un dato nuovo.
const schedaRotta = [
  ['Dove', 'Ancona — Mole Vanvitelliana, Marina Dorica, Piazza Cavour'],
  ['Coordinate', '43°37′N 13°30′E'],
  ['Dalla prima edizione', '2014'],
];
const schedaCantiere = [
  ['Nasce da', 'Tipicità in Blu e Polo Tecnologico Alto Adriatico'],
  ['Atenei', 'Politecnica delle Marche, Trieste, Udine, Bari, SISSA'],
  ['In rete', 'theblueway.it'],
];

// ── LA RUOTA DEGLI AMBITI ──
// Sette settori su un anello, quadrante vuoto al centro: legge come un
// quadrante di strumento e non come un grafico a torta. Le tinte sono tutte
// nella scala del blu della pagina — nessun arcobaleno.
// Il disegno è decorativo: l'informazione vive nell'elenco a fianco, che è la
// versione accessibile della ruota (GRIGLIA-TIB §7).
const TINTE = ['#0d3b4c', '#12556b', '#187a94', '#209fb6', '#3fb3c6', '#166a83', '#0f4a5e'];
const RUOTA = { cx: 100, cy: 100, r: 82, ri: 30, gap: 1.6 };
const settore = (i, n) => {
  const { cx, cy, r, ri, gap } = RUOTA;
  const passo = 360 / n;
  const P = (a, rad) => [
    +(cx + rad * Math.cos(((a - 90) * Math.PI) / 180)).toFixed(2),
    +(cy + rad * Math.sin(((a - 90) * Math.PI) / 180)).toFixed(2),
  ];
  const a0 = i * passo + gap, a1 = (i + 1) * passo - gap;
  const [x0, y0] = P(a0, r), [x1, y1] = P(a1, r);
  const [x2, y2] = P(a1, ri), [x3, y3] = P(a0, ri);
  return `M${x0} ${y0} A${r} ${r} 0 0 1 ${x1} ${y1} L${x2} ${y2} A${ri} ${ri} 0 0 0 ${x3} ${y3} Z`;
};

// ── LA STRISCIA DELLE TRE MATRICI ──
// Tabella di marcia, che è esattamente il registro della plancia. Le durate
// sono quelle dichiarate nel testo dell'architettura — due giorni e cinque
// giorni — e l'asse è la loro somma: sette.
// ⚠️ Niente «otto giorni»: quella cifra viene dalla parte del reportage che si
// contraddice sull'edizione (TESTI-TIB §5), e un asse disegnato su un numero
// incerto è un errore che si vede.
const GIORNI = 7;
const marcia = [
  { nome: 'Weekend Blu', dove: 'Marina Dorica · la Mole', da: 1, a: 3, tratto: false },
  { nome: 'Giornate della Blue Economy', dove: 'la Mole · Ingegneria · il Passetto', da: 3, a: 8, tratto: false },
  // il circuito è diffuso e non concentrato: a tratteggio, non pieno
  { nome: 'Circuito cittadino', dove: 'la città e i locali', da: 1, a: 8, tratto: true },
];

// ── IL FRAMMENTO DI CARTA ──
// ⚠️ Il profilo NON è disegnato a mano: è ricalcato da coordinate reali di
// porti e capi (proiezione equirettangolare centrata sul medio Adriatico, poi
// ruotata perché l'asse del bacino — Venezia-Otranto — diventi orizzontale e le
// due sponde si leggano parallele). Scala unica sui due assi: nessuna
// deformazione, 1 unità = 0,98 km. Controllo sulle distanze vere: Ancona-Zara
// 149 contro 145 km, Ancona-Rimini 91 contro 92, Ancona-Pescara 139 contro 140.
// Una costa adriatica sbagliata la nota chiunque abiti su quella costa, cioè il
// pubblico di questa pagina.
// Si vede il gomito: il Conero sporge di venticinque chilometri sulla linea di
// costa, ed è esattamente l'Ankón di cui parla «La posizione».
const CARTA = {
  box: '0 0 420 240',
  ovest:
    'M33.8 206.3 L57.3 218.8 L85.4 218.9 L104 216.3 L116.5 208.5 L129.3 207.5 L150.3 203.7 L167.1 199.6 L174.4 192.8 L182.1 190.7 L186.3 191.1 L189.8 194 L198.8 197.3 L212.9 201.7 L221.2 202.4 L227.8 206.9 L237.3 209.6 L252.7 219.4 L273.3 228.3 L292.1 232.4 L310.8 233.1 L331.3 230 L363.9 223.1 L393 218.6 L423.6 203.5',
  est:
    'M18.4 58.8 L40.2 69.8 L55.3 78.3 L85.1 79.9 L97.8 84.2 L97.6 63.5 L84.2 44.4 L69.3 16.6 L77.1 9.1 L113.1 1.8 L131 5.1 L155.6 25 L180.2 27.5 L219.2 21.8 L227.7 25.8 L223.5 48.2 L250.7 47.5 L292.3 35.3 L329.7 28.1 L340.7 16.9 L360.1 6.3 L389.8 -4.2',
  ancona: [174.4, 192.8],
  zara: [223.5, 48.2],
};

// DATE (Paolo, 07/08/2026): la riga-plancia guarda avanti a maggio 2027.
// Il giorno esatto non è ancora fissato → schema.org con precisione al mese
// (formato valido) e nessun claim di giorni che poi andrebbe corretto.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Tipicità in Blu',
  startDate: '2027-05',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: 'Mole Vanvitelliana',
    address: { '@type': 'PostalAddress', addressLocality: 'Ancona', addressRegion: 'Marche', addressCountry: 'IT' },
  },
  organizer: { '@type': 'Organization', name: 'Imagina Srl Società Benefit', url: 'https://anigami.it' },
};
---

<BaseLayout
  title="Tipicità in Blu — Ancona, il mare come laboratorio di futuro"
  description="Tipicità in Blu, Ancona: una settimana all'anno l'Adriatico diventa un laboratorio a cielo aperto. Blue economy, ricerca, cooperazione adriatica e il cantiere permanente The Blue Way."
  accent="#209fb6"
  structuredData={structuredData}
  theme={theme}
>
  <Pellicola slot="header" current="tipicita-in-blu" mode="dark" />

  <!-- ══ QUADRO D'APERTURA · LA PLANCIA ══ -->
  <header class="plancia">
    {/* IL FONDALE (Paolo, 09/08/2026). Il mare sta DIETRO la plancia, non
        al posto suo: la pagina resta quella con il reticolo e le
        coordinate, il video è materia in movimento al 30%.
        Crudo non reggeva — la scia del sole mangiava la riga di
        coordinate e la cromia passava dal navy al grigio caldo. Qui è
        desaturato, sfocato e scurito già in codifica (l'acqua che
        scintilla è il caso peggiore per un codec: sfocandola il file
        passa da 29 MB a 327 KB), con dissolvenze in entrata e in uscita
        perché la giuntura del loop non si veda.
        Sta per primo nel DOM: sopra ci vanno il reticolo e il contenuto,
        senza bisogno di z-index. */}
    <video
      class="fondale"
      src="/tib/fondo.mp4"
      poster="/tib/fondo-poster.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
      tabindex="-1"
    ></video>
    <div class="grigliato" aria-hidden="true"></div>
    <div class="plancia-in">
      <h1 class="sr-only">Tipicità in Blu</h1>
      <img class="marchio" src="/logos/tipicita-in-blu-white.svg" alt="Tipicità in Blu" width="320" height="120" />
      <p class="payoff">Mare, laboratorio di futuro</p>
      <!-- righe-dato in segmenti: su schermo stretto scendono UNO PER RIGA
           invece di spezzarsi a caso — la plancia resta plancia. -->
      <p class="fix fix--apertura">
        <span>43°37′N 13°30′E</span>
        <span>Ancona, Mole Vanvitelliana</span>
        <span>maggio 2027</span>
      </p>
      <nav class="matrici" aria-label="Sezioni">
        <a href="#rotta">.Rotta</a>
        <a href="#cantiere">.Cantiere</a>
      </nav>
    </div>
  </header>

  <!-- barra di strumento: resta agganciata, segna dove si è -->
  <div class="barra">
    <div class="barra-in">
      <img class="barra-marchio" src="/logos/tipicita-in-blu-white.svg" alt="" width="90" height="34" />
      <nav aria-label="Sezioni della pagina">
        <a href="#rotta" data-nav="rotta">.Rotta</a>
        <a href="#cantiere" data-nav="cantiere">.Cantiere</a>
      </nav>
      <span class="fix barra-fix" aria-hidden="true">43°37′N 13°30′E</span>
    </div>
  </div>

  <main>
    <!-- ══ .ROTTA — che cosa è, dove guarda ══ -->
    <section class="matrice" id="rotta" aria-labelledby="h-rotta">
      <div class="wrap">
        <h2 id="h-rotta" data-reveal>Rotta</h2>

        {/* «dove il mare incontra le persone» è una delle tre righe-firma
             verificate nei materiali di casa (REGISTRO §3): scende di grado
             dal payoff e diventa testo, qui, dove diceva già la stessa cosa
             con più parole. */}
        {/* v3 §2.1: aggiunti «pescatori, cuochi». Minimo e non casuale — la
             squadra tiene insieme scienziati e operatori portuali, e qui si
             elencava solo la metà istituzionale. */}
        <div class="campo">
          <div class="c1-7">
            <p class="apertura" data-reveal>Il mare non è un paesaggio: è un sistema produttivo, scientifico e culturale. Tipicità in Blu è il festival dove il mare incontra le persone che su quel sistema lavorano — imprese, ricercatori, istituzioni, naviganti, pescatori, cuochi — e chi nel mare vede una risorsa da capire prima che da sfruttare. Una settimana all'anno, ad Ancona, l'Adriatico diventa un laboratorio a cielo aperto.</p>

            {/* LA POSIZIONE (integrazione 07/08 dai materiali di casa): il
                 dettaglio erudito è breve, esatto, e fonda — non decora. */}
            <div class="blocco" data-reveal>
              <h3>La posizione</h3>
              <p>Ancona è il luogo esatto di questo discorso. Il nome viene dal greco <i lang="grc-Latn">Ankón</i>, gomito: la costa che si piega e si spinge dentro l'Adriatico. Una città di terra affacciata sul mare, con il porto che va da Marina Dorica all'arco di Traiano, e il quartier generale del festival alla Mole Vanvitelliana — ex lazzaretto su un'isola artificiale, fra la terra e l'acqua. Il sodalizio fra le due cose non è una metafora: è la geografia.</p>
            </div>
          </div>

          {/* La scheda a lato: fatti già affermati in pagina, messi in
               colonna. Non introduce mai un dato nuovo — se lo facesse
               sarebbe un paragrafo travestito da strumento. */}
          <aside class="c9-12 scheda" data-reveal>
            <dl>
              {schedaRotta.map(([voce, val]) => (
                <>
                  <dt>{voce}</dt>
                  <dd>{val}</dd>
                </>
              ))}
            </dl>
          </aside>
        </div>

        {/* v3 §2.3: riscritta con le parole del reportage. «Da mare a mare» e
             «il mare non è soltanto scenario ma principio generatore» sono
             formule testuali di casa, non invenzioni — per questo restano
             così come sono. Cambia anche l'attacco: «è una descrizione» e non
             «è un metodo», perché il metodo è dichiarato più sotto, nella
             squadra, e due volte sarebbe una ripetizione. */}
        <div class="campo">
          <div class="blocco c1-7" data-reveal>
            <h3>La visione</h3>
            <p>«Mare, laboratorio di futuro» non è uno slogan: è una descrizione. Le questioni che il mare pone — energia, cibo, trasporti, clima, lavoro — non si risolvono per compartimenti. Il festival le mette nello stesso spazio fisico e le fa parlare: la ricerca accanto al cantiere, la pesca accanto alla biotecnologia, la scuola accanto all'impresa. È un festival «da mare a mare», che si innesta nel tessuto cittadino e lo trasforma in un ecosistema dove il mare non è soltanto scenario, ma principio generatore di idee, progetti e collaborazioni.</p>
            <p>E il perimetro non si ferma alla costa. <b>Il mare inizia dalla montagna</b>: è la frase con cui Tipicità e il Polo Tecnologico Alto Adriatico hanno aperto Ecomondo, ed è un'affermazione idrografica prima che retorica. Bacini, fiumi, aree interne e acque costiere sono un sistema solo, e trattarli separati è il modo più rapido per sbagliare le politiche di tutti e due.</p>
          </div>
        </div>
      </div>

      {/* LA BANDA — l'unica cosa che esce dalla gabbia, e l'unica fotografia a
           colori pieni di tutta la pagina. Sta qui perché qui il lettore ha
           appena capito CHE COSA è e sta per scoprire COM'È FATTO: è la
           cerniera. Una banda funziona perché è una — due sono un carosello
           lento. */}
      <figure class="banda" data-reveal>
        {banda.src ? (
          <img src={banda.src} alt="" width="2400" height="1000" loading="lazy" decoding="async" />
        ) : (
          <div class="banda-riserva" aria-hidden="true"><em>in attesa di materiale</em></div>
        )}
        <figcaption class="wrap">
          <span class="d-idx">Banda</span>
          <span class="d-voce">{banda.did[0]}</span>
          <span class="d-luogo">{banda.did[1]}</span>
        </figcaption>
      </figure>

      <div class="wrap">
        {/* L'ARCHITETTURA (v3 §2.4): che cosa succede, di preciso. */}
        <div class="campo">
          <div class="blocco c1-7" data-reveal>
            <h3>L'architettura</h3>
            <p>La manifestazione ha tre matrici, e ognuna ha il suo tempo e il suo luogo.</p>
            <dl class="tempi">
              {architettura.map((a) => (
                <>
                  <dt>{a.nome}</dt>
                  <dd>{a.testo}</dd>
                </>
              ))}
            </dl>
          </div>
        </div>

        {/* LA STRISCIA DELLE TRE MATRICI: una tabella di marcia, che è
             esattamente il registro della plancia. L'informazione è già nel
             testo qui sopra — questa è la sua forma, non la sua unica sede,
             e per questo il disegno è aria-hidden e porta a fianco la
             legenda scritta. */}
        <div class="campo">
          <div class="c1-12 quadro quadro--marcia" data-reveal>
            <span class="quadro-label">La tabella di marcia</span>
            <div class="assi">
              <span class="a-scala" aria-hidden="true">
                {Array.from({ length: GIORNI }, (_, i) => <i>{i + 1}</i>)}
              </span>
              {marcia.map((m) => (
                <>
                  <span class="a-nome"><b>{m.nome}</b><i>{m.dove}</i></span>
                  <span
                    class:list={['a-barra', m.tratto && 'a-barra--rada']}
                    style={`grid-column:${m.da + 1}/${m.a + 1}`}
                    aria-hidden="true"
                  ></span>
                </>
              ))}
            </div>
            <p class="a-nota">Le durate sono quelle dichiarate qui sopra: due giorni, cinque giorni, e il circuito che tiene insieme tutto il periodo — a tratteggio perché è diffuso in città e non concentrato in una sede.</p>
          </div>
        </div>

        {/* I FORMATI (v3 §4): la prova, dopo la tesi. Ogni formato ha la sua
             lastra, in cornice a filo e virata nella cromia della pagina. */}
        <div class="campo">
          <div class="c1-12" data-reveal>
            <h3>I formati</h3>
            <div class="formati">
              {formati.map((f) => {
                const l = lastre[f.nome];
                return (
                  <article class="formato">
                    <figure class="lastra">
                      <div class="l-img">
                        {l.src ? (
                          <img src={l.src} alt="" width="1200" height="800" loading="lazy" decoding="async" />
                        ) : (
                          <em aria-hidden="true">in attesa</em>
                        )}
                      </div>
                      <figcaption>
                        <span class="d-idx">{l.idx}</span>
                        <span class="d-voce">{l.did[0]}</span>
                        <span class="d-luogo">{l.did[1]}</span>
                      </figcaption>
                    </figure>
                    <h4>{f.nome}</h4>
                    <p class="f-dove">{f.dove}</p>
                    <p class="f-testo">{f.testo}</p>
                  </article>
                );
              })}
            </div>
          </div>
        </div>

        {/* IL QUADRO STRUMENTI: la ruota, e a fianco il suo elenco.
             ⚠️ L'elenco NON è una didascalia del disegno: è la sede
             dell'informazione. La ruota ha role="img" e una sola etichetta,
             i settori sono presentazionali, e se il disegno non arriva — CSS
             spento, SVG bloccato — la pagina dice ancora tutto quello che
             deve dire. L'accensione reciproca è un di più, e sotto
             prefers-reduced-motion perde la transizione, non l'effetto. */}
        <div class="campo campo--ruota">
          <div class="c1-5 ruota-campo" data-reveal>
            <svg
              class="ruota"
              id="ruota"
              viewBox="0 0 200 200"
              role="img"
              aria-label={`I sette ambiti della manifestazione: ${strumenti.join(', ')}.`}
            >
              {strumenti.map((s, i) => (
                <path d={settore(i, strumenti.length)} fill={TINTE[i]} data-i={i} />
              ))}
            </svg>
          </div>
          <div class="c7-12 quadro" data-reveal>
            <span class="quadro-label">Il quadro strumenti · gli ambiti</span>
            <ul class="strumenti" id="ambiti">
              {strumenti.map((s, i) => (
                <li data-i={i}><span class="s-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="s-voce">{s}</span></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="campo">
          <p class="estensione c1-8" data-reveal>{estensione}</p>
        </div>

        {/* IL PANNELLO DELLE LETTURE: numeri propri, che invecchiano piano.
             Lo zero rompe la regolarità — sei colonne invece di tre, il filo
             in ciano, il numero a corpo enorme e la spiegazione accanto e non
             sotto. La rottura della regolarità è il modo di dare peso a un
             dato senza scrivere che è importante. Una sola per pagina:
             se se ne aggiunge una seconda, nessuna delle due pesa più. */}
        <div class="campo">
          <div class="c1-12 metriche" data-reveal>
            <span class="quadro-label">Le metriche</span>
            <dl class="letture">
              {metriche.map((m) => (
                <div class:list={['lettura', m.num === '0' && 'lettura--grande']}>
                  <dt class="l-num">{m.num}</dt>
                  <dd class="l-desc">{m.label}</dd>
                </div>
              ))}
            </dl>
            <p class="q-nota">Tipicità in Blu non riceve contributi pubblici: è sostenuta dalle imprese del territorio e da investimenti arrivati ad Ancona dal bacino adriatico. È la prova più concreta che i temi trattati generano economia, e non solo conversazione.</p>
          </div>
        </div>

        {/* Rinominato "Il corridoio": il titolo "La posizione" è passato al
             blocco nuovo sull'etimologia. TESTI-TIB §1 li chiama entrambi
             "La posizione" — è una svista del documento, e due h3 identici
             nella stessa sezione non si possono tenere. Questo blocco parla
             dello spazio geopolitico, non del luogo. */}
        <div class="campo campo--carta">
          <div class="blocco c1-5" data-reveal>
            <h3>Il corridoio</h3>
            <p>Ancona guarda il corridoio adriatico-ionico: due sponde, sette paesi, una strategia europea (EUSAIR) che qui trova uno dei suoi luoghi di lavoro. Il festival opera dentro questa geografia — con la Commissione Europea nelle Blue Economy Days, con i programmi Interreg Italia–Croazia, con gli atenei delle due coste. L'Adriatico non divide due sponde: le tiene insieme.</p>
          </div>

          {/* IL FRAMMENTO DI CARTA. Il profilo è ricalcato da coordinate
               reali: vedi la nota su CARTA nel frontmatter. Il disegno non
               porta informazione che non sia già scritta a fianco, quindi è
               aria-hidden e non chiede un'etichetta da leggere. */}
          <div class="c7-12 carta-campo" data-reveal>
            <svg class="carta" viewBox={CARTA.box} aria-hidden="true" focusable="false">
              <defs>
                <pattern id="tib-reticolo" width="32" height="32" patternUnits="userSpaceOnUse">
                  <path d="M32 0 L0 0 0 32" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.14" />
                </pattern>
              </defs>
              <rect width="420" height="240" fill="url(#tib-reticolo)" />
              <path class="k-costa" d={CARTA.ovest} />
              <path class="k-costa" d={CARTA.est} />
              {/* la rotta: Ancona verso la sponda opposta */}
              <path class="k-rotta" d={`M${CARTA.ancona[0]} ${CARTA.ancona[1]} L${CARTA.zara[0]} ${CARTA.zara[1]}`} />
              <g class="k-croce">
                <line x1={CARTA.ancona[0] - 9} y1={CARTA.ancona[1]} x2={CARTA.ancona[0] + 9} y2={CARTA.ancona[1]} />
                <line x1={CARTA.ancona[0]} y1={CARTA.ancona[1] - 9} x2={CARTA.ancona[0]} y2={CARTA.ancona[1] + 9} />
                <circle cx={CARTA.ancona[0]} cy={CARTA.ancona[1]} r="3.5" />
              </g>
              <text class="k-targa" x={CARTA.ancona[0] + 13} y={CARTA.ancona[1] - 7}>ANCONA</text>
              <text class="k-targa k-targa--fioca" x="300" y="78">SPONDA EST</text>
              <text class="k-targa k-targa--fioca" x="36" y="150">ADRIATICO</text>
            </svg>
            <p class="carta-did">Il medio Adriatico, profilo ricalcato da coordinate reali. Il gomito al centro è il Conero: venticinque chilometri di costa che si spingono dentro il mare.</p>
          </div>
        </div>

        <div class="campo">
          <div class="blocco c1-7" data-reveal>
            <h3>L'equipaggio</h3>
          {/* ⚠️ CORREZIONE FATTUALE (v3 §2.8). Fincantieri e MSC sono usciti:
              nel reportage non compaiono fra i partner, e un nome sbagliato
              nell'elenco dei partner è l'errore che un partner vero nota per
              primo. L'elenco è ora per gradi, come nei materiali di casa:
              i soggetti con un ruolo dichiarato prima, la rete convocata
              dopo. Marina Dorica resta, come partner tecnico. */}
            <p>Partner istituzionali: Comune di Ancona, Camera di Commercio delle Marche, Regione Marche. Partner scientifico: Università Politecnica delle Marche. Project partner: Banco Marchigiano. Partner tecnico: Marina Dorica.</p>
            <p>E intorno, la rete che il festival convoca ogni anno: atenei e centri di ricerca, poli tecnologici, aziende di servizi pubblici, associazioni di categoria e professionali, sodalizi culturali, imprese leader dei rispettivi comparti, grandi gruppi cooperativi.</p>
          </div>
        </div>

        {/* LA SQUADRA (v3 §2.9, blocco nuovo): chiude .Rotta. Dice l'ascolto
             come procedura, senza aureola — è la voce di casa già scritta.
             A lato l'unica lastra verticale della pagina: 3:4, che è il
             formato del ritratto di gruppo. */}
        <div class="campo campo--squadra">
          <div class="blocco c1-8" data-reveal>
            <h3>La squadra</h3>
            <p>Chi sta al tavolo, di solito, non sta allo stesso tavolo. Scienziati e docenti, ricercatori e specialisti, divulgatori e scrittori, chef affermati ed emergenti, pescatori e operatori portuali, viticoltori e ristoratori. Il metodo è dichiarato ed è bottom up: si raccolgono i bisogni delle diverse anime che cooperano, e si lavora perché il confronto non sia verticale. Le contaminazioni che ne escono non sono un effetto collaterale — sono il prodotto.</p>
          </div>
          <figure class="lastra lastra--alta c9-12" data-reveal>
            <div class="l-img">
              {lastraSquadra.src ? (
                <img src={lastraSquadra.src} alt="" width="900" height="1200" loading="lazy" decoding="async" />
              ) : (
                <em aria-hidden="true">in attesa</em>
              )}
            </div>
            <figcaption>
              <span class="d-idx">{lastraSquadra.idx}</span>
              <span class="d-voce">{lastraSquadra.did[0]}</span>
              <span class="d-luogo">{lastraSquadra.did[1]}</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ══ .CANTIERE — The Blue Way ══
         Regola di Paolo: la piattaforma PRIMA, gli esempi POI. Mai il contrario. -->
    <section class="matrice matrice--alt" id="cantiere" aria-labelledby="h-cantiere">
      <div class="wrap">
        <h2 id="h-cantiere" data-reveal>Cantiere</h2>

        {/* ⚠️ CORREZIONE FATTUALE (Paolo, 07/08/2026 — TESTI-TIB §2bis).
             La paternità di The Blue Way è di due soggetti soltanto:
             Tipicità in Blu e il Polo Tecnologico Alto Adriatico. iNEST
             non c'entra con la nascita — ha collaborato ad alcuni
             progetti sviluppati DENTRO The Blue Way, e il suo nome resta
             solo lì (la voce su Trieste, negli specchi del cantiere).
             NB: commento in stile JSX e non commento HTML, perché quelli
             finiscono nel sorgente pubblicato — e una nota editoriale su
             un errore di attribuzione non deve leggersi in pagina. */}
        <div class="campo">
          <div class="c1-7">
            <p class="apertura" data-reveal>The Blue Way nasce dalla collaborazione fra Tipicità in Blu e il Polo Tecnologico Alto Adriatico: un cantiere progettuale fondato su un principio semplice — condivisione. Buone prassi che circolano tra le due sponde dell'Adriatico, talenti che si formano lavorando su problemi veri, risultati di ricerca che non restano nei paper.</p>
          </div>
          <aside class="c9-12 scheda" data-reveal>
            <dl>
              {schedaCantiere.map(([voce, val]) => (
                <>
                  <dt>{voce}</dt>
                  <dd>{val}</dd>
                </>
              ))}
            </dl>
          </aside>
        </div>

        <div class="campo">
          <div class="blocco c1-7" data-reveal>
            <h3>Il cantiere aperto</h3>
          {/* La definizione ufficiale, quella usata a Ecomondo: è la più
               esatta e conviene tenerla testuale (TESTI-TIB §2ter). */}
          <p>La definizione ufficiale, quella usata a Ecomondo, è la più esatta e conviene tenerla: una <b>piattaforma di condivisione fisica e digitale per stimolare un'ampia alleanza di talenti, energie e competenze</b>, sull'area individuata come Polo del Mare Adriatico.</p>
          {/* v3 §3.2: il posizionamento, riga nuova dal reportage. Va subito
               dopo la definizione perché dice DOVE la piattaforma si colloca,
               che è la cosa che mancava. */}
          <p>È un percorso di sviluppo che tiene insieme divulgazione scientifica, creatività e visione territoriale, e che si proietta in contesti nuovi e internazionali. Colloca Tipicità in Blu al centro dello scacchiere adriatico-ionico come modello di cooperazione fra territori uniti dal mare e dalle sfide della transizione blu.</p>
          <p>The Blue Way non coincide con la manifestazione: lavora tutto l'anno, con ricadute sul territorio italiano e oltre. È una piattaforma permanente che collega gli atenei dell'arco adriatico — Politecnica delle Marche, Trieste, Udine, Bari, SISSA — le imprese che pongono le sfide e i giovani che le raccolgono. Il metodo è quello del cantiere: si progetta, si prototipa, si vara. E ogni varo apre il progetto successivo.</p>
          </div>
        </div>

        <div class="campo">
          <div class="c1-12" data-reveal>
          <h3>Gli specchi del cantiere</h3>
          {/* Cronologia e non schede pari: anno e città in monospazio come
               intestazione di ogni voce, che nel registro della plancia si
               legge come un giornale di bordo. */}
          <ol class="cronologia">
            {cronologia.map((v, i) => (
              <li>
                <span class="c-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div class="c-corpo">
                  <p class="c-testa">
                    <span class="c-quando">{v.testa}</span>
                    {v.sotto && <span class="c-sotto">{v.sotto}</span>}
                  </p>
                  {v.par.map((p) => <p class="c-par" set:html={p} />)}
                </div>
              </li>
            ))}
          </ol>
          </div>
        </div>

        <div class="campo">
          <div class="blocco c1-7" data-reveal>
            <h3>Chi trova cosa</h3>
            <ul class="trova">
              {trova.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ CHIUSURA — una riga, da plancia ══ -->
    <section class="chiusura" aria-label="Chiusura">
      <p class="fix fix--chiusura" data-reveal>
        Il laboratorio è aperto. 43°37′N 13°30′E —
        <a class="varco" href="https://theblueway.it" target="_blank" rel="noopener">theblueway.it</a>
      </p>
    </section>
  </main>
</BaseLayout>

<style is:global>
  /* selezione nei colori del marchio (dettaglio che si nota se manca) */
  ::selection { background: rgba(32, 159, 182, 0.32); color: #fff; }
</style>

<style>
  /* ── Token della pagina: una sola curva, durate corte. Stessa curva
       usata su Tipicità, così il sito ha un'unica mano. ── */
  .plancia, .barra, main { --ease: cubic-bezier(0.55, 0.05, 0.18, 1); }
  .mono, .fix, .quadro-label, .s-idx, .c-idx, .c-quando,
  .barra nav a, .matrici a {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  /* ══ LA PLANCIA ══ */
  .plancia {
    position: relative;
    min-height: 88svh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6rem 1.6rem 4rem;
    overflow: hidden;
    background:
      radial-gradient(ellipse 80% 60% at 50% 42%, rgba(32, 159, 182, 0.16), transparent 70%),
      var(--bg-void);
  }
  /* Il fondale. Il 30% è la soglia trovata a schermo: sopra, la riga di
     coordinate in ciano comincia a faticare; sotto, il mare non si vede
     più muovere. Se un domani il testo dovesse soffrire si scende di
     opacità, non si ingrandisce il testo. */
  .fondale {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.30;
    pointer-events: none;
  }

  /* Reduced motion: resta la posa, ferma. Il video non parte nemmeno,
     perché senza autoplay il browser non lo scarica. */
  @media (prefers-reduced-motion: reduce) {
    .fondale { display: none; }
    .plancia {
      background-image:
        radial-gradient(ellipse 80% 60% at 50% 42%, rgba(32, 159, 182, 0.16), transparent 70%),
        linear-gradient(rgba(10, 26, 43, 0.70), rgba(10, 26, 43, 0.70)),
        url('/tib/fondo-poster.jpg');
      background-size: auto, auto, cover;
      background-position: center;
    }
  }

  /* carta nautica appena percettibile: reticolo di strumento, zero asset */
  .grigliato {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(90deg, rgba(233, 238, 242, 0.055) 0 1px, transparent 1px 64px),
      repeating-linear-gradient(0deg, rgba(233, 238, 242, 0.055) 0 1px, transparent 1px 64px);
    mask-image: radial-gradient(ellipse 75% 65% at 50% 45%, #000 20%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 45%, #000 20%, transparent 78%);
    pointer-events: none;
  }
  .plancia-in { position: relative; max-width: 60rem; }
  .marchio { width: min(64vw, 320px); height: auto; display: block; margin: 0 auto; }
  .payoff {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.4rem, 3.6vw, 2.1rem);
    color: var(--text-soft);
    margin: 1.6rem 0 1.8rem;
    line-height: 1.25;
  }
  .fix {
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--brand-accent);
    margin: 0;
  }
  /* i segmenti stanno in riga, separati dal punto medio; il separatore è
     generato, così sparisce da solo quando i segmenti si impilano */
  .fix--apertura {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0 0.6rem;
    line-height: 1.9;
  }
  .fix--apertura span + span::before {
    content: '·';
    margin-right: 0.6rem;
    color: var(--text-faint);
  }
  .matrici {
    display: flex;
    justify-content: center;
    gap: 2.2rem;
    margin-top: 2.6rem;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }
  .matrici a {
    color: var(--text-soft);
    text-decoration: none;
    padding: 0.4rem 0.2rem;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease);
  }
  .matrici a:hover { border-color: var(--brand-accent); }
  .matrici a:active { color: var(--brand-accent); }

  /* ══ BARRA DI STRUMENTO ══ */
  .barra {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--bg-void) 86%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .barra-in {
    max-width: 68rem;
    margin: 0 auto;
    padding: 0.7rem 1.6rem;
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }
  /* spazio per la capsula fissa in alto a destra (BRIEF-MENU §6) */
  @media (min-width: 760px) {
    .barra-in { padding-right: 265px; }
  }
  .barra-marchio { height: 26px; width: auto; flex: none; opacity: 0.9; }
  .barra nav { display: flex; gap: 1.4rem; }
  .barra nav a {
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    color: var(--text-faint);
    text-decoration: none;
    padding: 0.3rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .barra nav a:hover { color: var(--text-soft); }
  .barra nav a:active { color: var(--brand-accent); }
  .barra nav a[aria-current='true'] { color: var(--brand-accent); border-color: var(--brand-accent); }
  .barra-fix { margin-left: auto; color: var(--text-faint); font-size: 0.7rem; }
  @media (max-width: 560px) { .barra-fix { display: none; } }

  /* ══ MATRICI ══ */
  .matrice { padding: clamp(3.4rem, 9vh, 6rem) 0; }
  .matrice--alt { background: var(--bg-deep); }
  .wrap { max-width: 68rem; margin: 0 auto; padding: 0 var(--gut); }

  /* ══ LA GRIGLIA: DODICI CAMPI ══
     Dodici colonne dentro 68rem, gronda 1.6rem, modulo verticale di 64px —
     che non è un numero scelto a caso: è il passo del reticolo di carta
     nautica già disegnato in .grigliato. La pagina aveva già la sua griglia
     addosso, e finora nessun contenuto la usava.

     Regola unica: LA PLANCIA È L'UNICO BLOCCO CENTRATO DELLA PAGINA. Tutto
     il resto dichiara il campo che occupa. Una plancia non è una colonna: è
     un pannello con campi di dimensioni diverse, e finché ogni blocco è largo
     uguale e centrato uguale nessuna gerarchia è possibile. */
  main { --gut: 1.6rem; --mod: 64px; }
  .campo {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--gut);
  }
  .campo + .campo { margin-top: var(--mod); }
  /* i campi che portano una grafica respirano di un modulo in più: la ruota e
     la carta hanno bisogno di stare sole per leggersi */
  .campo--ruota, .campo--carta, .campo--squadra { margin-top: calc(var(--mod) * 1.5); }

  .c1-5 { grid-column: 1 / 6; }
  .c1-7 { grid-column: 1 / 8; }
  .c1-8 { grid-column: 1 / 9; }
  .c1-12 { grid-column: 1 / 13; }
  .c7-12 { grid-column: 7 / 13; }
  .c9-12 { grid-column: 9 / 13; }

  /* Un solo punto di rottura, e sotto si collassa tutto a colonna singola.
     Due punti di rottura si tengono in ordine; quattro no. */
  @media (max-width: 820px) {
    .c1-5, .c1-7, .c1-8, .c1-12, .c7-12, .c9-12 { grid-column: 1 / 13; }
    .campo { row-gap: 2rem; }
    .campo + .campo,
    .campo--ruota, .campo--carta, .campo--squadra { margin-top: 2.8rem; }
  }

  /* ── la scheda tecnica a lato: colonna di fatti, non paragrafo ── */
  .scheda dl { margin: 0; }
  .scheda dt {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .scheda dd {
    margin: 0.3rem 0 0;
    padding-bottom: 0.9rem;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-dim);
    border-bottom: 1px solid var(--hairline);
  }
  .scheda dd + dt { margin-top: 0.9rem; }
  .scheda dd:last-of-type { border-bottom: 0; padding-bottom: 0; }
  /* su schermo stretto la scheda sta sotto l'apertura: le serve un filo in
     testa, o galleggia */
  @media (max-width: 820px) {
    .scheda { border-top: 1px solid var(--brand-accent); padding-top: 1rem; }
  }

  h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    color: var(--brand-accent);
    margin: 0 0 1.4rem;
  }
  h2::before { content: '.'; color: var(--text-faint); }

  h3 {
    font-size: 1.15rem;
    color: var(--text-soft);
    margin: 0 0 0.6rem;
  }

  /* text-wrap: pretty → il browser evita le ultime righe con una parola sola
     (righe orfane trovate in audit a 390 e 1440). Dove non è supportato,
     degrada al ritorno a capo normale. */
  .apertura, .blocco p, .q-nota, .l-desc, .trova li,
  .tempi dd, .f-testo, .c-par, .estensione { text-wrap: pretty; }

  .apertura {
    font-size: clamp(1.02rem, 1.5vw, 1.16rem);
    line-height: 1.75;
    color: var(--text-soft);
    max-width: 60ch;
    margin: 0 0 2.6rem;
  }
  .blocco { margin: 0 0 2.4rem; max-width: 62ch; }
  /* la misura di lettura è un massimo, non una larghezza: dove il campo è
     più stretto di 62ch comanda il campo */
  .blocco p { color: var(--text-dim); line-height: 1.75; margin: 0; }
  /* i blocchi con due paragrafi (La visione, Il cantiere aperto) hanno
     bisogno di respiro: senza, le due righe si toccano e sembrano uno */
  .blocco p + p { margin-top: 1.1em; }

  /* ── L'architettura: tre voci con il nome in evidenza e la descrizione
       di seguito. dl e non ul perché sono definizioni: nome e contenuto. ── */
  .tempi { margin: 1.2rem 0 0; }
  .tempi dt {
    color: var(--text-soft);
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .tempi dd {
    margin: 0.2rem 0 0;
    padding: 0 0 0.9rem 0;
    color: var(--text-dim);
    line-height: 1.75;
    border-bottom: 1px solid rgba(233, 238, 242, 0.07);
  }
  .tempi dd:last-of-type { border-bottom: 0; padding-bottom: 0; }
  .tempi dt + dd { margin-top: 0.2rem; }
  .tempi dd + dt { margin-top: 0.9rem; }

  /* ── I formati: quattro schede, ciascuna con la sua lastra. ──
     Due colonne e non auto-fit: i formati sono quattro, e con auto-fit a
     1440 entrano in tre — il quarto resta orfano su una riga sua. 2×2 non
     lascia orfani a nessuna larghezza. */
  .formati {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.6rem var(--gut);
    margin-top: 1.4rem;
  }
  .formato h4 {
    margin: 0 0 0.25rem;
    font-size: 1.02rem;
    color: var(--text-soft);
  }
  .f-dove {
    margin: 0 0 0.6rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-faint);
  }
  .f-testo {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--text-dim);
  }

  /* ══ LE IMMAGINI: DUE FAMIGLIE, E SOLO DUE ══ */

  /* ── 1. LA LASTRA ──
     Inserto in cornice a filo, virato nella cromia della pagina.
     NIENTE raggio d'angolo e NIENTE ombra: sarebbero il depliant.
     Formato 3:2 — non 16:9. Il 16:9 è il formato dei monitor della moviola
     di Tipicità: usarlo qui sarebbe un prestito da un'altra fabula. Il 3:2 è
     il formato della fotografia documentaria, ed è quello giusto per una
     scheda tecnica. L'unica eccezione è la lastra verticale della squadra.
     aspect-ratio sul contenitore e width/height sull'immagine: al
     caricamento non si muove un pixel. */
  .lastra { margin: 0 0 0.9rem; }
  .l-img {
    position: relative;
    aspect-ratio: 3 / 2;
    border: 1px solid var(--hairline);
    overflow: hidden;
    background: linear-gradient(140deg, #14384a, #1d5468 45%, #2a7f95 70%, #3f6b78);
    /* la viratura: la fotografia resta perfettamente leggibile, ma
       APPARTIENE alla pagina invece di sedercisi sopra. È il modo per usare
       materiale d'archivio molto vario — luci diverse, anni diversi,
       fotografi diversi — senza che la pagina diventi un collage. */
    filter: saturate(0.55) contrast(1.05);
  }
  .lastra--alta .l-img { aspect-ratio: 3 / 4; }
  .l-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .l-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(32, 159, 182, 0.18), rgba(10, 26, 43, 0.30));
    mix-blend-mode: color;
    pointer-events: none;
  }
  /* lo stato di riserva: il campo virato con la sua etichetta. Dignitoso, e
     non sembra un errore — che è meglio di una fotografia sbagliata. */
  /* la velatura non è un vezzo: sul punto chiaro del gradiente l'etichetta
     scendeva a 3,35:1, sotto il 4,5:1 richiesto per il testo piccolo. Così
     sta a 6,8:1 — e per di più il campo in riserva si distingue a colpo
     d'occhio da una fotografia vera, che è esattamente quello che deve fare.
     Quando la fotografia arriva, l'etichetta non viene resa e la velatura
     sparisce con lei. */
  .l-img em {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(10, 26, 43, 0.42);
    font-style: normal;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(233, 238, 242, 0.78);
    z-index: 2;
  }

  /* la didascalia: SEMPRE presente, mai sovrimpressa, mai decorativa.
     Se una didascalia non aggiunge un fatto, la lastra non serve. */
  .lastra figcaption, .banda figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.7rem;
    align-items: baseline;
    margin-top: 0.7rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .d-idx { color: var(--brand-accent); }
  .d-voce { color: var(--text-dim); }
  .d-luogo { color: var(--text-faint); }
  /* il separatore è generato, così sparisce da solo quando la didascalia va
     a capo su schermo stretto */
  .lastra figcaption span + span::before,
  .banda figcaption span + span::before {
    content: '·';
    margin-right: 0.7rem;
    color: var(--text-faint);
  }

  /* ── 2. LA BANDA ──
     L'unica fotografia a colori pieni di tutta la pagina, e l'unica cosa che
     esce dalla gabbia. È la cerniera fra .Rotta e l'architettura: il punto in
     cui il lettore ha capito CHE COSA è e sta per scoprire COM'È FATTO.
     Una banda funziona perché è una: due sono un carosello lento. */
  .banda {
    position: relative;
    margin: clamp(3rem, 7vh, 5rem) 0;
    padding: 0;
  }
  .banda > img, .banda-riserva {
    display: block;
    width: 100%;
    height: 56svh;
    min-height: 340px;
    object-fit: cover;
  }
  .banda-riserva {
    position: relative;
    background:
      linear-gradient(180deg, rgba(10, 26, 43, 0.15), rgba(10, 26, 43, 0.75)),
      linear-gradient(115deg, #1b5f74, #2b8ea6 38%, #7fb3c4 55%, #c8b89a 72%, #8a7f6b);
  }
  /* stessa ragione della lastra: al centro della banda il gradiente è
     chiaro e l'etichetta scendeva a 2,84:1 */
  .banda-riserva em {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(10, 26, 43, 0.42);
    font-style: normal;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(233, 238, 242, 0.8);
  }
  /* la didascalia della banda torna dentro la gabbia: è l'unica parte della
     banda che obbedisce alla griglia */
  .banda figcaption { margin-top: 0.8rem; }
  /* a 390 la banda non deve mangiare mezzo schermo */
  @media (max-width: 700px) {
    .banda > img, .banda-riserva { height: 42svh; min-height: 230px; }
  }

  /* ── il quadro strumenti: readout, due colonne di sigle ── */
  /* il ritmo verticale lo detta la griglia (.campo + .campo), non i margini
     dei pannelli: se ce l'hanno anche loro, i due si sommano e il modulo da
     64px salta */
  .quadro, .metriche {
    border: 1px solid var(--hairline);
    border-left: 2px solid var(--brand-accent);
    background: rgba(233, 238, 242, 0.028);
    padding: 1.5rem 1.6rem 1.4rem;
    margin: 0;
  }
  .quadro-label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 1.1rem;
  }
  /* una colonna sola: l'elenco è la lettura della ruota, e sette voci
     numerate 01–07 in colonna si contano a colpo d'occhio contro i sette
     settori. Su due colonne il conto si perde. */
  .strumenti {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
  }
  .strumenti li {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.42rem 0;
    border-bottom: 1px solid rgba(233, 238, 242, 0.07);
  }
  .s-idx { font-size: 0.66rem; color: var(--brand-accent); flex: none; }
  .s-voce {
    font-size: 0.82rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-dim);
    line-height: 1.4;
  }

  /* ── il pannello delle letture ──
     Tre colonne per lettura su dodici. Lo zero ne occupa sei: non entra
     nella riga delle altre e scende da solo, che è esattamente quello che
     deve fare. */
  .letture {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.8rem var(--gut);
  }
  .lettura { margin: 0; grid-column: span 3; }
  /* LA ROTTURA DELLA REGOLARITÀ è il modo di dare peso a un dato senza
     scrivere che è importante. Una sola per pagina: con due, nessuna delle
     due pesa più. */
  .lettura--grande {
    grid-column: span 6;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0 1.4rem;
    padding-left: 1.4rem;
    border-left: 1px solid var(--brand-accent);
  }
  .lettura--grande .l-num {
    font-size: clamp(4rem, 11vw, 7rem);
    margin: 0;
    line-height: 0.9;
  }
  .lettura--grande .l-desc { max-width: 20ch; }
  .l-num {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.05;
    color: var(--brand-accent);
    font-variant-numeric: tabular-nums;
    margin: 0 0 0.35rem;
  }
  .l-desc {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--text-dim);
    max-width: 26ch;
  }
  /* l'estensione tematica: corpo minore sotto la ruota, non in maiuscoletto
     — è un paragrafo da leggere, non un'etichetta. */
  .estensione {
    margin: 1.6rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--text-dim);
  }

  /* ── LA RUOTA DEGLI AMBITI ──
     Sette settori su un anello con il quadrante vuoto al centro: legge come
     un quadrante di strumento, non come un grafico a torta. Passando su un
     settore si accende la voce corrispondente nell'elenco a fianco, e
     viceversa: una sola intenzione, 250ms, la curva della pagina. */
  .ruota-campo { display: grid; align-content: center; }
  .ruota { display: block; width: 100%; max-width: 21rem; height: auto; }
  /* a colonna singola la ruota non ha più un vicino a cui allinearsi: cresce
     e si centra, o resta un disco piccolo in un campo vuoto */
  @media (max-width: 820px) {
    .ruota { max-width: 26rem; margin-inline: auto; }
  }
  .ruota path {
    opacity: 0.85;
    transition: opacity 0.25s var(--ease);
  }
  /* l'accensione vive solo mentre si punta qualcosa: la classe sta sul
     contenitore, così gli altri settori si abbassano INSIEME invece che uno
     alla volta */
  .ruota--acceso path { opacity: 0.22; }
  .ruota--acceso path.on { opacity: 1; }
  .strumenti li { transition: border-color 0.25s var(--ease); }
  .strumenti li.on { border-bottom-color: var(--brand-accent); }
  .strumenti li.on .s-voce { color: var(--text-soft); }

  /* ── LA STRISCIA DELLE TRE MATRICI ──
     Otto colonne: il nome a sinistra e sette giorni sull'asse. È una tabella
     di marcia, che è esattamente il registro della plancia. */
  .assi {
    display: grid;
    grid-template-columns: 12rem repeat(7, 1fr);
    gap: 0.75rem 0.35rem;
    align-items: center;
    margin-top: 0.3rem;
  }
  /* la scala ricalca le tracce del genitore: stesse 7 colonne, stessa gronda,
     quindi i numeri cadono esattamente sopra i giorni */
  .a-scala {
    grid-column: 2 / -1;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.35rem;
  }
  .a-scala i {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-style: normal;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    text-align: center;
  }
  .a-nome { grid-column: 1; display: block; padding-right: 0.8rem; }
  .a-nome b {
    display: block;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    line-height: 1.3;
  }
  .a-nome i {
    display: block;
    margin-top: 0.15rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-style: normal;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .a-barra {
    height: 12px;
    border: 1px solid var(--brand-accent);
    background: color-mix(in srgb, var(--brand-accent) 62%, transparent);
  }
  /* il circuito è diffuso in città, non concentrato in una sede: a tratteggio */
  .a-barra--rada {
    background: repeating-linear-gradient(
      90deg,
      color-mix(in srgb, var(--brand-accent) 45%, transparent) 0 4px,
      transparent 4px 9px
    );
  }
  .a-nota {
    margin: 1.2rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
    font-size: 0.8rem;
    line-height: 1.65;
    color: var(--text-faint);
    text-wrap: pretty;
  }
  /* Sotto i 560 la colonna dei nomi costerebbe metà della striscia e i giorni
     si ridurrebbero a 24px l'uno. Il nome sale allora sopra la sua barra, a
     tutta larghezza: la prima colonna si azzera, così le barre continuano a
     cadere sui giorni giusti senza che gli indici cambino di uno. */
  @media (max-width: 560px) {
    .assi { grid-template-columns: 0 repeat(7, 1fr); gap: 0.4rem 0.2rem; }
    .a-scala { gap: 0.2rem; }
    .a-nome {
      grid-column: 1 / -1;
      padding-right: 0;
      margin-top: 0.7rem;
    }
    .a-nome b { font-size: 0.78rem; }
    .a-nome i { font-size: 0.6rem; }
  }

  /* ── IL FRAMMENTO DI CARTA ──
     Due coste a filo, il reticolo, Ancona con il crocino e la rotta
     tratteggiata verso la sponda opposta. Il profilo è ricalcato da
     coordinate reali: vedi la nota nel frontmatter. */
  .carta-campo { display: grid; align-content: center; }
  .carta {
    display: block;
    width: 100%;
    height: auto;
    color: var(--text-soft);
    border: 1px solid var(--hairline);
    background: rgba(10, 26, 43, 0.4);
  }
  .k-costa {
    fill: none;
    stroke: var(--brand-accent);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .k-rotta {
    fill: none;
    stroke: var(--text-soft);
    stroke-width: 1;
    stroke-dasharray: 5 4;
    opacity: 0.55;
  }
  .k-croce line, .k-croce circle { stroke: var(--text-soft); stroke-width: 1; fill: none; }
  .k-targa {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 9px;
    letter-spacing: 0.18em;
    fill: var(--text-soft);
  }
  .k-targa--fioca { fill: var(--text-faint); }
  .carta-did {
    margin: 0.8rem 0 0;
    font-size: 0.76rem;
    line-height: 1.6;
    color: var(--text-faint);
    text-wrap: pretty;
  }
  .q-nota {
    margin: 1rem 0 0;
    font-size: 0.94rem;
    line-height: 1.7;
    color: var(--text-dim);
    max-width: 62ch;
  }

  /* ── la cronologia: giornale di bordo. L'indice e la data in monospazio
       fanno da intestazione, il corpo rientra sotto. ── */
  .cronologia { list-style: none; margin: 1.2rem 0 0; padding: 0; }
  .cronologia li {
    display: flex;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--hairline);
  }
  .cronologia li:first-child { padding-top: 0.2rem; }
  .cronologia li:last-child { border-bottom: 0; padding-bottom: 0; }
  .c-idx {
    font-size: 0.68rem;
    color: var(--brand-accent);
    flex: none;
    padding-top: 0.3rem;
  }
  .c-corpo { max-width: 66ch; }
  .c-testa {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.7rem;
    margin: 0 0 0.5rem;
  }
  .c-quando {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-soft);
  }
  .c-sotto {
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  /* il separatore è generato: sparisce da solo quando le due parti si
     impilano su schermo stretto */
  .c-sotto::before { content: '— '; }
  .c-par {
    margin: 0;
    color: var(--text-dim);
    line-height: 1.75;
    font-size: 0.96rem;
  }
  .c-par + .c-par { margin-top: 0.9em; }
  .c-par :global(b) { color: var(--text-soft); font-weight: 600; }

  .trova { list-style: none; margin: 0; padding: 0; }
  .trova li {
    padding: 0.7rem 0 0.7rem 1.4rem;
    position: relative;
    color: var(--text-dim);
    line-height: 1.7;
  }
  .trova li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.35rem;
    width: 6px;
    height: 1px;
    background: var(--brand-accent);
  }

  /* ══ CHIUSURA ══ */
  .chiusura {
    border-top: 1px solid var(--hairline);
    padding: 2.6rem 1.6rem 3rem;
    text-align: center;
  }
  .fix--chiusura { font-size: 0.8rem; line-height: 2; }
  .varco {
    display: inline-block;
    color: var(--brand-accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(32, 159, 182, 0.45);
    /* area toccabile ≥24px (WCAG 2.5.8) senza ingrandire il segno */
    padding: 4px 2px 3px;
    transition: border-color 0.25s var(--ease);
  }
  .varco:hover { border-color: var(--brand-accent); }
  .varco:active { color: var(--text-soft); }

  /* ══ FUOCO DISEGNATO — non l'anello di sistema ══ */
  .matrici a:focus-visible,
  .barra nav a:focus-visible,
  .varco:focus-visible {
    outline: none;
    color: var(--brand-accent);
    border-color: var(--brand-accent);
    box-shadow: 0 2px 0 0 var(--brand-accent), 0 0 0 4px rgba(32, 159, 182, 0.18);
    border-radius: 1px;
  }

  /* ══ RESPONSIVE: la plancia resta plancia ══
     Sotto 820px la griglia è già collassata a colonna singola (vedi su).
     Qui restano gli aggiustamenti di corpo e di spaziatura della plancia e
     dei pannelli, che non sono questioni di griglia. */
  @media (max-width: 820px) {
    /* le letture tornano in coppia e lo zero si prende tutta la riga: la
       rottura si legge anche quando le colonne sono due */
    .lettura { grid-column: span 6; }
    .lettura--grande { grid-column: span 12; }
    .formati { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .plancia { min-height: 78svh; padding: 5rem 1.2rem 3rem; }
    .wrap { padding: 0 1.2rem; }
    /* schermo stretto: i segmenti scendono uno per riga, allineati e interi.
       Niente a-capo casuale a metà di una coordinata. */
    .fix--apertura {
      flex-direction: column;
      gap: 0.45rem;
      font-size: 0.72rem;
      line-height: 1.5;
    }
    .fix--apertura span + span::before { content: none; margin: 0; }
    .s-voce { font-size: 0.78rem; }
    .formati { grid-template-columns: 1fr; gap: 2rem; }
    .estensione { font-size: 0.78rem; }
    .cronologia li { gap: 0.8rem; }
    .c-par { font-size: 0.9rem; }
    .letture { gap: 1.4rem 1.2rem; }
    .l-desc { font-size: 0.78rem; }
    .quadro, .metriche { padding: 1.2rem 1.1rem 1.1rem; }
    .matrici { gap: 1.6rem; }
  }
  @media (max-width: 420px) {
    /* a questa larghezza due letture per riga spezzano «oltre 30» a metà */
    .lettura { grid-column: span 12; }
  }

  /* ══ MOTO: solo dissolvenza; sotto reduced-motion sparisce del tutto ══ */
  @media (prefers-reduced-motion: reduce) {
    /* la ruota perde la transizione, non l'accensione: dà fastidio il moto,
       non il contrasto (GRIGLIA-TIB §7) */
    .matrici a, .barra nav a, .varco, .ruota path, .strumenti li { transition: none; }
  }
</style>

<script>
  // Il conteggio da zero delle metriche è stato rimosso con i numeri che lo
  // giustificavano: sui dati nuovi — «2014», «0» — un contatore che sale è un
  // effetto su cifre che non lo meritano (GRIGLIA-TIB §5), e su uno zero è
  // semplicemente un'animazione che non si vede.

  // ── LA RUOTA E IL SUO ELENCO SI ACCENDONO A VICENDA ──
  // Un di più, non un veicolo: l'informazione sta tutta nell'elenco, che è la
  // versione accessibile del disegno. Per questo nessun elemento diventa
  // focalizzabile — sarebbero sette fermate di tabulazione che non portano da
  // nessuna parte (WCAG 2.4.3) — e se questo blocco non gira la pagina dice
  // ancora tutto quello che deve dire.
  // Sotto prefers-reduced-motion sparisce la transizione, non l'accensione:
  // è il moto a dare fastidio, non il contrasto.
  const ruota = document.getElementById('ruota');
  const ambiti = document.getElementById('ambiti');
  if (ruota && ambiti) {
    const settori = Array.from(ruota.querySelectorAll('path'));
    const voci = Array.from(ambiti.querySelectorAll('li'));

    const accendi = (i) => {
      ruota.classList.toggle('ruota--acceso', i !== null);
      settori.forEach((p, k) => p.classList.toggle('on', k === i));
      voci.forEach((l, k) => l.classList.toggle('on', k === i));
    };

    // la coppia settore/voce condivide l'indice: una sola fonte, nessun
    // disallineamento possibile se un domani gli ambiti cambiano numero
    [...settori, ...voci].forEach((el) => {
      const i = Number(el.dataset.i);
      el.addEventListener('mouseenter', () => accendi(i));
      el.addEventListener('mouseleave', () => accendi(null));
    });
  }

  // ── la barra segna la matrice in cui ci si trova ──
  const voci = Array.from(document.querySelectorAll('.barra nav a'));
  const sezioni = voci.map((a) => document.getElementById(a.dataset.nav)).filter(Boolean);
  if (sezioni.length && 'IntersectionObserver' in window) {
    const spia = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        voci.forEach((a) => a.setAttribute('aria-current', a.dataset.nav === e.target.id ? 'true' : 'false'));
      });
    }, { rootMargin: '-45% 0px -50% 0px' });
    sezioni.forEach((s) => spia.observe(s));
  }
</script>
