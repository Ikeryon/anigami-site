  /* ══ CHIUSURA ══ */
  .chiusura {
    border-top: 1px solid var(--hairline);
    padding: 2.6rem 1.6rem 3rem;
    text-align: center;
  }
  .fix--chiusura { font-size: 0.8rem; line-height: 2; }
  .varco {
    display: inline-block;
    color: var(--brand-accent);
    text-decoration: none;
