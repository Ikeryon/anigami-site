---
import BaseLayout from '../layouts/BaseLayout.astro';
import { content } from '../i18n/404.js';
import { content as home } from '../i18n/home.js';

// ══════════════════════════════════════════════════════════════════════
// LA PAGINA CHE NON C'È
//
// Senza di lei chiunque sbagli un indirizzo — o segua un vecchio link del
// sito piatto — finisce sulla pagina bianca di Vercel, che su un sito
// costruito così si vede in un secondo.
//
// Cromia e tipografia della casa, non un avviso di sistema: campo scuro,
// il monogramma, una riga in Cormorant, e due vie d'uscita. Niente
// illustrazione buffa, niente «ops».
//
// I quattro segni arrivano da src/i18n/home.js e non sono ricopiati qui:
// sono gli stessi marchi con gli stessi indirizzi, e se un giorno uno
// cambia deve cambiare in un posto solo.
// ══════════════════════════════════════════════════════════════════════

const c = content.it;
const en = content.en;
const segni = home.it.segni.voci;

// Lo stesso campo scuro della home: chi ci finisce deve capire subito di
// essere ancora dentro lo stesso sito, non su una pagina di servizio.
const theme = {
  '--bg-void': '#08090b',
  '--bg-deep': '#101216',
  '--bg-mid': '#191c21',
  '--text-soft': '#f2efe9',
  '--text-dim': 'rgba(242, 239, 233, 0.72)',
  '--text-faint': 'rgba(242, 239, 233, 0.55)',
  '--hairline': 'rgba(242, 239, 233, 0.22)',
};
---

<BaseLayout title={c.meta.title} description={c.meta.description} lang="it" theme={theme}>
  <main class="vuoto">
    <svg class="mono" viewBox="0 0 78.96 78.96" aria-hidden="true"><use href="#mk-imagina-mono" /></svg>

    <p class="codice" aria-hidden="true">{c.codice}</p>

    <h1 class="riga">{c.riga}</h1>
    <p class="riga riga--en" lang="en">{en.riga}</p>

    <nav class="uscite" aria-label="Vie d'uscita">
      <a class="casa" href="/">{c.casa}</a>
      <a class="casa casa--en" href="/en/" lang="en">{en.casa}</a>
    </nav>

    <nav class="segni" aria-label="I progetti">
      <span class="segni-eti" aria-hidden="true">{c.progetti} · <span lang="en">{en.progetti}</span></span>
      <ul>
        {segni.map((s) => (
          <li>
            <a class="segno" href={s.href} style={`--acceso: ${s.acceso}`}>
              <svg viewBox="0 0 78.96 78.96" aria-hidden="true"><use href={`#${s.simbolo}`} /></svg>
              <span class="sr-only">{s.nome}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </main>
</BaseLayout>

<style>
  .vuoto {
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    padding: 4rem 1.6rem;
    gap: 0;
  }

  .mono {
    width: 46px;
    height: 46px;
    fill: var(--text-soft);
    opacity: 0.6;
    margin-bottom: 2.2rem;
  }

  /* il numero è un dato, non un titolo: monospazio, piccolo, attenuato.
     Chi arriva qui lo riconosce; chi non lo riconosce non ne ha bisogno. */
  .codice {
    margin: 0 0 1.6rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.3em;
    color: var(--text-faint);
  }

  .riga {
    margin: 0;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: clamp(1.6rem, 4.2vw, 2.6rem);
    line-height: 1.25;
    color: var(--text-soft);
    text-wrap: balance;
  }
  /* l'inglese sta sotto, un gradino più indietro: è la stessa frase, non
     una seconda informazione */
  .riga--en {
    margin-top: 0.5rem;
    font-size: clamp(1.2rem, 3vw, 1.7rem);
    color: var(--text-faint);
  }

  .uscite {
    margin-top: 2.8rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.6rem 1.4rem;
  }
  .casa {
    font-family: 'Manrope', sans-serif;
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-soft);
    text-decoration: none;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--hairline);
    transition: border-color 0.3s ease;
  }
  .casa:hover { border-bottom-color: var(--text-soft); }
  .casa:focus-visible { outline: 2px solid var(--text-soft); outline-offset: 4px; }
  .casa--en { color: var(--text-faint); }

  /* ── i quattro segni, come in home ── */
  .segni { margin-top: 3.4rem; }
  .segni-eti {
    display: block;
    margin-bottom: 0.9rem;
    font-family: 'Manrope', sans-serif;
    font-size: 0.64rem;
    letter-spacing: 0.2em;
    text-transform: lowercase;
    color: var(--text-faint);
  }
  .segni ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    gap: 1.6rem;
  }
  .segno { display: block; padding: 0.3rem; }
  .segno svg {
    width: 26px;
    height: 26px;
    fill: var(--text-faint);
    transition: fill 0.3s ease;
  }
  .segno:hover svg { fill: var(--acceso); }
  .segno:focus-visible { outline: 2px solid var(--text-soft); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .casa, .segno svg { transition: none; }
  }
</style>
